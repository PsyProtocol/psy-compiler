use super::primitive::*;

pub fn get_user_id() -> Felt {
    __ctx_get_user_id()
}

pub fn get_contract_id() -> Felt {
    __ctx_get_contract_id()
}

pub fn get_contract_deployer(contract_id: Felt) -> Hash {
    __ctx_get_contract_deployer(contract_id)
}

pub fn get_caller_contract_id() -> Felt {
    __ctx_get_caller_contract_id()
}

pub fn get_checkpoint_id() -> Felt {
    __ctx_get_checkpoint_id()
}

pub fn get_register_users_root(checkpoint_id: Felt) -> Hash {
    __ctx_get_register_users_root(checkpoint_id)
}

pub fn get_gutas_root(checkpoint_id: Felt) -> Hash {
    __ctx_get_gutas_root(checkpoint_id)
}

pub fn get_deploy_contracts_root(checkpoint_id: Felt) -> Hash {
    __ctx_get_deploy_contracts_root(checkpoint_id)
}

pub fn get_fees_collected(checkpoint_id: Felt) -> Felt {
    __ctx_get_fees_collected(checkpoint_id)
}

pub fn get_user_ops_processed(checkpoint_id: Felt) -> Felt {
    __ctx_get_user_ops_processed(checkpoint_id)
}

pub fn get_total_transactions(checkpoint_id: Felt) -> Felt {
    __ctx_get_total_transactions(checkpoint_id)
}

pub fn get_slots_modified(checkpoint_id: Felt) -> Felt {
    __ctx_get_slots_modified(checkpoint_id)
}

pub fn get_deploy_contracts_completed(checkpoint_id: Felt) -> Felt {
    __ctx_get_deploy_contracts_completed(checkpoint_id)
}

pub fn get_register_users_completed(checkpoint_id: Felt) -> Felt {
    __ctx_get_register_users_completed(checkpoint_id)
}

pub fn get_gutas_completed(checkpoint_id: Felt) -> Felt {
    __ctx_get_gutas_completed(checkpoint_id)
}

pub fn get_last_nonce() -> Felt {
    __ctx_get_last_nonce()
}

pub fn get_user_public_key_hash() -> Hash {
    __ctx_get_user_public_key_hash()
}

pub fn get_state_hash_at(slot_index: Felt) -> Hash {
    __ctx_get_state_hash_at(slot_index)
}

pub fn get_other_contract_state_hash_at(contract_state_tree_height: Felt, contract_id: Felt, slot_index: Felt) -> Hash {
    __ctx_get_other_contract_state_hash_at(contract_state_tree_height, contract_id, slot_index)
}

pub fn get_other_user_contract_state_hash_at(contract_state_tree_height: Felt, user_id: Felt, contract_id: Felt, slot_index: Felt) -> Hash {
    __ctx_get_other_user_contract_state_hash_at(contract_state_tree_height, user_id, contract_id, slot_index)
}

pub fn cset_state_hash_at(slot_index: Felt, new_value: Hash) -> Hash {
    __ctx_set_state_hash_at(slot_index, new_value)
}

pub fn invoke_sync<T, U>(contract_id: Felt, method_id: Felt, inputs: U) -> T {
    __invoke_sync#<T>(contract_id, method_id, inputs)
}

pub fn invoke_deferred<T, U>(contract_id: Felt, method_id: Felt, inputs: U) {
    __invoke_deferred(contract_id, method_id, inputs);
}

pub fn clear_entire_tree() {
    __ctx_clear_entire_tree();
}
