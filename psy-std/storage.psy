impl<N: Felt> Eq<[u64; N]> for [u64; N] {
    pub fn eq(self: Self, rhs: [u64; N]) -> bool {
        let mut same = true;
        for i in 0..N {
            if self[i] != rhs[i] {
                same = false;
            }
        }
        same
    }
}


impl<N: Felt> EqAssign<[u64; N]> for [StorageRef<u64>; N] {
    pub fn eq_assign(self: Self, rhs: [u64; N]) {
        for i in 0..N {
            self[i].set(rhs[i]);
        }
    }
}

impl<N: Felt> EqAssign<[u64; N]> for ArrayRef<u64, N> {
    pub fn eq_assign(self: Self, rhs: [u64; N]) {
        self.set(rhs);
    }
}

impl<N: Felt> Eq<[u64; N]> for ArrayRef<u64, N> {
    pub fn eq(self: Self, rhs: [u64; N]) -> bool {
        let mut same = true;
        for i in 0..N {
            if self.index(i).get() != rhs[i] {
                same = false;
            }
        }
        same
    }
}

impl<N: Felt> Eq<ArrayRef<u64, N>> for ArrayRef<u64, N> {
    pub fn eq(self: Self, rhs: ArrayRef<u64, N>) -> bool {
        let mut same = true;
        for i in 0..N {
            if self.index(i).get() != rhs.index(i).get() {
                same = false;
            }
        }
        same
    }
}


