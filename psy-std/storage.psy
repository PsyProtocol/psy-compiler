use super::primitive::*;
use super::mem;
use super::context;

pub trait StorageNew {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self;
}

pub trait Storage {
    pub type RefType: StorageNew;

    pub fn size() -> Felt;
    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self;
    pub fn write(offset: Felt, value: Self);
}

pub trait StorageAt<T: Storage, N: u32> {
    pub fn read_at(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt,
        index: Felt
    ) -> Self;
    pub fn write_at(offset: Felt, index: Felt, value: T);
}

pub struct StorageRef<T, N: u32> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}

pub struct ArrayRef<T, N: u32> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}

impl<T, N: u32> StorageNew for StorageRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new StorageRef<T, N> {
            offset,
            metadata
        };
    }
}

impl<T, N: u32> StorageNew for ArrayRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new ArrayRef<T, N> {
            offset,
            metadata
        };
    }
}

impl Storage for Felt {
    pub type RefType = StorageRef<Self, 1u32>;

    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        __storage_read(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset
        )
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value);
    }
}

impl Storage for bool {
    pub type RefType = StorageRef<Self, 1u32>;

    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        __storage_read(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset
        ) as bool
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl Storage for u32 {
    pub type RefType = StorageRef<Self, 1u32>;

    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        __storage_read(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset
        ) as u32
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl<T: Storage, N: u32> Storage for [T; N] {
    pub type RefType = ArrayRef<T, N>;

    pub fn size() -> Felt {
        return T::size() * (N as Felt);
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        mem::transmute#<Self>(__storage_read_range(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset,
            Self::size()
        ))
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write_range(offset, value);
    }
}

impl<T: Storage, N: u32> StorageAt<T, N> for [T; N] {
    pub fn write_at(offset: Felt, index: Felt, value: T) {
        let offset = offset + (index * T::size());
        T::write(offset, value)
    }

    pub fn read_at(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt,
        index: Felt
    ) -> T {
        let offset = offset + (index * T::size());
        T::read(contract_state_tree_height, user_id, contract_id, offset)
    }
}

impl<T: Storage, N: u32> StorageRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new StorageRef<T, N> {
            offset,
            metadata
        };
    }

    pub fn get(self) -> T {
        return T::read(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            self.offset
        );
    }

    pub fn set(self, value: T) {
        T::write(self.offset, value);
    }

    pub fn index(self, index: Felt) -> T::RefType {
        assert(index < (N as Felt), "Index out of bounds");
        <T::RefType as StorageNew>::new(self.offset + index * T::size(), self.metadata)
    }
}

impl<T: Storage, N: u32> ArrayRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new ArrayRef<T, N> {
            offset,
            metadata
        };
    }

    pub fn get(self) -> [T; N] {
        return <[T; N]>::read(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            self.offset
        );
    }

    pub fn set(self, value: [T; N]) {
        <[T; N]>::write(self.offset, value);
    }

    pub fn index(self, index: Felt) -> T::RefType {
        assert(index < (N as Felt), "Index out of bounds");
        <T::RefType as StorageNew>::new(self.offset + index * T::size(), self.metadata)
    }
}

pub struct ContractMetadata {
    pub contract_state_tree_height: Felt,
    pub contract_id: Felt,
    pub user_id: Felt,
}

impl ContractMetadata {
    pub fn new(contract_id: Felt, user_id: Felt) -> Self {
        return new ContractMetadata {
            contract_state_tree_height: 32,
            contract_id,
            user_id
        };
    }

    pub fn current() -> Self {
        return new ContractMetadata {
            contract_state_tree_height: 32,
            contract_id: context::get_contract_id(),
            user_id: context::get_user_id(),
        };
    }

    pub fn get_contract_id(self) -> Felt {
        self.contract_id
    }

    pub fn get_user_id(self) -> Felt {
        self.user_id
    }
}

pub trait EqAssign<Rhs> {
    pub fn eq_assign(self: Self, rhs: Rhs);
}

pub trait Eq<Rhs> {
    pub fn eq(self: Self, rhs: Rhs) -> bool;
}

pub trait AddAssign<Rhs> {
    pub fn add_assign(self: Self, rhs: Rhs);
}

pub trait SubAssign<Rhs> {
    pub fn sub_assign(self: Self, rhs: Rhs);
}

pub trait MulAssign<Rhs> {
    pub fn mul_assign(self: Self, rhs: Rhs);
}

pub trait DivAssign<Rhs> {
    pub fn div_assign(self: Self, rhs: Rhs);
}

pub trait RemAssign<Rhs> {
    pub fn rem_assign(self: Self, rhs: Rhs);
}

pub trait BitAndAssign<Rhs> {
    pub fn bitand_assign(self: Self, rhs: Rhs);
}

pub trait BitOrAssign<Rhs> {
    pub fn bitor_assign(self: Self, rhs: Rhs);
}

pub trait BitXorAssign<Rhs> {
    pub fn bitxor_assign(self: Self, rhs: Rhs);
}

pub trait ShlAssign<Rhs> {
    pub fn shl_assign(self: Self, rhs: Rhs);
}

pub trait ShrAssign<Rhs> {
    pub fn shr_assign(self: Self, rhs: Rhs);
}

impl<T: Storage, N: u32> EqAssign<T> for StorageRef<T, N> {
    pub fn eq_assign(self: Self, rhs: T) {
        self.set(rhs);
    }
}

impl<N: u32> Eq<Felt> for StorageRef<Felt, N> {
    pub fn eq(self: Self, rhs: Felt) -> bool {
        self.get() == rhs
    }
}

impl<N: u32> Eq<StorageRef<Felt, N>> for StorageRef<Felt, N> {
    pub fn eq(self: Self, rhs: StorageRef<Felt, N>) -> bool {
        self.get() == rhs.get()
    }
}

impl<N: u32> AddAssign<Felt> for StorageRef<Felt, N> {
    pub fn add_assign(self: Self, rhs: Felt) {
        self.set(self.get() + rhs);
    }
}

impl<N: u32> SubAssign<Felt> for StorageRef<Felt, N> {
    pub fn sub_assign(self: Self, rhs: Felt) {
        self.set(self.get() - rhs);
    }
}

impl<N: u32> MulAssign<Felt> for StorageRef<Felt, N> {
    pub fn mul_assign(self: Self, rhs: Felt) {
        self.set(self.get() * rhs);
    }
}

impl<N: u32> DivAssign<Felt> for StorageRef<Felt, N> {
    pub fn div_assign(self: Self, rhs: Felt) {
        self.set(self.get() / rhs);
    }
}

impl<N: u32> RemAssign<Felt> for StorageRef<Felt, N> {
    pub fn rem_assign(self: Self, rhs: Felt) {
        self.set(self.get() % rhs);
    }
}

impl<N: u32> BitAndAssign<Felt> for StorageRef<Felt, N> {
    pub fn bitand_assign(self: Self, rhs: Felt) {
        self.set(self.get() & rhs);
    }
}

impl<N: u32> BitOrAssign<Felt> for StorageRef<Felt, N> {
    pub fn bitor_assign(self: Self, rhs: Felt) {
        self.set(self.get() | rhs);
    }
}

impl<N: u32> BitXorAssign<Felt> for StorageRef<Felt, N> {
    pub fn bitxor_assign(self: Self, rhs: Felt) {
        self.set(self.get() ^ rhs);
    }
}

impl<N: u32> ShlAssign<Felt> for StorageRef<Felt, N> {
    pub fn shl_assign(self: Self, rhs: Felt) {
        self.set(self.get() << rhs);
    }
}

impl<N: u32> ShrAssign<Felt> for StorageRef<Felt, N> {
    pub fn shr_assign(self: Self, rhs: Felt) {
        self.set(self.get() >> rhs);
    }
}

impl<N: u32> Eq<u32> for StorageRef<u32, N> {
    pub fn eq(self: Self, rhs: u32) -> bool {
        self.get() == rhs
    }
}

impl<N: u32> Eq<StorageRef<u32, N>> for StorageRef<u32, N> {
    pub fn eq(self: Self, rhs: StorageRef<u32, N>) -> bool {
        self.get() == rhs.get()
    }
}

impl<N: u32> Eq<bool> for StorageRef<bool, N> {
    pub fn eq(self: Self, rhs: bool) -> bool {
        self.get() == rhs
    }
}

impl<N: u32> Eq<StorageRef<bool, N>> for StorageRef<bool, N> {
    pub fn eq(self: Self, rhs: StorageRef<bool, N>) -> bool {
        self.get() == rhs.get()
    }
}

impl<N: u32> Eq<[Felt; N]> for [Felt; N] {
    pub fn eq(self: Self, rhs: [Felt; N]) -> bool {
        let mut same = true;
        for i in 0u32..N {
            if self[i as Felt] != rhs[i as Felt] {
                same = false;
            }
        }
        same
    }
}

impl<N: u32> Eq<[u32; N]> for [u32; N] {
    pub fn eq(self: Self, rhs: [u32; N]) -> bool {
        let mut same = true;
        for i in 0u32..N {
            if self[i as Felt] != rhs[i as Felt] {
                same = false;
            }
        }
        same
    }
}

impl<N: u32> EqAssign<[Felt; N]> for [StorageRef<Felt, 1u32>; N] {
    pub fn eq_assign(self: Self, rhs: [Felt; N]) {
        for i in 0u32..N {
            self[i as Felt].set(rhs[i as Felt]);
        }
    }
}

impl<N: u32> EqAssign<[u32; N]> for [StorageRef<u32, 1u32>; N] {
    pub fn eq_assign(self: Self, rhs: [u32; N]) {
        for i in 0u32..N {
            self[i as Felt].set(rhs[i as Felt]);
        }
    }
}

impl<T: Storage, N: u32> EqAssign<[T; N]> for ArrayRef<T, N> {
    pub fn eq_assign(self: Self, rhs: [T; N]) {
