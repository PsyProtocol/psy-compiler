// Typed uint map values use a separate key space from the generic digest API.
// u64 and u128 fit in one IMT entry; u256 consumes two entries.
impl ToHash for u64 {
    pub fn to_hash(self) -> Hash {
        hash(mem::transmute::<[u32; 2]>(self))
    }
}

impl ToHash for u128 {
    pub fn to_hash(self) -> Hash {
        hash(mem::transmute::<[u32; 4]>(self))
    }
}

pub fn uint_map_key_hash(namespace: Felt, key_hash: Hash, width: Felt) -> Hash {
    // ASCII "UINTMAP" and the width separate typed values from each other.
    hash([0x55494e544d4150, width, namespace, key_hash[0], key_hash[1], key_hash[2], key_hash[3]])
}

impl<K: ToHash, C: u32> MapRef<K, u64, C> {
    pub fn get_value(self: Self, key: K) -> u64 {
        assert(C >= 1u32, "u64 map values require one IMT entry");
        let words = __imt_get(uint_map_key_hash(0, key.to_hash(), 64), self.offset, C as Felt);
        mem::transmute::<u64>([words[0], words[1]])
    }

    pub fn set_value(self: Self, key: K, value: u64) -> u64 {
        assert(C >= 1u32, "u64 map values require one IMT entry");
        let previous = self.get_value(key);
        let words = mem::transmute::<[u32; 2]>(value);
        __imt_set(uint_map_key_hash(0, key.to_hash(), 64), [words[0] as Felt, words[1] as Felt, 0, 0], self.offset, C as Felt);
        previous
    }

    pub fn get_value_other(self: Self, key: K) -> u64 {
        assert(C >= 1u32, "u64 map values require one IMT entry");
        let words = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, uint_map_key_hash(0, key.to_hash(), 64), self.offset, C as Felt);
        mem::transmute::<u64>([words[0], words[1]])
    }
}

impl<K: ToHash, C: u32> NamespacedMapRef<K, u64, C> {
    pub fn get_value(self: Self, namespace: Felt, key: K) -> u64 {
        assert(C >= 1u32, "u64 map values require one IMT entry");
        let words = __imt_get(uint_map_key_hash(namespace, key.to_hash(), 64), self.offset, C as Felt);
        mem::transmute::<u64>([words[0], words[1]])
    }

    pub fn set_value(self: Self, namespace: Felt, key: K, value: u64) -> u64 {
        assert(C >= 1u32, "u64 map values require one IMT entry");
        let previous = self.get_value(namespace, key);
        let words = mem::transmute::<[u32; 2]>(value);
        __imt_set(uint_map_key_hash(namespace, key.to_hash(), 64), [words[0] as Felt, words[1] as Felt, 0, 0], self.offset, C as Felt);
        previous
    }

    pub fn get_value_other(self: Self, namespace: Felt, key: K) -> u64 {
        assert(C >= 1u32, "u64 map values require one IMT entry");
        let words = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, uint_map_key_hash(namespace, key.to_hash(), 64), self.offset, C as Felt);
        mem::transmute::<u64>([words[0], words[1]])
    }
}

impl<K: ToHash, C: u32> MapRef<K, u128, C> {
    pub fn get_value(self: Self, key: K) -> u128 {
        assert(C >= 1u32, "u128 map values require one IMT entry");
        let words = __imt_get(uint_map_key_hash(0, key.to_hash(), 128), self.offset, C as Felt);
        mem::transmute::<u128>([words[0], words[1], words[2], words[3]])
    }

    pub fn set_value(self: Self, key: K, value: u128) -> u128 {
        assert(C >= 1u32, "u128 map values require one IMT entry");
