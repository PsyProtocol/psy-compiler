pub fn sum_bits<N: Felt>(bits: [Felt; N]) -> Felt {
    __sum_bits(bits)
}

pub fn split_bits<N: Felt>(target: Felt, num_bits: N) -> [Felt; N] {
    __split_bits(target, num_bits)
}

