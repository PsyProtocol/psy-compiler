        let words = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, uint_map_key_hash(0, key.to_hash(), 128), self.offset, C as Felt);
        mem::transmute::<u128>([words[0], words[1], words[2], words[3]])
    }
}

impl<K: ToHash, C: u32> NamespacedMapRef<K, u128, C> {
    pub fn get_value(self: Self, namespace: Felt, key: K) -> u128 {
        assert(C >= 1u32, "u128 map values require one IMT entry");
