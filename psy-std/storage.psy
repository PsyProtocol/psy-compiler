impl<N: u32> Eq<[Felt; N]> for ArrayRef<Felt, N> {
    pub fn eq(self: Self, rhs: [Felt; N]) -> bool {
        let mut same = true;
        for i in 0u32..N {
            if self.index(i as Felt).get() != rhs[i as Felt] {
                same = false;
            }
        }
        same
    }
}

