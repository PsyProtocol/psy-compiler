use super::primitive::*;
use super::mem;
use super::context;

pub trait StorageNew {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self;
}

pub trait Storage {
    pub type RefType: StorageNew;

    pub fn size() -> Felt;
    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self;
    pub fn write(offset: Felt, value: Self);
}

pub trait StorageAt<T: Storage, N: u32> {
    pub fn read_at(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt,
        index: Felt
    ) -> Self;
    pub fn write_at(offset: Felt, index: Felt, value: T);
}

pub trait ToHash {
    pub fn to_hash(self) -> Hash;
}

pub fn namespaced_key_hash(namespace: Felt, key_hash: Hash) -> Hash {
    return hash([namespace, key_hash[0], key_hash[1], key_hash[2], key_hash[3]]);
}

impl ToHash for Hash {
    pub fn to_hash(self) -> Hash {
        self
    }
}

impl<T, N: u32> ToHash for [T; N] {
    pub fn to_hash(self) -> Hash {
        hash(self)
    }
}

pub struct StorageRef<T> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}

pub struct ArrayRef<T, N: u32> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}

pub struct Map<K, V, C: u32> {}
pub struct NamespacedMap<K, V, C: u32> {}

pub struct MapRef<K, V, C: u32> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}
pub struct NamespacedMapRef<K, V, C: u32> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}

impl<T> StorageNew for StorageRef<T> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new StorageRef<T> {
            offset,
            metadata
        };
    }
}

impl<T, N: u32> StorageNew for ArrayRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new ArrayRef<T, N> {
            offset,
            metadata
        };
    }
}

impl<K, V, C: u32> StorageNew for MapRef<K, V, C> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new MapRef<K, V, C> {
            offset,
            metadata
        };
    }
}

impl<K, V, C: u32> StorageNew for NamespacedMapRef<K, V, C> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new NamespacedMapRef<K, V, C> {
            offset,
            metadata
        };
    }
}

impl Storage for Felt {
    pub type RefType = StorageRef<Self>;

    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        __storage_read(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset
        )
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value);
    }
}

impl Storage for bool {
    pub type RefType = StorageRef<Self>;

    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        __storage_read(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset
        ) as bool
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl Storage for u32 {
    pub type RefType = StorageRef<Self>;

    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        __storage_read(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset
        ) as u32
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl<T: Storage, N: u32> Storage for [T; N] {
    pub type RefType = ArrayRef<T, N>;

    pub fn size() -> Felt {
        return T::size() * (N as Felt);
    }

    pub fn read(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt
    ) -> Self {
        mem::transmute#<Self>(__storage_read_range(
            contract_state_tree_height,
            user_id,
            contract_id,
            offset,
            Self::size()
        ))
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write_range(offset, value);
    }
}

impl<K, V, C: u32> Storage for Map<K, V, C> {
    pub type RefType = MapRef<K, V, C>;

    pub fn size() -> Felt {
        C as Felt
    }

    pub fn read(
        _contract_state_tree_height: Felt,
        _user_id: Felt,
        _contract_id: Felt,
        _offset: Felt
    ) -> Self {
        new Map<K, V, C> {}
    }

    pub fn write(_offset: Felt, _value: Self) {
        assert(false, "Map does not support whole-value write");
    }
}

impl<K, V, C: u32> Storage for NamespacedMap<K, V, C> {
    pub type RefType = NamespacedMapRef<K, V, C>;

    pub fn size() -> Felt {
        C as Felt
    }

    pub fn read(
        _contract_state_tree_height: Felt,
        _user_id: Felt,
        _contract_id: Felt,
        _offset: Felt
    ) -> Self {
        new NamespacedMap<K, V, C> {}
    }

    pub fn write(_offset: Felt, _value: Self) {
        assert(false, "NamespacedMap does not support whole-value write");
    }
}

impl<T: Storage, N: u32> StorageAt<T, N> for [T; N] {
    pub fn write_at(offset: Felt, index: Felt, value: T) {
        let offset = offset + (index * T::size());
        T::write(offset, value)
    }

    pub fn read_at(
        contract_state_tree_height: Felt,
        user_id: Felt,
        contract_id: Felt,
        offset: Felt,
        index: Felt
    ) -> T {
        let offset = offset + (index * T::size());
        T::read(contract_state_tree_height, user_id, contract_id, offset)
    }
}

impl<T: Storage> StorageRef<T> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new StorageRef<T> {
            offset,
            metadata
        };
    }

    pub fn get(self) -> T {
        return T::read(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            self.offset
        );
    }

    pub fn set(self, value: T) {
        T::write(self.offset, value);
    }

}

impl<T: Storage, N: u32> ArrayRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new ArrayRef<T, N> {
            offset,
            metadata
        };
    }

    pub fn get(self) -> [T; N] {
        return <[T; N]>::read(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            self.offset
        );
    }

    pub fn set(self, value: [T; N]) {
        <[T; N]>::write(self.offset, value);
    }

    pub fn index(self, index: Felt) -> T::RefType {
        assert(index < (N as Felt), "Index out of bounds");
        <T::RefType as StorageNew>::new(self.offset + index * T::size(), self.metadata)
    }
}

impl<K: ToHash, V: ToHash, C: u32> MapRef<K, V, C> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new MapRef<K, V, C> {
            offset,
            metadata
        };
    }

    pub fn size() -> Felt {
        C as Felt
    }

    pub fn get(self: Self, key: K) -> Hash {
        return __imt_get(key.to_hash(), self.offset, C as Felt);
    }

    pub fn insert(self: Self, key: K, value: V) -> Hash {
        return __imt_set(key.to_hash(), value.to_hash(), self.offset, C as Felt);
    }

    pub fn set(self: Self, key: K, value: V) -> Hash {
        return self.insert(key, value);
    }

    pub fn contains(self: Self, key: K) -> bool {
        return __imt_contains(key.to_hash(), self.offset, C as Felt);
    }

    fn key_with_namespace(namespace: Felt, key: K) -> Hash {
        let k = key.to_hash();
        return namespaced_key_hash(namespace, k);
    }

    pub fn get_ns(self: Self, namespace: Felt, key: K) -> Hash {
        return __imt_get(Self::key_with_namespace(namespace, key), self.offset, C as Felt);
    }

    pub fn insert_ns(self: Self, namespace: Felt, key: K, value: V) -> Hash {
        return __imt_set(Self::key_with_namespace(namespace, key), value.to_hash(), self.offset, C as Felt);
    }

    pub fn set_ns(self: Self, namespace: Felt, key: K, value: V) -> Hash {
        return self.insert_ns(namespace, key, value);
    }

    pub fn contains_ns(self: Self, namespace: Felt, key: K) -> bool {
        return __imt_contains(Self::key_with_namespace(namespace, key), self.offset, C as Felt);
    }

    pub fn get_other(self: Self, key: K) -> Hash {
        return __imt_get_other_user(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            key.to_hash(),
            self.offset,
            C as Felt
        );
    }

    pub fn contains_other(self: Self, key: K) -> bool {
        return context::imt_contains_other_user(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            key.to_hash(),
            self.offset,
            C as Felt
        );
    }

    pub fn get_ns_other(self: Self, namespace: Felt, key: K) -> Hash {
        return __imt_get_other_user(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            Self::key_with_namespace(namespace, key),
            self.offset,
            C as Felt
        );
    }

    pub fn contains_ns_other(self: Self, namespace: Felt, key: K) -> bool {
        return context::imt_contains_other_user(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            Self::key_with_namespace(namespace, key),
            self.offset,
            C as Felt
        );
    }
}

impl<K: ToHash, V: ToHash, C: u32> NamespacedMapRef<K, V, C> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new NamespacedMapRef<K, V, C> {
            offset,
            metadata
        };
    }

    pub fn size() -> Felt {
        C as Felt
    }

    fn key_with_namespace(namespace: Felt, key: K) -> Hash {
        let k = key.to_hash();
        return namespaced_key_hash(namespace, k);
    }

    pub fn get(self: Self, namespace: Felt, key: K) -> Hash {
        return __imt_get(Self::key_with_namespace(namespace, key), self.offset, C as Felt);
    }

    pub fn insert(self: Self, namespace: Felt, key: K, value: V) -> Hash {
        return __imt_set(Self::key_with_namespace(namespace, key), value.to_hash(), self.offset, C as Felt);
    }

    pub fn set(self: Self, namespace: Felt, key: K, value: V) -> Hash {
        return self.insert(namespace, key, value);
    }

    pub fn contains(self: Self, namespace: Felt, key: K) -> bool {
        return __imt_contains(Self::key_with_namespace(namespace, key), self.offset, C as Felt);
    }

    pub fn get_other(self: Self, namespace: Felt, key: K) -> Hash {
        return __imt_get_other_user(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            Self::key_with_namespace(namespace, key),
            self.offset,
            C as Felt
        );
    }

    pub fn contains_other(self: Self, namespace: Felt, key: K) -> bool {
        return context::imt_contains_other_user(
            self.metadata.contract_state_tree_height,
            self.metadata.user_id,
            self.metadata.contract_id,
            Self::key_with_namespace(namespace, key),
            self.offset,
            C as Felt
        );
    }
}

impl<K: ToHash, V: ToHash, C: u32> StorageRef<NamespacedMap<K, V, C>> {
    fn key_with_namespace(namespace: Felt, key: K) -> Hash {
        let k = key.to_hash();
        return namespaced_key_hash(namespace, k);
    }

    pub fn size() -> Felt {
        C as Felt
    }

    pub fn get(self: Self, namespace: Felt, key: K) -> Hash {
        return __imt_get(Self::key_with_namespace(namespace, key), self.offset, C as Felt);
    }

    pub fn insert(self: Self, namespace: Felt, key: K, value: V) -> Hash {
        return __imt_set(Self::key_with_namespace(namespace, key), value.to_hash(), self.offset, C as Felt);
    }

    pub fn set(self: Self, namespace: Felt, key: K, value: V) -> Hash {
        return self.insert(namespace, key, value);
    }

    pub fn contains(self: Self, namespace: Felt, key: K) -> bool {
        return __imt_contains(Self::key_with_namespace(namespace, key), self.offset, C as Felt);
    }
}

pub struct ContractMetadata {
    pub contract_state_tree_height: Felt,
    pub contract_id: Felt,
    pub user_id: Felt,
}

impl ContractMetadata {
    pub fn new(contract_id: Felt, user_id: Felt) -> Self {
        return new ContractMetadata {
            contract_state_tree_height: 32,
            contract_id,
            user_id
        };
    }

    pub fn current() -> Self {
        return new ContractMetadata {
            contract_state_tree_height: 32,
            contract_id: context::get_contract_id(),
            user_id: context::get_user_id(),
        };
    }

    pub fn get_contract_id(self) -> Felt {
        self.contract_id
    }

    pub fn get_user_id(self) -> Felt {
        self.user_id
    }
}

pub trait EqAssign<Rhs> {
    pub fn eq_assign(self: Self, rhs: Rhs);
}

pub trait Eq<Rhs> {
    pub fn eq(self: Self, rhs: Rhs) -> bool;
}

pub trait AddAssign<Rhs> {
    pub fn add_assign(self: Self, rhs: Rhs);
}

pub trait SubAssign<Rhs> {
    pub fn sub_assign(self: Self, rhs: Rhs);
}

pub trait MulAssign<Rhs> {
    pub fn mul_assign(self: Self, rhs: Rhs);
}

pub trait DivAssign<Rhs> {
    pub fn div_assign(self: Self, rhs: Rhs);
}

pub trait RemAssign<Rhs> {
    pub fn rem_assign(self: Self, rhs: Rhs);
}

pub trait BitAndAssign<Rhs> {
    pub fn bitand_assign(self: Self, rhs: Rhs);
}

pub trait BitOrAssign<Rhs> {
    pub fn bitor_assign(self: Self, rhs: Rhs);
}

pub trait BitXorAssign<Rhs> {
    pub fn bitxor_assign(self: Self, rhs: Rhs);
}

pub trait ShlAssign<Rhs> {
    pub fn shl_assign(self: Self, rhs: Rhs);
}

pub trait ShrAssign<Rhs> {
    pub fn shr_assign(self: Self, rhs: Rhs);
}

impl<T: Storage> EqAssign<T> for StorageRef<T> {
    pub fn eq_assign(self: Self, rhs: T) {
        self.set(rhs);
    }
}

impl Eq<Felt> for StorageRef<Felt> {
    pub fn eq(self: Self, rhs: Felt) -> bool {
        self.get() == rhs
    }
}

impl Eq<StorageRef<Felt>> for StorageRef<Felt> {
    pub fn eq(self: Self, rhs: StorageRef<Felt>) -> bool {
        self.get() == rhs.get()
    }
}

impl AddAssign<Felt> for StorageRef<Felt> {
    pub fn add_assign(self: Self, rhs: Felt) {
        self.set(self.get() + rhs);
    }
}

impl SubAssign<Felt> for StorageRef<Felt> {
    pub fn sub_assign(self: Self, rhs: Felt) {
        self.set(self.get() - rhs);
    }
}

impl MulAssign<Felt> for StorageRef<Felt> {
    pub fn mul_assign(self: Self, rhs: Felt) {
        self.set(self.get() * rhs);
    }
}

impl DivAssign<Felt> for StorageRef<Felt> {
    pub fn div_assign(self: Self, rhs: Felt) {
        self.set(self.get() / rhs);
    }
}

impl RemAssign<Felt> for StorageRef<Felt> {
    pub fn rem_assign(self: Self, rhs: Felt) {
        self.set(self.get() % rhs);
    }
}

impl BitAndAssign<Felt> for StorageRef<Felt> {
    pub fn bitand_assign(self: Self, rhs: Felt) {
        self.set(self.get() & rhs);
    }
}

impl BitOrAssign<Felt> for StorageRef<Felt> {
    pub fn bitor_assign(self: Self, rhs: Felt) {
        self.set(self.get() | rhs);
    }
}

impl BitXorAssign<Felt> for StorageRef<Felt> {
    pub fn bitxor_assign(self: Self, rhs: Felt) {
        self.set(self.get() ^ rhs);
    }
}

impl ShlAssign<Felt> for StorageRef<Felt> {
    pub fn shl_assign(self: Self, rhs: Felt) {
        self.set(self.get() << rhs);
    }
}

impl ShrAssign<Felt> for StorageRef<Felt> {
    pub fn shr_assign(self: Self, rhs: Felt) {
        self.set(self.get() >> rhs);
    }
}

impl Eq<u32> for StorageRef<u32> {
    pub fn eq(self: Self, rhs: u32) -> bool {
        self.get() == rhs
    }
}

impl Eq<StorageRef<u32>> for StorageRef<u32> {
    pub fn eq(self: Self, rhs: StorageRef<u32>) -> bool {
        self.get() == rhs.get()
    }
}

impl Eq<bool> for StorageRef<bool> {
    pub fn eq(self: Self, rhs: bool) -> bool {
        self.get() == rhs
    }
}

impl Eq<StorageRef<bool>> for StorageRef<bool> {
    pub fn eq(self: Self, rhs: StorageRef<bool>) -> bool {
        self.get() == rhs.get()
    }
}

impl<N: u32> Eq<[Felt; N]> for [Felt; N] {
    pub fn eq(self: Self, rhs: [Felt; N]) -> bool {
        let mut same = true;
        for i in 0u32..N {
            if self[i as Felt] != rhs[i as Felt] {
                same = false;
            }
        }
        same
    }
}

impl<N: u32> Eq<[u32; N]> for [u32; N] {
    pub fn eq(self: Self, rhs: [u32; N]) -> bool {
        let mut same = true;
        for i in 0u32..N {
            if self[i as Felt] != rhs[i as Felt] {
                same = false;
            }
        }
        same
    }
}


impl<N: u32> EqAssign<[Felt; N]> for [StorageRef<Felt>; N] {
    pub fn eq_assign(self: Self, rhs: [Felt; N]) {
        for i in 0u32..N {
            self[i as Felt].set(rhs[i as Felt]);
        }
    }
}

impl<N: u32> EqAssign<[u32; N]> for [StorageRef<u32>; N] {
    pub fn eq_assign(self: Self, rhs: [u32; N]) {
        for i in 0u32..N {
            self[i as Felt].set(rhs[i as Felt]);
        }
    }
}

impl<T: Storage, N: u32> EqAssign<[T; N]> for ArrayRef<T, N> {
    pub fn eq_assign(self: Self, rhs: [T; N]) {
        self.set(rhs);
    }
}

impl<N: u32> EqAssign<[Felt; N]> for ArrayRef<Felt, N> {
    pub fn eq_assign(self: Self, rhs: [Felt; N]) {
