    }

    pub fn set_value(self: Self, namespace: Felt, key: K, value: u128) -> u128 {
        assert(C >= 1u32, "u128 map values require one IMT entry");
        let previous = self.get_value(namespace, key);
        let words = mem::transmute::<[u32; 4]>(value);
        __imt_set(uint_map_key_hash(namespace, key.to_hash(), 128), [words[0] as Felt, words[1] as Felt, words[2] as Felt, words[3] as Felt], self.offset, C as Felt);
        previous
    }

    pub fn get_value_other(self: Self, namespace: Felt, key: K) -> u128 {
        assert(C >= 1u32, "u128 map values require one IMT entry");
        let words = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, uint_map_key_hash(namespace, key.to_hash(), 128), self.offset, C as Felt);
        mem::transmute::<u128>([words[0], words[1], words[2], words[3]])
    }
}

// The generic get/insert methods remain the four-Felt digest API.
impl ToHash for u256 {
    pub fn to_hash(self) -> Hash {
        hash(mem::transmute::<[u32; 8]>(self))
    }
}

pub fn u256_map_key_hash(namespace: Felt, key_hash: Hash, half: Felt) -> Hash {
    // ASCII "U256MAP" separates typed values from the generic digest API.
    hash([23980577146093904, namespace, key_hash[0], key_hash[1], key_hash[2], key_hash[3], half])
}

impl<K: ToHash, C: u32> MapRef<K, u256, C> {
    pub fn get_value(self: Self, key: K) -> u256 {
        assert(C >= 2u32, "u256 map values require two IMT entries");
        let key_hash = key.to_hash();
        let low = __imt_get(u256_map_key_hash(0, key_hash, 0), self.offset, C as Felt);
        let high = __imt_get(u256_map_key_hash(0, key_hash, 1), self.offset, C as Felt);
        mem::transmute::<u256>([low[0], low[1], low[2], low[3], high[0], high[1], high[2], high[3]])
    }

    pub fn set_value(self: Self, key: K, value: u256) -> u256 {
        assert(C >= 2u32, "u256 map values require two IMT entries");
        let previous = self.get_value(key);
        let key_hash = key.to_hash();
        let limbs = mem::transmute::<[u32; 8]>(value);
        __imt_set(u256_map_key_hash(0, key_hash, 0), [limbs[0] as Felt, limbs[1] as Felt, limbs[2] as Felt, limbs[3] as Felt], self.offset, C as Felt);
        __imt_set(u256_map_key_hash(0, key_hash, 1), [limbs[4] as Felt, limbs[5] as Felt, limbs[6] as Felt, limbs[7] as Felt], self.offset, C as Felt);
        previous
    }

    pub fn get_value_other(self: Self, key: K) -> u256 {
        assert(C >= 2u32, "u256 map values require two IMT entries");
        let key_hash = key.to_hash();
        let low = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, u256_map_key_hash(0, key_hash, 0), self.offset, C as Felt);
        let high = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, u256_map_key_hash(0, key_hash, 1), self.offset, C as Felt);
        mem::transmute::<u256>([low[0], low[1], low[2], low[3], high[0], high[1], high[2], high[3]])
    }
}

impl<K: ToHash, C: u32> NamespacedMapRef<K, u256, C> {
    pub fn get_value(self: Self, namespace: Felt, key: K) -> u256 {
        assert(C >= 2u32, "u256 map values require two IMT entries");
        let key_hash = key.to_hash();
        let low = __imt_get(u256_map_key_hash(namespace, key_hash, 0), self.offset, C as Felt);
        let high = __imt_get(u256_map_key_hash(namespace, key_hash, 1), self.offset, C as Felt);
        mem::transmute::<u256>([low[0], low[1], low[2], low[3], high[0], high[1], high[2], high[3]])
    }

    pub fn set_value(self: Self, namespace: Felt, key: K, value: u256) -> u256 {
        assert(C >= 2u32, "u256 map values require two IMT entries");
        let previous = self.get_value(namespace, key);
        let key_hash = key.to_hash();
        let limbs = mem::transmute::<[u32; 8]>(value);
        __imt_set(u256_map_key_hash(namespace, key_hash, 0), [limbs[0] as Felt, limbs[1] as Felt, limbs[2] as Felt, limbs[3] as Felt], self.offset, C as Felt);
        __imt_set(u256_map_key_hash(namespace, key_hash, 1), [limbs[4] as Felt, limbs[5] as Felt, limbs[6] as Felt, limbs[7] as Felt], self.offset, C as Felt);
        previous
    }

    pub fn get_value_other(self: Self, namespace: Felt, key: K) -> u256 {
        assert(C >= 2u32, "u256 map values require two IMT entries");
        let key_hash = key.to_hash();
        let low = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, u256_map_key_hash(namespace, key_hash, 0), self.offset, C as Felt);
        let high = __imt_get_other_user(self.metadata.contract_state_tree_height, self.metadata.user_id, self.metadata.contract_id, u256_map_key_hash(namespace, key_hash, 1), self.offset, C as Felt);
        mem::transmute::<u256>([low[0], low[1], low[2], low[3], high[0], high[1], high[2], high[3]])
    }
}
