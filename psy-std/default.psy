pub trait Default {
    pub fn default() -> Self;
}

impl Default for Felt {
    pub fn default() -> Self {
        return 0;
    }
}

impl Default for bool {
    pub fn default() -> Self {
        return false;
    }
}

impl Default for u32 {
    pub fn default() -> Self {
        return 0u32;
    }
}

impl Default for u64 {
    pub fn default() -> Self {
        return 0u64;
    }
}

impl Default for u128 {
    pub fn default() -> Self {
        return 0u128;
    }
}

impl Default for u256 {
    pub fn default() -> Self {
        return 0u256;
    }
}
