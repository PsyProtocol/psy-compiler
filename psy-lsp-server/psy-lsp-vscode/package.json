{
  "name": "psy-lsp-vscode",
  "displayName": "psy-lsp-vscode",
  "description": "lsp for vscode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "psy",
        "aliases": [
          "psy-lang",
          "psy"
        ],
        "extensions": [
          ".psy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "psy",
        "scopeName": "source.psy",
        "path": "./syntaxes/psy.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:psy"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "typescript": "^5.8.2",
    "vscode": "^1.1.37"
  }
}
