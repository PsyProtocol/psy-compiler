use psy_common::{FileId, Arena};
use psy_vm::dpn::ops::context_trait::{ContextFelt, DPNContext};
use psy_ast::*;
use psy_lexer::Token;

grammar<'input, F, C>(
    file_content: &'input str,
    file_id: FileId,
    module_name: Identifier,
    expr_nodes: &mut Arena<ExprId, ExprNode<F>>,
    stmt_nodes: &mut Arena<StmtId, StmtNode>,
    def_nodes: &mut Arena<DefId, DefinitionNode>,
    interner: &mut Interner,
    _visibility_: Visibility,
    ctx: &mut C
) where F: ContextFelt + From<u32>, C: DPNContext<F>;

use super::{Loc, UserError, LalrpopError};
use std::convert::TryFrom;

ModuleItem: ModuleItemNode = {
    InlineModule => ModuleItemNode::InlineModule(<>),
    ModuleDecl => ModuleItemNode::ModuleDecl(<>),
    Definition => ModuleItemNode::Definition(def_nodes.alloc_item(<>)),
}

Comment: Comment = {
    <l:@L> <line:LineComment> <r:@R> => Comment::new_line(line.to_string(), Location::new(file_id, l, r)),
    <l:@L> <block:BlockComment> <r:@R> => Comment::new_block(block.to_string(), Location::new(file_id, l, r)),
}

pub Module: ModuleNode = {
    <l:@L> <module_items: ModuleItem*>  <r:@R> <back_comments:Comment*> => ModuleNode::new(
        module_name,
        file_id,
        _visibility_,
        module_items,
        def_nodes,
        back_comments,
        Location::new(file_id, l, r),
    )
}

InlineModule: ModuleNode = {
    <l:@L> <comments: Comment*> <visibility:Visibility> MOD <name:Identifier> "{" <module_items: ModuleItem*> <back_comments:Comment*> "}" <r:@R> => ModuleNode::new(
        name,
        file_id,
        visibility,
        module_items,
        def_nodes,
        comments.into_iter().chain(back_comments.into_iter()).collect(),
        Location::new(file_id, l, r),
    )
}

ModuleDecl: (Identifier, Visibility, Location) = {
    <l:@L> <visibility:Visibility> MOD <name:Identifier> ";" <r:@R> => {
        (name, visibility, Location::new(file_id, l, r))
    },
}

Statement: StmtNode = {
    VariableStatement,
    AssignmentStatement,
    ReturnStatement,
    WhileStatement,
    ForStatement,
    Definition => StmtNode::Definition(def_nodes.alloc_item(<>)),
    IntrinsicStatement,
    ExpressionStatement
}

ExpressionStatement: StmtNode = {
    <l:@L> <comments: Comment*> <expr:Expression> ";" <r:@R> => StmtNode::Expression(expr_nodes.alloc_item(expr)),
}

IntrinsicStatement: StmtNode = {
    <l:@L> <comments: Comment*> <variable:ASSERT> "(" <left: Expression> "," <message: STRING?> ","? ")" ";" <r:@R> => {
        StmtNode::Intrinsic(
            IntrinsicStmtNode::Assert {
                left: expr_nodes.alloc_item(left),
                message: message.map(|m| m.to_string()),
                comments,
                location: Location::new(file_id, l, r),
            }
        )
    },
    <l:@L> <comments: Comment*> <variable:ASSERT_EQ> "(" <left: Expression> "," <right: Expression> "," <message: STRING?> ","? ")" ";" <r:@R> => {
        StmtNode::Intrinsic(
            IntrinsicStmtNode::AssertEq {
                left: expr_nodes.alloc_item(left),
                right: expr_nodes.alloc_item(right),
                message: message.map(|m| m.to_string()),
                comments,
                location: Location::new(file_id, l, r),
            }
        )
    },
    <l:@L> <comments: Comment*> <variable:CTX_CLEAR_ENTIRE_TREE> "(" ")" ";" <r:@R> => {
        StmtNode::Intrinsic(
            IntrinsicStmtNode::ClearEntireTree {
                comments,
                location: Location::new(file_id, l, r),
            }
        )
    },
}

Definition: DefinitionNode = {
    ImplDef => DefinitionNode::Impl(<>),
    TraitImplDef => DefinitionNode::TraitImpl(<>),
    TraitDef => DefinitionNode::Trait(<>),
    EnumDef => DefinitionNode::Enum(<>),
    StructDef => DefinitionNode::Struct(<>),
    TypeAliasDef => <>,
    <f:FunctionDef> =>? {
        if f.as_function().unwrap().body.is_none() {
            return Err(LalrpopError::User { error: UserError::FunctionBodyMissing });

        }
        if f.as_function().unwrap().parameters.iter().any(|p|{
             p.name == IdentId::SELF || (p.ty.is_basic() && p.ty.as_basic().unwrap().id == IdentId::TYPE_SELF)
        }) {
            return Err(LalrpopError::User { error: UserError::InvalidSelfParameter });
        }
        Ok(f)
    },
    ConstDef => <>,
    UseDef => DefinitionNode::Use(<>),
}

UseDef: UseNode = {
    <l:@L> <comments: Comment*> <visibility:Visibility> USE <path:UseNode> ";" <r:@R> => {
        UseNode {
            visibility,
            kind: path.0,
            target: path.2,
            segments: path.1,
            comments,
            location: Location::new(file_id, l, r),
        }
    }
}

ImplDef: ImplNode = {
   <l:@L> <comments: Comment*> IMPL <generic_parameters_lhs:GenericParameters> <ty:PathTy> "{" <associated_types:AssociatedTypeValue*> <body:FunctionDef*> <back_comments: Comment*> "}" <r:@R> =>? Ok({
        ImplNode {
            generic_parameters: generic_parameters_lhs,
            ty,
            associated_types: associated_types.into_iter().collect(),
            body: {
                if body.iter().any(|f| {
                     f.as_function().unwrap().body.is_none()
                }) {
                    return Err(LalrpopError::User {
                        error: UserError::FunctionBodyMissing
                    });
                }
                if body.iter().any(|f| {
                    f.as_function()
                        .unwrap()
                        .parameters
                        .iter()
                        .enumerate()
                        .any(|(i, p)| p.name == IdentId::SELF && i != 0)
                }) {
                    return Err(LalrpopError::User {
                        error: UserError::InvalidSelfParameter
                    });
                }
                def_nodes.alloc_items(body)
            },
            comments: comments.into_iter().chain(back_comments.into_iter()).collect(),
            location: Location::new(file_id, l, r),
            is_generated: false,
        }
   })
}

TraitImplDef: TraitImplNode = {
   <l:@L> <comments: Comment*> IMPL <generic_parameters_lhs:GenericParameters> <trait_ty:PathTy> FOR <ty:PathTy> "{" <associated_types:AssociatedTypeValue*> <body:FunctionDef*> <back_comments: Comment*> "}" <r:@R> =>? Ok({
        TraitImplNode {
            generic_parameters: generic_parameters_lhs,
            associated_types: associated_types.into_iter().collect(),
            trait_ty: trait_ty,
            ty,
            body: {
                if body.iter().any(|f| {
                    f.as_function().unwrap().body.is_none()
                }) {
                    return  Err(LalrpopError::User {
                        error: UserError::FunctionBodyMissing
                    });
                }
                if body.iter().any(|f| {
                    f.as_function()
                        .unwrap()
                        .parameters
                        .iter()
                        .enumerate()
                        .any(|(i, p)| p.name == IdentId::SELF && i != 0)
                }) {
                    return Err(LalrpopError::User {
                        error: UserError::InvalidSelfParameter
                    });
                }
                def_nodes.alloc_items(body)
            },
            comments: comments.into_iter().chain(back_comments.into_iter()).collect(),
            location: Location::new(file_id, l, r),
            is_generated: false,
        }
   })
}

AssociatedTypeValue: (Identifier, AssociatedTypeValue) = {
    <l:@L> <comments: Comment*> <visibility: Visibility> TYPE <name:Identifier> "=" <ty:PathTy> ";" <r:@R> =>  (
        name,
        AssociatedTypeValue {
            ty,
            comments,
            visibility,
            location: Location::new(file_id, l, r)
        }
    ),
}

TraitDef: TraitNode = {
   <l:@L> <comments: Comment*> <visibility:Visibility> TRAIT <name:Identifier> <generic_parameters:GenericParameters> "{" <associated_types:TraitAssociatedType*> <body:FunctionDef*> <back_comments: Comment*> "}" <r:@R> => {
       TraitNode {
           generic_parameters,
           associated_types: associated_types.into_iter().collect(),
           name,
           body: def_nodes.alloc_items(body),
           visibility,
           comments: comments.into_iter().chain(back_comments.into_iter()).collect(),
           location: Location::new(file_id, l, r),
       }
   }
}

TraitAssociatedType: (Identifier, AssociatedType) = {
    <l:@L> <comments: Comment*> <visibility:Visibility> TYPE <ty:GenericParameter> ";" <r:@R> => (
        Identifier::new(ty.name, ty.location),
        AssociatedType {constraints: ty.constraints, visibility, location: Location::new(file_id, l, r), comments,}
    )
}

EnumDef: EnumNode = {
    <l:@L> <comments: Comment*> <visibility:Visibility> ENUM <name:Identifier> <generic_parameters:GenericParameters> "{" <variants:Comma<EnumVariant>> "}" <r:@R> => EnumNode {
        name,
        generic_parameters,
        variants,
        visibility,
        comments,
        location: Location::new(file_id, l, r),
    }
}

TypeAliasDef: DefinitionNode = {
    <l:@L> <comments: Comment*> <visibility:Visibility> TYPE <name:Identifier> "=" <ty:PathTy> ";" <r:@R> => DefinitionNode::TypeAlias(TypeAliasNode {
        name,
        ty,
        visibility,
        comments,
        location: Location::new(file_id, l, r),
    })
}

StructDef: StructNode = {
    <l:@L> <comments: Comment*> <attrs:Attribute*> <visibility: Visibility> STRUCT <name:Identifier> <generic_parameters:GenericParameters> "{" <fields:Comma<FieldTypeAnnotation>> "}" <r:@R> => StructNode {
        name,
        generic_parameters,
        fields: fields.into_iter().collect(),
        attrs,
        visibility,
        comments,
        location: Location::new(file_id, l, r),
        is_generated: false
    }
}

ConstDef: DefinitionNode = {
    <l:@L> <comments: Comment*> <visibility:Visibility> CONST <name:Identifier> ":" <ty:ConstType> "=" <value:Expression> ";" <r:@R> => DefinitionNode::Const(ConstNode {
        name,
        ty,
        value: expr_nodes.alloc_item(value),
        visibility,
        comments,
        location: Location::new(file_id, l, r),
    })
}

FunctionDef: DefinitionNode = {
    <l:@L> <comments: Comment*> <attrs:Attribute*> <visibility:Visibility> <qualifier:Qualifier> FN <name:IdentifierOrNew> <generic_parameters:GenericParameters> "(" <parameters:Comma<FunctionParameter>> ")" <return_type:FunctionReturn?> <block_expr:BlockExpression> <r:@R> =>? Ok(DefinitionNode::Function(FunctionNode {
        name,
        parameters,
        generic_parameters,
        body: Some(expr_nodes.alloc_item(block_expr)),
        return_type,
        qualifier,
        visibility,
        attrs,
        comments,
        location: Location::new(file_id, l, r),
    })),
    <l:@L> <comments: Comment*> <attrs:Attribute*> <visibility:Visibility> <qualifier:Qualifier> FN <name:IdentifierOrNew> <generic_parameters:GenericParameters> "(" <parameters:Comma<FunctionParameter>> ")" <return_type:FunctionReturn?> ";" <r:@R> =>? Ok(DefinitionNode::Function(FunctionNode {
        name,
        parameters,
        generic_parameters,
        body: None,
        return_type,
        qualifier,
        visibility,
        attrs,
        comments,
        location: Location::new(file_id, l, r),
    }))
}

Attribute: AttrNode = {
    <l:@L> "#" "[" <name:AttributePath>  <properties:AttributeProperties> "]" <r:@R> => {
        let mut path = name;
        let name = path.pop().expect("attribute path has at least one segment");
        AttrNode { path, name, properties, location: Location::new(file_id, l, r) }
    }
}

AttributePath: Vec<Identifier> = {
    <head:Identifier> <tail:("::" <Identifier>)*> => {
        let mut path = vec![head];
        path.extend(tail);
        path
    }
}

AttributeProperties: Vec<Identifier> = {
    <l:@L> "(" <properties:Comma<Identifier>> ")" <r:@R> => properties,
    () => vec![]
}

Qualifier: Qualifier = {
    <l:@L> <is_const:CONST?> <is_extern:EXTERN?> <r:@R> => Qualifier {
        is_extern: is_extern.is_some(),
        is_const: is_const.is_some(),
        location: Location::new(file_id, l, r),
    },
}

TypeQualifier: TypeQualifier = {
    <l:@L> <is_mutable: MUT?> <r:@R> => TypeQualifier {
        is_mutable: is_mutable.is_some(),
        location: Location::new(file_id, l, r),
    },
}

FunctionSignature: UncheckedType = {
    <l:@L> FN "(" <parameters:Comma<PathTy>> ")" <return_type:FunctionReturn?> <r:@R> => UncheckedType::FunctionSignature(
        Box::new(FunctionSignature {parameters, return_type}),
        Location::new(file_id, l, r)
    )
}

FunctionParameter: FunctionParameter = {
    <l:@L> <type_qualifier: TypeQualifier> <name:IdentifierOrSelf> ":" <ty:PathTy> <r:@R> => FunctionParameter::new(name, type_qualifier, ty, Location::new(file_id, l, r)),
    <l:@L> <type_qualifier: TypeQualifier> <name:SELF> <r:@R> => {
        FunctionParameter::new(
            Identifier::new(IdentId::SELF, Location::new(file_id, l, r)),
            type_qualifier,
            UncheckedType::Basic(Identifier::new(IdentId::TYPE_SELF, Location::new(file_id, l, r))),
            Location::new(file_id, l, r)
        )
    },
}

FunctionReturn: UncheckedType = {
    <l:@L> "->" <ty:PathTy> <r:@R> => ty,
}

EnumVariant: EnumVariant = {
    <l:@L> <name:Identifier> <r:@R> => EnumVariant::Basic(name),
    <l:@L> <name:Identifier> "(" <members:Comma<PathTy>> ")" <r:@R> => EnumVariant::Tuple(name, members),
    <l:@L> <name:Identifier> "{" <fields:Comma<FieldTypeAnnotation>> "}" <r:@R> => EnumVariant::Struct(
        name,
        fields.into_iter().map(|(field_name, field_type)| (field_name, field_type)).collect()
    )
}

TypeAnnotation: (Identifier, UncheckedType) = {
    <l:@L> <name:Identifier> ":" <ty:PathTy> <r:@R> => (name, ty),
    <l:@L> <name:Identifier> <r:@R> => (name, UncheckedType::Unknown)
}

FieldTypeAnnotation: (Identifier, StructField)  = {
    <l:@L> <comments: Comment*> <attrs:Attribute*> <visibility:Visibility> <name:Identifier> ":" <ty:PathTy> <r:@R> => (
        name,
        StructField { ty, attrs, visibility, comments, location: Location::new(file_id, l, r) }
    ),
}

Visibility: Visibility = {
    PUB => Visibility::Public,
    () => Visibility::Private
}

GenericParameters: Vec<GenericParameter> = {
    <l:@L> "<" <generic_parameters:Comma<GenericParameter>> ">" <r:@R> => generic_parameters,
    () => vec![]
}

GenericParameter: GenericParameter = {
    <l:@L> <name:Identifier> <constraints: GenericConstraints> <r:@R> => GenericParameter::new(
        name.id,
        constraints,
        Location::new(file_id, l, r)
    )
}

GenericConstraints: Vec<UncheckedType> = {
    <l:@L> ":" <constraints:Plus<PathTy>> <r:@R> => constraints,
    () => vec![]
}

BlockExpression: ExprNode<F> = {
    <l:@L> "{" <stmts:Statement*> <comments: Comment*> <ret:Expression?> "}" <r:@R> => {
        ExprNode::BlockExpr(
            BlockExprNode {
                stmts: stmt_nodes.alloc_items(stmts),
                expr: ret.map(|x| expr_nodes.alloc_item(x)),
                expr_comments: comments,
                location: Location::new(file_id, l, r),
            }
        )
    }
}

WhileStatement: StmtNode = {
    <l:@L> <comments: Comment*> WHILE <predicate:Expression> <block_expr:BlockExpression> <r:@R>  => StmtNode::While(WhileNode {
        predicate: expr_nodes.alloc_item(predicate),
        body: expr_nodes.alloc_item(block_expr),
        comments,
        location: Location::new(file_id, l, r),
    }),
}

MatchExpression: ExprNode<F> = {
    <l:@L> MATCH <scrutinee:Expression> "{" <arms:Comma<MatchArm>> "}" <r:@R> => ExprNode::Match(MatchNode {
        scrutinee: expr_nodes.alloc_item(scrutinee),
        arms,
        location: Location::new(file_id, l, r),
    }),
}

MatchArm: MatchArm = {
    <l:@L> <pattern:MatchPattern> "=>" <expr:Expression> <r:@R> => MatchArm {
        pattern,
        body: expr_nodes.alloc_item(expr),
        location: Location::new(file_id, l, r),
    }
}

MatchPattern: MatchPattern = {
    <l:@L> <pattern:Expression> <r:@R> => MatchPattern::Value(expr_nodes.alloc_item(pattern), Location::new(file_id, l, r)),
    <l:@L>  "_" <r:@R> =>  MatchPattern::PlaceHolder(Location::new(file_id, l, r)),

}

ForStatement: StmtNode = {
    <l:@L> <comments: Comment*> FOR <variable:Identifier> IN <start:Expression> ".." <end:Expression> <block_expr:BlockExpression> <r:@R> => StmtNode::For(
        ForNode {
            variable,
            start: expr_nodes.alloc_item(start),
            end: expr_nodes.alloc_item(end),
            body: expr_nodes.alloc_item(block_expr),
            comments,
            location: Location::new(file_id, l, r),
        }
    ),
}

IfExpression: ExprNode<F> = {
    <l:@L> <if_branch:IfBranch> <elseif_branches:ElseIfBranch*> <else_branch:ElseBranch?> <r:@R> => ExprNode::IfExpr(
        IfExprNode {
            if_branch,
            elseif_branches,
            else_branch,
            location: Location::new(file_id, l, r),
        }
    ),
}

IfBranch: Case = {
    <l:@L> IF <predicate:Expression> <block_expr:BlockExpression> <r:@R> => Case::new(
        expr_nodes.alloc_item(predicate),
        expr_nodes.alloc_item(block_expr),
        Location::new(file_id, l, r)
    ),
}

ElseIfBranch: Case = {
    <l:@L> ELSE IF <predicate:Expression> <block_expr:BlockExpression> <r:@R> => Case::new(
        expr_nodes.alloc_item(predicate),
        expr_nodes.alloc_item(block_expr),
        Location::new(file_id, l, r)
    ),
}

ElseBranch: ExprId = {
    <l:@L> ELSE <block_expr:BlockExpression> <r:@R> => expr_nodes.alloc_item(block_expr),
}

ReturnStatement: StmtNode = {
    <l:@L> <comments: Comment*> RETURN <ret:Expression?> ";" <r:@R> => StmtNode::Return(ReturnNode{
        expr_id: ret.map(|x| expr_nodes.alloc_item(x)),
        comments,
        location: Location::new(file_id, l, r),
    })
}

TupleType: UncheckedType = {
    <l:@L> "(" <types:Comma<PathTy>> ")" <r:@R> => UncheckedType::Tuple(types, Location::new(file_id, l, r))
}

TupleExpression: ExprNode<F> = {
    <l:@L> "(" <first:Expression> "," <rest:Comma<Expression>> ")" <r:@R> => {
        let mut elements = vec![expr_nodes.alloc_item(first)];
        elements.extend(rest.into_iter().map(|e| expr_nodes.alloc_item(e)));
        ExprNode::<F>::Tuple(TupleExprNode { elements, location: Location::new(file_id, l, r) })
    },
    //if the tuple has only one element, it should be treated as a normal expression
    "(" <expr:Expression> ")" => ExprNode::<F>::Parentheses(expr_nodes.alloc_item(expr)),
}

VariableStatement: StmtNode = {
    <l:@L> <comments: Comment*> LET <type_qualifier: TypeQualifier> <decl:TypeAnnotation> "=" <value:Expression> ";" <r:@R> => StmtNode::Variable(
        VariableNode {
            name: decl.0,
            ty: decl.1,
            qualifier: type_qualifier,
            value: expr_nodes.alloc_item(value),
            comments,
            location: Location::new(file_id, l, r),
        }
    ),
}

AssignmentStatement: StmtNode = {
    <l:@L> <comments: Comment*> <variable:Expression> "=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::Eq, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "+=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::AddAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*>  <variable:Expression> "-=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::SubAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "*=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::MulAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "/=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::DivAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "%=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::ModAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "&=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitAndAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "|=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitOrAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "^=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitXorAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> "<<=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitShlAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    ),
    <l:@L> <comments: Comment*> <variable:Expression> ">>=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitShrAssign, expr_nodes.alloc_item(value), comments, Location::new(file_id, l, r))
    )
}


Expression: ExprNode<F> = {
    #[precedence(level="1")]
    Term,
    #[precedence(level="2")]
    IntrinsicExpression,
    <l:@L> <callee:Expression> <generic_parameters:Monomorphization> "(" <args:ArgumentList> ")" <r:@R> => {
       if let ExprNode::<F>::MemberAccess(MemberAccessNode {
          target: receiver, ..
       }) = &callee {
            ExprNode::<F>::MemberCall(
               MemberCallNode {
                   receiver: receiver.clone(),
                   callee: expr_nodes.alloc_item(callee),
                   generic_parameters,
                   args: expr_nodes.alloc_items(args),
                   location: Location::new(file_id, l, r),
               }
            )
       } else {
            ExprNode::<F>::Call(
               CallNode {
                   callee: expr_nodes.alloc_item(callee),
                   generic_parameters,
                   args: expr_nodes.alloc_items(args),
                   location: Location::new(file_id, l, r),
               }
            )
       }
    },
    <l:@L> <variable:Expression> "[" <index:Expression> "]" <r:@R> => ExprNode::<F>::IndexAccess(IndexAccessNode {
        target: expr_nodes.alloc_item(variable),
        index: expr_nodes.alloc_item(index),
        location: Location::new(file_id, l, r),
    }),
    <l:@L> <variable:Expression> "." <index:U64> <r:@R> => ExprNode::<F>::TupleAccess(TupleAccessNode {
        target: expr_nodes.alloc_item(variable),
        index: index as usize,
        location: Location::new(file_id, l, r),
    }),
