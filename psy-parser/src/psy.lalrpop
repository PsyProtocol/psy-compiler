                key: expr_nodes.alloc_item(key),
                new_value: expr_nodes.alloc_item(new_value),
                base_offset: expr_nodes.alloc_item(base_offset),
                capacity: expr_nodes.alloc_item(capacity),
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:IMT_CONTAINS> "(" <key: Expression> "," <base_offset: Expression> "," <capacity: Expression> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::ImtContains {
                key: expr_nodes.alloc_item(key),
                base_offset: expr_nodes.alloc_item(base_offset),
                capacity: expr_nodes.alloc_item(capacity),
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:INVOKE_SYNC> "#" "<" <return_type:Ty> ">"  "(" <contract_id: Expression> "," <method_id: Expression>  "," <inputs: Expression> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::InvokeSync {
                contract_id: expr_nodes.alloc_item(contract_id),
                method_id: expr_nodes.alloc_item(method_id),
                inputs: expr_nodes.alloc_item(inputs),
                return_type,
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:INVOKE_DEFERRED> "(" <contract_id: Expression> "," <method_id: Expression>  "," <inputs: Expression> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::InvokeDeferred {
                contract_id: expr_nodes.alloc_item(contract_id),
                method_id: expr_nodes.alloc_item(method_id),
                inputs: expr_nodes.alloc_item(inputs),
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:SUM_BITS> "(" <bits: Expression> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::SumBits {
                bits: expr_nodes.alloc_item(bits),
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:SPLIT_BITS> "(" <target: Expression> "," <num_bits: U64> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::SplitBits {
                target: expr_nodes.alloc_item(target),
                num_bits: num_bits,
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:EMIT> "(" <event_data: Expression> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::Emit {
                event_data: expr_nodes.alloc_item(event_data),
                location: Location::new(file_id, l, r)
            }
        )
    },
    <l:@L> <variable:CHECK_SECP_SIGN> "(" <pub_key: Expression> "," <msg: Expression>  "," <sig: Expression> ")" <r:@R> => {
        ExprNode::Intrinsic(
            IntrinsicExprNode::Secp256k1Verify {
                pub_key: expr_nodes.alloc_item(pub_key),
                msg: expr_nodes.alloc_item(msg),
                sig: expr_nodes.alloc_item(sig),
                location: Location::new(file_id, l, r)
            }
        )
    }
}

ValueExpression: ExprNode<F> = {
    FeltExpression,
    BoolExpression,
    U32Expression,
    ArrayExpression,
    TupleExpression,
    NEW <StructExpression>
}

FeltExpression: ExprNode<F> = {
    <l:@L> <n:U64> <r:@R> => ExprNode::<F>::Value(ValueNode::Felt(ctx.op_const(n), Location::new(file_id, l, r))),
}

BoolExpression: ExprNode<F> = {
    <l:@L> <b:BOOL> <r:@R> => ExprNode::<F>::Value(ValueNode::Bool(if b { ctx.op_true() } else { ctx.op_false() }, Location::new(file_id, l, r)))
}

U32Expression: ExprNode<F> = {
    <l:@L> <n:U32> <r:@R> => {
        ExprNode::<F>::Value(ValueNode::U32(ctx.op_const_u32(n), Location::new(file_id, l, r)))
    },
}

StructExpression: ExprNode<F> = {
   <l:@L> <name:PathTy> "{" <kv:Comma<KeyValue>> "}" <r:@R> => {
        let name = ExprNode::Path(PathNode::from_target_ty(name));
        ExprNode::<F>::Value(
            ValueNode::Struct(
                expr_nodes.alloc_item(name),
                vec![],
                kv.into_iter().collect(),
                Location::new(file_id, l, r),
            )
        )
    }
}

KeyValue: (Identifier, ExprId) = {
    <l:@L> <name:Identifier> ":" <value:Expression> <r:@R> => (name, expr_nodes.alloc_item(value)),
    <l:@L> <name:Identifier> <r:@R> => (name, expr_nodes.alloc_item(ExprNode::Path(PathNode::from_target(UncheckedType::Basic(name)))))
}

LambdaFunctionExpression: ExprNode<F> = {
    <l:@L> "||" <return_type:FunctionReturn?> <block_expr:BlockExpression> <r:@R> => ExprNode::<F>::LambdaFunction(
        LambdaFunctionNode {
            parameters: vec![],
            body: expr_nodes.alloc_item(block_expr),
            return_type,
            location: Location::new(file_id, l, r),
        }
    ),
    <l:@L> "|" <parameters:Comma<FunctionParameter>> "|" <return_type:FunctionReturn?> <block_expr:BlockExpression> <r:@R> => ExprNode::<F>::LambdaFunction(
        LambdaFunctionNode {
            parameters,
            body: expr_nodes.alloc_item(block_expr),
            return_type,
            location: Location::new(file_id, l, r),
        }
    )
}

PathExpression: ExprNode<F> = {
    <l:@L> <segments: (<BasicIdentOrGenericTy> "::")*> <target: BasicIdentTy> <r:@R> => {
        let segs = segments.into_iter().map(|seg| seg).collect::<Vec<_>>();
        let root = if segs.is_empty() {
            None
        } else {
            Some(segs.first().unwrap().clone())
        };
        let segments = segs.into_iter().skip(1).collect::<Vec<_>>();
        ExprNode::Path(PathNode {
            root,
            segments,
            target,
            is_ty: false,
            location: Location::new(file_id, l, r),
        })
    },
    <l:@L> <segments: (<BasicIdentOrGenericTy> "::")+> <target: NEW> <r:@R> => {
        let segs = segments.into_iter().map(|seg| seg).collect::<Vec<_>>();
        let root = if segs.is_empty() {
            None
        } else {
            Some(segs.first().unwrap().clone())
        };
        let segments = segs.into_iter().skip(1).collect::<Vec<_>>();
        ExprNode::Path(PathNode {
            root,
            segments,
            target: UncheckedType::Basic(Identifier::new(IdentId::NEW, Location::new(file_id, l, r))),
            is_ty: false,
            location: Location::new(file_id, l, r),
        })
    },
}

PathTy: UncheckedType = {
    <l:@L> <segments: (<BasicIdentTy> "::")*> <target:Ty> <r:@R> => {
        let segs = segments.into_iter().map(|seg| seg).collect::<Vec<_>>();
        if segs.is_empty() {
            target
        } else {
            UncheckedType::Path(Box::new(PathNode {
                root: Some(segs.first().unwrap().clone()),
                segments: segs.into_iter().skip(1).collect::<Vec<_>>(),
                target,
                is_ty: true,
                location: Location::new(file_id, l, r),
            }))
        }
    },
}

ArgumentList: Vec<ExprNode<F>> = {
    <items:Sep<Expression, ",">> => items
}

ArrayExpression: ExprNode<F> = {
    <l:@L> "[" <elements:Comma<Expression>> "]" <r:@R> => ExprNode::<F>::Value(
        ValueNode::Array(u32::try_from(elements.len()).unwrap(), expr_nodes.alloc_items(elements), Location::new(file_id, l, r)),
    ),
    <l:@L> "[" <element:Expression> ";" <n:U64> "]" <r:@R> => ExprNode::<F>::Value({
        let size = u32::try_from(n).unwrap();
        let mut elements = Vec::with_capacity(size as usize);
        for _ in 0..size {
            elements.push(expr_nodes.alloc_item(element.clone()));
        }
        ValueNode::Array(size, elements, Location::new(file_id, l, r))
    }),
}

UseNode: (Identifier, Vec<Identifier>, Option<Identifier>) =
    <a:ModuleUseKind> "::" <h:(<Identifier> "::")*> <t:IdentifierOrAll> => {
        (a, h, t)
    };

Monomorphization: Vec<UncheckedType> = {
    <l:@L> "#" "<" <generic_parameters:Comma<MonomorphizationTy>> ">" <r:@R> => generic_parameters,
    () => vec![]
}

MonomorphizationTy: UncheckedType = {
    ConstValue,
    PathTy
}

ConstValue: UncheckedType = {
    <l:@L> <n:U64> <r:@R> => UncheckedType::Const(ConstValue::Felt(n), Location::new(file_id, l, r)),
    <l:@L> <n:BOOL> <r:@R> => UncheckedType::Const(ConstValue::Bool(n), Location::new(file_id, l, r)),
    <l:@L> <n:U32> <r:@R> => UncheckedType::Const(ConstValue::U32(n), Location::new(file_id, l, r)),
}

Ty: UncheckedType = {
    BasicType,
    ArrayType,
    TupleType,
    GenericType,
    FunctionSignature
}

GenericType: UncheckedType = {
    <l:@L> <name:Identifier> "<" <generic_parameters:Comma<MonomorphizationTy>> ">" <r:@R> => UncheckedType::Generic(name, generic_parameters, Location::new(file_id, l, r)),
    <l:@L>  "[" <ty:PathTy> ";" <n:Identifier> "]" <r:@R> => UncheckedType::Generic(
        Identifier::new(IdentId::TYPE_ARRAY, Location::new(file_id, l, r)),
        vec![ty, UncheckedType::Basic(n)],
        Location::new(file_id, l, r)
    )
}

ArrayType: UncheckedType = {
    <l:@L> "[" <ty:PathTy> ";" <n:U64> "]" <r:@R> => UncheckedType::Array(Box::new(ty), u32::try_from(n).unwrap(), Location::new(file_id, l, r))
}

ConstType: UncheckedType = {
    <l:@L> <ty:TYPE_FELT>  <r:@R> => UncheckedType::Basic(Identifier::new(IdentId::TYPE_FELT, Location::new(file_id, l, r))),
    <l:@L> <ty:TYPE_BOOL>  <r:@R> => UncheckedType::Basic(Identifier::new(IdentId::TYPE_BOOL, Location::new(file_id, l, r))),
    <l:@L> <ty:TYPE_U32>   <r:@R> => UncheckedType::Basic(Identifier::new(IdentId::TYPE_U32, Location::new(file_id, l, r))),
}

BasicType: UncheckedType = {
    ConstType,
    <l:@L> <ty:TYPE_SELF>  <r:@R> => UncheckedType::Basic(Identifier::new(IdentId::TYPE_SELF, Location::new(file_id, l, r))),
    <l:@L> <ty:Identifier> <r:@R> => UncheckedType::Basic(ty)
}

ModuleUseKind: Identifier = {
    <l:@L> SELF            <r:@R> => Identifier::new(IdentId::SELF, Location::new(file_id, l, r)),
    <l:@L> SUPER           <r:@R> => Identifier::new(IdentId::SUPER, Location::new(file_id, l, r)),
    <l:@L> CRATE           <r:@R> => Identifier::new(IdentId::CRATE, Location::new(file_id, l, r)),
    <l:@L>  <k:Identifier> <r:@R> => k
}

IdentifierOrAll: Option<Identifier> = {
    Identifier => Some(<>),
    <l:@L> "*" <r:@R> => None
}

IdentifierOrSelf: Identifier = {
    Identifier,
    <l:@L> <name:SELF> <r:@R> => Identifier::new(IdentId::SELF, Location::new(file_id, l, r)),
}

IdentifierOrNew: Identifier = {
    Identifier,
    <l:@L> <name:NEW> <r:@R> => Identifier::new(IdentId::NEW, Location::new(file_id, l, r))
}

BasicIdentTy: UncheckedType = {
    BasicType,
    <l:@L> <ty:SELF> <r:@R> => UncheckedType::Basic(Identifier::new(IdentId::SELF, Location::new(file_id, l, r)))
}

BasicIdentOrGenericTy: UncheckedType = {
    BasicIdentTy,
    <l:@L> "<" <ty:GenericType> ">" <r:@R> => ty,
    <l:@L> "<" <ty:ArrayType> ">" <r:@R> => ty,
    <l:@L> "<" <ty:PathTy> AS <trait_ty:PathTy> ">" <r:@R> => UncheckedType::TraitCast(Box::new(ty), Box::new(trait_ty), Location::new(file_id, l, r)),
}

Identifier: Identifier = {
    <l:@L> <name:IDENT> <r:@R> => Identifier::new(interner.intern_ident(name), Location::new(file_id, l, r))
}

Sep<E,S>: Vec<E> =
    <v0:(<E> S)*> <e1:E?> =>
        v0.into_iter().chain(e1).collect();

DoubleColon<E>: Vec<E> = Sep<E, "::">;
Dot<E>: Vec<E> = Sep<E, ".">;
Comma<E>: Vec<E> = Sep<E, ",">;
Plus<E>: Vec<E> = Sep<E, "+">;

extern {
    type Location = Loc;
    type Error = UserError;

    enum Token<'input> {
        CONST => Token::KeywordConst,
        LET => Token::KeywordLet,

        MUT => Token::KeywordMut,

        FN => Token::KeywordFn,
        STRUCT => Token::KeywordStruct,
        ENUM => Token::KeywordEnum,
        IMPL => Token::KeywordImpl,
        TRAIT => Token::KeywordTrait,
        RETURN => Token::KeywordReturn,
        MATCH => Token::KeywordMatch,
        IF => Token::KeywordIf,
        ELSE => Token::KeywordElse,
        WHILE => Token::KeywordWhile,
        FOR => Token::KeywordFor,
        IN => Token::KeywordIn,
        WHERE => Token::KeywordWhere,

        ASSERT => Token::IntrinsicAssert,
        ASSERT_EQ => Token::IntrinsicAssertEq,
        Hash => Token::IntrinsicHash,
        Keccak256 => Token::IntrinsicKeccak256,
        HashTwoToOne => Token::IntrinsicHashTwoToOne,
        MEM_TRANSMUTE => Token::IntrinsicMemTransmute,
        MEM_SIZE_OF => Token::IntrinsicMemSizeOf,
        STORAGE_READ => Token::IntrinsicStorageRead,
        STORAGE_WRITE => Token::IntrinsicStorageWrite,
        STORAGE_READ_RANGE => Token::IntrinsicStorageReadRange,
        STORAGE_WRITE_RANGE => Token::IntrinsicStorageWriteRange,
        CTX_GET_USER_ID => Token::IntrinsicCtxGetUserId,
        CTX_GET_CONTRACT_ID => Token::IntrinsicCtxGetContractId,
        CTX_GET_CONTRACT_DEPLOYER => Token::IntrinsicCtxGetContractDeployer,
        CTX_GET_CALLER_CONTRACT_ID => Token::IntrinsicCtxGetCallerContractId,
        CTX_GET_CHECKPOINT_ID => Token::IntrinsicCtxGetCheckpointId,
        CTX_GET_CHECKPOINT_STATS => Token::IntrinsicCtxGetCheckpointStats,
        CTX_GET_REGISTER_USERS_ROOT => Token::IntrinsicCtxGetRegisterUsersRoot,
        CTX_GET_GUTAS_ROOT => Token::IntrinsicCtxGetGutasRoot,
        CTX_GET_CHECKPOINT_USER_TREE_ROOT => Token::IntrinsicCtxGetCheckpointUserTreeRoot,
        CTX_GET_CHECKPOINT_CONTRACT_TREE_ROOT => Token::IntrinsicCtxGetCheckpointContractTreeRoot,
        CTX_GET_CHECKPOINT_DEPOSIT_TREE_ROOT => Token::IntrinsicCtxGetCheckpointDepositTreeRoot,
        CTX_GET_CHECKPOINT_WITHDRAWAL_TREE_ROOT => Token::IntrinsicCtxGetCheckpointWithdrawalTreeRoot,
        CTX_GET_CHECKPOINT_USER_REGISTRATION_TREE_ROOT => Token::IntrinsicCtxGetCheckpointUserRegistrationTreeRoot,
        CTX_GET_DEPLOY_CONTRACTS_ROOT => Token::IntrinsicCtxGetDeployContractsRoot,
        CTX_GET_GUTA_FEES_COLLECTED => Token::IntrinsicCtxGetGutaFeesCollected,
        CTX_GET_DA_FEES_COLLECTED => Token::IntrinsicCtxGetDAFeesCollected,
        CTX_GET_USER_OPS_PROCESSED => Token::IntrinsicCtxGetUserOpsProcessed,
        CTX_GET_TOTAL_TRANSACTIONS => Token::IntrinsicCtxGetTotalTransactions,
        CTX_GET_SLOTS_MODIFIED => Token::IntrinsicCtxGetSlotsModified,
        CTX_GET_DEPLOY_CONTRACTS_COMPLETED => Token::IntrinsicCtxGetDeployContractsCompleted,
        CTX_GET_REGISTER_USERS_COMPLETED => Token::IntrinsicCtxGetRegisterUsersCompleted,
        CTX_GET_GUTAS_COMPLETED => Token::IntrinsicCtxGetGutasCompleted,
        CTX_CLEAR_ENTIRE_TREE => Token::IntrinsicCtxClearEntireTree,
        CTX_GET_LAST_NONCE => Token::IntrinsicCtxGetLastNonce,
        CTX_GET_USER_PUBLIC_KEY_HASH => Token::IntrinsicCtxGetUserPublicKeyHash,
        CTX_GET_SESSION_PROOF_TREE_ROOT => Token::IntrinsicCtxGetSessionProofTreeRoot,
        CTX_GET_STATE_HASH_AT => Token::IntrinsicCtxGetStateHashAt,
        CTX_GET_OTHER_CONTRACT_STATE_HASH_AT => Token::IntrinsicCtxGetOtherContractStateHashAt,
        CTX_GET_OTHER_USER_CONTRACT_STATE_HASH_AT => Token::IntrinsicCtxGetOtherUserContractStateHashAt,
        CTX_SET_STATE_HASH_AT => Token::IntrinsicCtxSetStateHashAt,
        IMT_GET => Token::IntrinsicImtGet,
        IMT_GET_OTHER_USER => Token::IntrinsicImtGetOtherUser,
        IMT_CONTAINS_OTHER_USER => Token::IntrinsicImtContainsOtherUser,
        IMT_SET => Token::IntrinsicImtSet,
        IMT_CONTAINS => Token::IntrinsicImtContains,

        INVOKE_SYNC => Token::IntrinsicInvokeSync,
        INVOKE_DEFERRED => Token::IntrinsicInvokeDeferred,

        CHECK_SECP_SIGN => Token::IntrinsicSecp256k1Verify,

        SUM_BITS => Token::IntrinsicSumBits,
        SPLIT_BITS => Token::IntrinsicSplitBits,

        EMIT => Token::IntrinsicEmit,

        MOD => Token::KeywordMod,
        USE => Token::KeywordUse,
        SUPER => Token::KeywordSuper,
        CRATE => Token::KeywordCrate,
        SELF => Token::KeywordSelf,

        PUB => Token::KeywordPub,

        IDENT => Token::Ident(<&'input str>),

        BOOL => Token::Bool(<bool>),
        U64 => Token::U64(<u64>),
        U32 => Token::U32(<u32>),
        STRING => Token::String(<&'input str>),

        TYPE_BOOL => Token::TypeBool,
        TYPE_FELT => Token::TypeFelt,
        TYPE_U32 => Token::TypeU32,
        TYPE_ARRAY => Token::TypeArray,
        TYPE_SELF => Token::TypeSelf,

        AS => Token::KeywordAs,
        TYPE => Token::KeywordType,

        EXTERN => Token::KeywordExtern,
        NEW => Token::KeywordNew,

        "#" => Token::Pound,
        "_" => Token::Placeholder,

        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "[" => Token::LBracket,
        "]" => Token::RBracket,

        "=" => Token::Assign,
        ";" => Token::Semicolon,
        "," => Token::Comma,
        "." => Token::Dot,
        ".." => Token::DoubleDot,
        ":" => Token::Colon,
        "::" => Token::DoubleColon,
        "->" => Token::Arrow,
        "=>" => Token::FatArrow,

        "+" => Token::OperatorAdd,
        "-" => Token::OperatorSub,
        "*" => Token::OperatorMul,
        "/" => Token::OperatorDiv,
        "**" => Token::OperatorPow,
        "%" => Token::OperatorMod,

        "==" => Token::OperatorEq,
        "!=" => Token::OperatorNeq,
        "<" => Token::OperatorLt,
        "<=" => Token::OperatorLte,
        ">" => Token::OperatorGt,
        ">=" => Token::OperatorGte,
        "&&" => Token::OperatorAnd,
        "||" => Token::OperatorOr,

        "&" => Token::OperatorBitAnd,
        "|" => Token::OperatorBitOr,
        "^" => Token::OperatorBitXor,

        "<<" => Token::OperatorShl,
        ">>" => Token::OperatorShr,

        "!" => Token::OperatorNot,

        "+=" => Token::OperatorAddAssign,
        "-=" => Token::OperatorSubAssign,
        "*=" => Token::OperatorMulAssign,
        "/=" => Token::OperatorDivAssign,
        "%=" => Token::OperatorModAssign,

        "|=" => Token::OperatorBitOrAssign,
        "&=" => Token::OperatorBitAndAssign,
        "^=" => Token::OperatorBitXorAssign,

        "<<=" => Token::OperatorBitShlAssign,
        ">>=" => Token::OperatorBitShrAssign,

        LineComment => Token::LineComment(<&'input str>),
        BlockComment => Token::BlockComment(<&'input str>),
    }
}
