#[contract]
#[derive(Storage)]
struct TestContract {
    pub data: [Felt; 10],
    pub single_value: Felt,
}

fn main() {
    let contract = TestContractRef::new(ContractMetadata::current());
    contract.single_value = 42;
    // Verify it was set
    assert_eq(contract.single_value, 42, "Value should be 42 before clear");
    clear_entire_tree();
    // After clearing, value should be reset to 0
    assert_eq(contract.single_value, 0, "Value should be 0 after clear");
    contract.single_value = 100;
    assert_eq(contract.single_value, 100, "Should be able to set new value after clear");
}