mod math {
    pub fn max(a: Felt, b: Felt) -> Felt {
        return a * ((a > b) as Felt) + b * ((a <= b) as Felt);
    }
    
    pub fn min(a: Felt, b: Felt) -> Felt {
        return a * ((a < b) as Felt) + b * ((a >= b) as Felt);
    }
}

use math::*;

trait PersonLike {
    pub fn age(self: Self) -> Felt;
}

struct Person {
    pub age_height: ([Felt; 2], [Felt; 2]),
    pub year_of_birth: Felt,
}

impl PersonLike for Person {
    pub fn age(self: Person) -> Felt {
        return self.age_height.0[0];
    }
}

struct Family {
    father: Person,
    mother: Person,
    pub children: [Person; 2],
}

impl Person {
    pub fn set_age(mut self: Person, new_age: Felt) {
        self.age_height.0[0] = new_age;
    }
    pub fn get_age(self: Person) -> Felt {
        return self.age_height.0[0];
    }
    pub fn set_height(mut self: Person, new_height: Felt) {
        self.age_height.0[1] = new_height;
    }
    pub fn get_height(self: Person) -> Felt {
        return self.age_height.0[1];
    }
    pub fn get_year_of_birth(self: Person) -> Felt {
        return self.year_of_birth;
    }
    pub fn set_year_of_birth(mut self: Person, new_year_of_birth: Felt) {
        self.year_of_birth = new_year_of_birth;
    }
}

struct ContractStorage {
    a: Felt,
    b: [Felt; 2],
    c: Person,
}

