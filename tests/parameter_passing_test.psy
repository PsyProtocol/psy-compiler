fn modify_primitive(mut a: Felt) -> Felt {
    a += 2;
    return a;
}

struct Person {
    pub age: Felt,
}

fn modify_struct(mut p: Person) {
    p.age += 2;
}

// input: 2,3
// output: 4
fn main(a: Felt, b: Felt) -> Felt {
    modify_primitive(a);
    let mut arr: [Felt; 2] = [a, b];
    arr[0] += 2;
    let mut p1: Person = new Person {
        age: a,
    };
    // 2
    let p2: Person = new Person {
        age: arr[0],
    };
    // 4
    p1 = p2;
    modify_struct(p1);
    // 4
    return p2.age;
}