    #[test]
    fn deposit_tree_depth32_roots_of_fixture1_and_fixture2_differ() {
        let mut root1 = keccak256(fixture_leaf_preimage_words());
        let mut root2 = keccak256(fixture2_leaf_preimage_words());
        let zero: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        for _i in 0u32..32u32 {
            root1 = keccak_two_to_one(root1, zero);
            root2 = keccak_two_to_one(root2, zero);
        }
        assert(arrays_differ(root1, root2), "different fixtures should produce different depth32 roots");
    }
