        [459914484u32, 1257906937u32, 264842108u32, 853564230u32, 2853216926u32, 3408539137u32, 2126361965u32, 2934277314u32]
    }
    
    fn expected_root_depth_32_fixture2_reverse_direction() -> [u32; 8] {
        // ethers:
        // 0x2d5683d1e8c3e50ee61edabfac213910127d3ba82af1ea3bda7dac7e6e985b7c
        [760644561u32, 3905152270u32, 3860781759u32, 2887858448u32, 310197160u32, 720497211u32, 3665669246u32, 1855478652u32]
    }
    
    fn expected_zero_leaf_root_depth_32_index_0() -> [u32; 8] {
        // ethers:
        // 0xb5821213328ffb298188db9e2712b54eaa79d01322a37e8f43514477f769cd62
        [3045200403u32, 848296745u32, 2173229982u32, 655537486u32, 2860109843u32, 581140111u32, 1129399415u32, 4150906210u32]
    }
    
    fn arrays_differ(a: [u32; 8], b: [u32; 8]) -> bool {
        a[0] != b[0] || a[1] != b[1] || a[2] != b[2] || a[3] != b[3] || a[4] != b[4] || a[5] != b[5] || a[6] != b[6] || a[7] != b[7]
    }
    
    fn keccak_two_to_one(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
        let data: [u32; 16] = [left[0], left[1], left[2], left[3], left[4], left[5], left[6], left[7], right[0], right[1], right[2], right[3], right[4], right[5], right[6], right[7]];
        keccak256(data)
    }
    
    #[test]
    fn keccak_preimage_to_leaf_matches_cast() {
        // Bridge.sol _recordDepositLeaf abi.encodePacked fields (144 bytes total):
        // depositor[32] || l2Recipient[32] || token[32] || l2TokenContractId[32] || amount(uint64)[8] || chainIndex(uint32)[4] || nonce(uint32)[4]
        let preimage_words: [u32; 36] = fixture_leaf_preimage_words();
        let expected = expected_leaf();
        let got: [u32; 8] = keccak256(preimage_words);
        assert_eq(got[0], expected[0], "bridge leaf preimage keccak mismatch limb0");
        assert_eq(got[1], expected[1], "bridge leaf preimage keccak mismatch limb1");
        assert_eq(got[2], expected[2], "bridge leaf preimage keccak mismatch limb2");
        assert_eq(got[3], expected[3], "bridge leaf preimage keccak mismatch limb3");
        assert_eq(got[4], expected[4], "bridge leaf preimage keccak mismatch limb4");
        assert_eq(got[5], expected[5], "bridge leaf preimage keccak mismatch limb5");
        assert_eq(got[6], expected[6], "bridge leaf preimage keccak mismatch limb6");
        assert_eq(got[7], expected[7], "bridge leaf preimage keccak mismatch limb7");
    }
    
    #[test]
    fn keccak_two_to_one_directionality() {
        let leaf = expected_leaf();
        let zero: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        let left_right = keccak_two_to_one(leaf, zero);
        let right_left = keccak_two_to_one(zero, leaf);
        // Deposit tree append uses current as left, sibling as right.
        // This asserts the combine order is not accidentally swapped.
        let differs = arrays_differ(left_right, right_left);
        assert(differs, "keccak two-to-one order should matter");
    }
    
    #[test]
    fn keccak_preimage_amount_sensitivity() {
        let mut words = fixture_leaf_preimage_words();
        let base = keccak256(words);
        // amount low limb is index 33 in the 36-word preimage.
        words[33] = words[33] + 1u32;
        let changed = keccak256(words);
        assert(arrays_differ(base, changed), "leaf hash should change when amount changes");
    }
    
    #[test]
    fn keccak_preimage_amount_high_limb_sensitivity() {
        let mut words = fixture_leaf_preimage_words();
        // amount high limb is index 32 in the 36-word preimage.
        words[32] = words[32] + 1u32;
        let got = keccak256(words);
        let expected = expected_leaf_amount_hi_1();
        assert_eq(got[0], expected[0], "amount_hi=1 mismatch limb0");
        assert_eq(got[1], expected[1], "amount_hi=1 mismatch limb1");
        assert_eq(got[2], expected[2], "amount_hi=1 mismatch limb2");
        assert_eq(got[3], expected[3], "amount_hi=1 mismatch limb3");
        assert_eq(got[4], expected[4], "amount_hi=1 mismatch limb4");
        assert_eq(got[5], expected[5], "amount_hi=1 mismatch limb5");
        assert_eq(got[6], expected[6], "amount_hi=1 mismatch limb6");
        assert_eq(got[7], expected[7], "amount_hi=1 mismatch limb7");
    }
    
    #[test]
    fn keccak_preimage_nonce_sensitivity() {
        let mut words = fixture_leaf_preimage_words();
        // nonce is index 35 in the 36-word preimage.
        words[35] = words[35] + 1u32;
        let got = keccak256(words);
