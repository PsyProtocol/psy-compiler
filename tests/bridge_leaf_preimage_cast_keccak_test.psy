    #[test]
    fn keccak_preimage_l2_token_id_sensitivity() {
        let mut words = fixture_leaf_preimage_words();
        // l2_token_contract_id occupies indices [24..31].
        words[31] = 1u32;
        let got = keccak256(words);
        let expected = expected_leaf_l2_token_id_last_1();
        assert_eq(got[0], expected[0], "l2_token_id_last=1 mismatch limb0");
        assert_eq(got[1], expected[1], "l2_token_id_last=1 mismatch limb1");
        assert_eq(got[2], expected[2], "l2_token_id_last=1 mismatch limb2");
        assert_eq(got[3], expected[3], "l2_token_id_last=1 mismatch limb3");
        assert_eq(got[4], expected[4], "l2_token_id_last=1 mismatch limb4");
