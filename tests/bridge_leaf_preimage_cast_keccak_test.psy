    }
    
    #[test]
    fn keccak_preimage_field_order_sensitivity_chain_vs_nonce() {
        let mut words = fixture_leaf_preimage_words();
        // Swap chain_index (34) and nonce (35): same values, different order -> different preimage.
        let tmp = words[34];
        words[34] = words[35];
        words[35] = tmp;
        let got = keccak256(words);
        let expected = expected_leaf_swap_chain_nonce();
        assert_eq(got[0], expected[0], "swap(chain,nonce) mismatch limb0");
        assert_eq(got[1], expected[1], "swap(chain,nonce) mismatch limb1");
        assert_eq(got[2], expected[2], "swap(chain,nonce) mismatch limb2");
        assert_eq(got[3], expected[3], "swap(chain,nonce) mismatch limb3");
        assert_eq(got[4], expected[4], "swap(chain,nonce) mismatch limb4");
        assert_eq(got[5], expected[5], "swap(chain,nonce) mismatch limb5");
        assert_eq(got[6], expected[6], "swap(chain,nonce) mismatch limb6");
        assert_eq(got[7], expected[7], "swap(chain,nonce) mismatch limb7");
    }
    
    #[test]
    fn keccak_preimage_amount_hi_lo_swap_matches_ethers() {
        let mut words = fixture_leaf_preimage_words();
        // Swap uint64 amount limbs: [hi, lo] -> [lo, hi]
        let tmp = words[32];
        words[32] = words[33];
        words[33] = tmp;
        let got = keccak256(words);
        let expected = expected_leaf_amount_hi_lo_swapped();
        assert_eq(got[0], expected[0], "swap(amount_hi,amount_lo) mismatch limb0");
        assert_eq(got[1], expected[1], "swap(amount_hi,amount_lo) mismatch limb1");
        assert_eq(got[2], expected[2], "swap(amount_hi,amount_lo) mismatch limb2");
        assert_eq(got[3], expected[3], "swap(amount_hi,amount_lo) mismatch limb3");
        assert_eq(got[4], expected[4], "swap(amount_hi,amount_lo) mismatch limb4");
        assert_eq(got[5], expected[5], "swap(amount_hi,amount_lo) mismatch limb5");
        assert_eq(got[6], expected[6], "swap(amount_hi,amount_lo) mismatch limb6");
        assert_eq(got[7], expected[7], "swap(amount_hi,amount_lo) mismatch limb7");
    }
    
    #[test]
    fn keccak_preimage_l2_token_id_wrong_limb_index0_matches_ethers() {
        let mut words = fixture_leaf_preimage_words();
        // Wrong placement example: put 1 in the first limb (index 24) instead of last (index 31).
        words[24] = 1u32;
        let got = keccak256(words);
        let expected = expected_leaf_l2_token_id_index0_set();
        assert_eq(got[0], expected[0], "l2_token_id@index0 mismatch limb0");
        assert_eq(got[1], expected[1], "l2_token_id@index0 mismatch limb1");
        assert_eq(got[2], expected[2], "l2_token_id@index0 mismatch limb2");
        assert_eq(got[3], expected[3], "l2_token_id@index0 mismatch limb3");
        assert_eq(got[4], expected[4], "l2_token_id@index0 mismatch limb4");
        assert_eq(got[5], expected[5], "l2_token_id@index0 mismatch limb5");
        assert_eq(got[6], expected[6], "l2_token_id@index0 mismatch limb6");
        assert_eq(got[7], expected[7], "l2_token_id@index0 mismatch limb7");
    }
    
    #[test]
    fn deposit_tree_depth32_direction_sensitivity() {
        let mut root_lr = expected_leaf();
        let mut root_rl = expected_leaf();
        let zero: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        for _i in 0u32..32u32 {
            root_lr = keccak_two_to_one(root_lr, zero);
            root_rl = keccak_two_to_one(zero, root_rl);
        }
        assert(arrays_differ(root_lr, root_rl), "depth32 root should depend on left/right combine order");
    }
    
    #[test]
    fn deposit_tree_depth32_reverse_direction_matches_ethers() {
        let mut current = expected_leaf();
        let zero: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        for _i in 0u32..32u32 {
            current = keccak_two_to_one(zero, current);
        }
        let expected = expected_root_depth_32_index_0_reverse_direction();
        assert_eq(current[0], expected[0], "reverse root mismatch limb0");
        assert_eq(current[1], expected[1], "reverse root mismatch limb1");
        assert_eq(current[2], expected[2], "reverse root mismatch limb2");
        assert_eq(current[3], expected[3], "reverse root mismatch limb3");
        assert_eq(current[4], expected[4], "reverse root mismatch limb4");
        assert_eq(current[5], expected[5], "reverse root mismatch limb5");
        assert_eq(current[6], expected[6], "reverse root mismatch limb6");
        assert_eq(current[7], expected[7], "reverse root mismatch limb7");
    }
    
    #[test]
    fn deposit_tree_level1_parent_matches_cast() {
        let leaf = expected_leaf();
        let zero: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        let got = keccak_two_to_one(leaf, zero);
        let expected = expected_parent_level_1();
        assert_eq(got[0], expected[0], "level1 parent mismatch limb0");
        assert_eq(got[1], expected[1], "level1 parent mismatch limb1");
        assert_eq(got[2], expected[2], "level1 parent mismatch limb2");
        assert_eq(got[3], expected[3], "level1 parent mismatch limb3");
        assert_eq(got[4], expected[4], "level1 parent mismatch limb4");
        assert_eq(got[5], expected[5], "level1 parent mismatch limb5");
        assert_eq(got[6], expected[6], "level1 parent mismatch limb6");
        assert_eq(got[7], expected[7], "level1 parent mismatch limb7");
    }
    
    #[test]
    fn deposit_tree_level2_parent_matches_ethers() {
        let leaf = expected_leaf();
        let zero: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        let level1 = keccak_two_to_one(leaf, zero);
        let got = keccak_two_to_one(level1, zero);
        let expected = expected_parent_level_2();
        assert_eq(got[0], expected[0], "level2 parent mismatch limb0");
        assert_eq(got[1], expected[1], "level2 parent mismatch limb1");
        assert_eq(got[2], expected[2], "level2 parent mismatch limb2");
        assert_eq(got[3], expected[3], "level2 parent mismatch limb3");
        assert_eq(got[4], expected[4], "level2 parent mismatch limb4");
        assert_eq(got[5], expected[5], "level2 parent mismatch limb5");
        assert_eq(got[6], expected[6], "level2 parent mismatch limb6");
        assert_eq(got[7], expected[7], "level2 parent mismatch limb7");
    }
    
