        [1124205776u32, 1843615030u32, 2459737901u32, 2191103515u32, 4199051270u32, 1734641662u32, 3320947635u32, 1664178927u32]
    }
    
    fn expected_root_depth_31_fixture2() -> [u32; 8] {
