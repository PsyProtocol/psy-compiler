    fn fixture2_leaf_preimage_words() -> [u32; 36] {
        // depositor = bytes32(uint160(0x1111111111111111111111111111111111111111))
        let depositor: [u32; 8] = [0u32, 0u32, 0u32, 286331153u32, 286331153u32, 286331153u32, 286331153u32, 286331153u32];
        // l2 recipient = bytes32(0x42)
        let l2_recipient: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 66u32];
        // token = bytes32(uint160(0x2222222222222222222222222222222222222222))
        let token: [u32; 8] = [0u32, 0u32, 0u32, 572662306u32, 572662306u32, 572662306u32, 572662306u32, 572662306u32];
        // l2 token id = bytes32(7)
        let l2_token_contract_id: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 7u32];
        // amount = uint64((2 << 32) + 123456789) => [2, 123456789]
        let amount_u64_as_u32x2: [u32; 2] = [2u32, 123456789u32];
        let chain_index_u32: u32 = 9u32;
        let nonce_u32: u32 = 12345u32;
        [depositor[0], depositor[1], depositor[2], depositor[3], depositor[4], depositor[5], depositor[6], depositor[7], l2_recipient[0], l2_recipient[1], l2_recipient[2], l2_recipient[3], l2_recipient[4], l2_recipient[5], l2_recipient[6], l2_recipient[7], token[0], token[1], token[2], token[3], token[4], token[5], token[6], token[7], l2_token_contract_id[0], l2_token_contract_id[1], l2_token_contract_id[2], l2_token_contract_id[3], l2_token_contract_id[4], l2_token_contract_id[5], l2_token_contract_id[6], l2_token_contract_id[7], amount_u64_as_u32x2[0], amount_u64_as_u32x2[1], chain_index_u32, nonce_u32]
    }
    
    fn expected_leaf_fixture2() -> [u32; 8] {
        // ethers:
        // 0x9ff3a3a9925369ef7a30a52c67b1b56aaefabe8592339f14c69980d1863f95f5
        [2683544489u32, 2454940143u32, 2050008364u32, 1739699562u32, 2935668357u32, 2452856596u32, 3331948753u32, 2252314101u32]
