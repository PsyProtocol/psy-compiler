pub mod traits {
    pub trait PersonLike {
        pub type Age;

        pub fn set_age(mut self: Self, age: <Self::Age>);
        pub fn get_age(self: Self) -> <Self::Age>;
    }
    
    pub struct Person {
        pub age_height: [[Felt; 2]; 2],
        pub year_of_birth: Felt,
    }
    
    // pub fn age(self: Person) -> Felt {
    //     return self.age_height[0][0];
    // }
    impl PersonLike for Person {
        pub type Age = Felt;
        pub fn set_age(mut self: Self, age: <Self::Age>) {
            self.age_height[0][0] = age;
        }
        pub fn get_age(self: Self) -> <Self::Age> {
            return self.age_height[0][0];
        }
    }
}

use traits::Person;

// error if not import trait
use traits::PersonLike;

pub fn test_fn(p: Person) -> Felt {
    use traits::PersonLike;

    return p.get_age();
}

// input:2,3
// output:4
fn main(a: Felt, b: Felt) -> Felt {
    let person: Person = new Person {
        year_of_birth: 1990,
        age_height: [[1, 1], [1, 1]],
    };
    use traits::Person;

    use traits::PersonLike;

    person.set_age(2);
    return person.get_age() + a;
}