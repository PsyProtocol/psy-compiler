#[derive(StorageRef, Storage)]
pub struct Person {
    pub age: Felt,
    pub score: Felt,
}

#[contract]
#[derive(StorageRef, Storage)]
pub struct C {
    pub people: [Person; 2],
}

fn main() {
    let c = CRef::new(ContractMetadata::current());
    c.people[0] = new Person {
        age: 10,
        score: 80,
    };
    c.people[1] = new Person {
        age: 20,
        score: 90,
    };
    let p1: Person::RefType = c.people[1];
    p1.age += 1;
    p1.score += 2;
    assert_eq(c.people[0].age, 10, "people[0].age");
    assert_eq(c.people[0].score, 80, "people[0].score");
    assert_eq(c.people[1].age, 21, "people[1].age after +=");
    assert_eq(c.people[1].score, 92, "people[1].score after +=");
    assert(p1 == new Person {
        age: 21,
        score: 92,
    }, "RefType from index should support ==");
    assert_eq(p1, new Person {
        age: 21,
        score: 92,
    }, "assert_eq should use Eq trait for indexed RefType");
}