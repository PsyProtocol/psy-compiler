use std::prelude::*;
use deposit_tree::PsyDepositTreeContractRef;

fn main() -> Felt {
    let chain_index: Felt = 1;
    let leaf_0: Hash = keccak256([11, 22, 33, 44]);
    let leaf_1: Hash = keccak256([55, 66, 77, 88]);

    let root_after_0 = PsyDepositTreeContractRef::append_deposit(chain_index, leaf_0);
    assert(root_after_0 != [0, 0, 0, 0], "global root should be non-zero after first append");

    let chain_next_index_1 = PsyDepositTreeContractRef::get_chain_next_index(chain_index);
    assert_eq(chain_next_index_1, 1, "chain next index should be 1");

    let root_after_1 = PsyDepositTreeContractRef::append_deposit(chain_index, leaf_1);
    assert(root_after_1 != root_after_0, "global root should change after second append");

    let chain_next_index_2 = PsyDepositTreeContractRef::get_chain_next_index(chain_index);
    assert_eq(chain_next_index_2, 2, "chain next index should be 2");

    let chain_root = PsyDepositTreeContractRef::get_chain_root(chain_index);
    assert(chain_root != [0, 0, 0, 0], "chain root should be non-zero");

    let global_root = PsyDepositTreeContractRef::get_root();
    assert_eq(global_root, root_after_1, "get_root should match latest returned root");

    chain_next_index_2
}
