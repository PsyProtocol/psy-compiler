// input:2,3
// output: 1
fn main(a: u32, b: u32) -> Felt {
    let k: u32 = (a + 2u32) * (2u32 * 2u32) * b - 3u32 * (a + b);
    let mut z: u32 = k + a;
    assert_eq(z, 35u32, "z == 35");
    z = z / a;
    assert_eq(z, 17u32, "z == 17");
    z = z ** a;
    assert_eq(z, 289u32, "z == 289");
    z = z % 2u32;
    assert_eq(z, 1u32, "z == 1");
    let bb: bool = z as bool;
    return bb as Felt;
}