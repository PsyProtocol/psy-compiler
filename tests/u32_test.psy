// input:2,3
// output: 1
fn main(a: u32, b: u32) -> Felt {
    let k: u32 = (a + 2u32) * (2u32 * 2u32) * b - 3u32 * (a + b);
    let mut z: u32 = k + a;
    assert_eq(z, 35u32, "z == 35");
    z = z / a;
    assert_eq(z, 17u32, "z == 17");
    z = z ** a;
    assert_eq(z, 289u32, "z == 289");
    z = z % 2u32;
    assert_eq(z, 1u32, "z == 1");
    // u32 %= must lower to the u32 mod op, not the felt one.
    let mut m: u32 = 7u32;
    m %= 3u32;
    assert_eq(m, 1u32, "constant operand m %= 3");
    let mut n: u32 = z + 6u32;
    n %= a;
    assert_eq(n, 1u32, "variable operand n %= a");
    let bb: bool = z as bool;
    return bb as Felt;
}