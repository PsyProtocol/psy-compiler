#[contract]
#[derive(Storage)]
pub struct C {
    pub a: Felt,
    pub arr: [Felt; 2],
}

fn main() {
    let c = CRef::new(ContractMetadata::current());
    let a0 = c.a;
    let a1 = c.a;
    a0 = 10;
    a1 += 5;
    assert_eq(c.a, 15, "same slot aliases should observe writes");
    let x0 = c.arr[0];
    let x1 = c.arr[0];
    x0 = 2;
    x1 *= 4;
    assert_eq(c.arr[0], 8, "array index aliases should observe writes");
    let y0 = c.arr[1];
    let y1 = c.arr[1];
    y0 = 9;
    y1 -= 3;
    assert_eq(c.arr[1], 6, "array index aliases should observe -= writes");
}