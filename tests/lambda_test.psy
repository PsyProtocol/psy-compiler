struct Person {
    pub age: Felt,
}

// input:
// output:
fn main() {
    let a = 1;
    let b = 2;
    let min = |mut c: Felt| -> Felt {
        c = c + 1;
        return a * ((a < b) as Felt) + b * ((a >= b) as Felt);
    };
    assert(min(5) == 1, "min(1, 2) == 1");
    let mut p = new Person {
        age: 10,
    };
    let incr_age = || -> Felt {
        p.age = p.age + 1;
        return p.age;
    };
    incr_age();
    assert(p.age == 11, "lambda function should be able to modify outer struct");
}