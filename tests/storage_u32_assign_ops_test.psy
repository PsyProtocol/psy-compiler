#[contract]
#[derive(StorageRef, Storage)]
pub struct C {
    pub x: Felt,
    pub arr: [Felt; 3],
}

fn main() {
    let c = CRef::new(ContractMetadata::current());
    c.x = 20;
    c.x += 3;
    c.x -= 1;
    c.x *= 2;
    c.x /= 11;
    c.x %= 4;
    c.x |= 8;
    c.x &= 10;
    c.x ^= 3;
    c.x <<= 1;
    c.x >>= 1;
    assert_eq(c.x, 11, "felt assign ops on storage ref");
    let mut refs = [c.arr.index(0), c.arr.index(1), c.arr.index(2)];
    refs = [5, 6, 7];
    assert_eq(c.arr.index(0), 5, "arr[0] after eq_assign array");
    assert_eq(c.arr.index(1), 6, "arr[1] after eq_assign array");
    assert_eq(c.arr.index(2), 7, "arr[2] after eq_assign array");
}