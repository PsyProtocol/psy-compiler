use std::prelude::*;

fn main() -> [u32; 8] {
    let mut h: [u32; 8] = [1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32];
    for i in 0u32..40u32 {
        let data: [u32; 16] = [
            h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7],
            i, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32
        ];
        h = keccak256(data);
    }
    h
}
