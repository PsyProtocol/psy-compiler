struct TestSibling {
    pub value: [Felt; 4],
}

#[test]
fn test_for_empty_range() {
    let mut sum: u32 = 0u32;
    for i in 5u32..3u32 {
        sum += i;
    }
    assert_eq(sum, 0u32, "empty range should execute zero iterations");
}

#[test]
fn test_for_if_simple() {
    let mut test_array: [TestSibling; 3] = [TestSibling {
            value: [1, 2, 3, 4],
        }, TestSibling {
            value: [0, 0, 0, 0],
        }, TestSibling {
            value: [0, 0, 0, 0],
        }];
    for i in 0u32..3u32 {
        let level_index = i as Felt;
        let sibling = test_array[level_index];
        let value = sibling.value;
        if level_index < 1 {
            assert_eq(value[0], 1, "should be 1");
            assert_eq(value[1], 2, "should be 2");
            assert_eq(value[2], 3, "should be 3");
            assert_eq(value[3], 4, "should be 4");
        }        
        else {
            assert_eq(value[0], 0, "should be 0");
            assert_eq(value[1], 0, "should be 0");
            assert_eq(value[2], 0, "should be 0");
            assert_eq(value[3], 0, "should be 0");
        };
    }
}