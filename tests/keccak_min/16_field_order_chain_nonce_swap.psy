#[test]
fn bridge_leaf_chain_nonce_swap_changes_hash() {
    let baseline: [u32; 36] = [
        0u32, 0u32, 0u32, 4087338725u32, 447580406u32, 4107168440u32, 2188540367u32, 4290323046u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32, 187722745u32, 365221445u32, 4284051025u32, 2410626966u32, 1773760534u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 1000000000u32, 0u32, 1775065240u32,
    ];
    let swapped: [u32; 36] = [
        0u32, 0u32, 0u32, 4087338725u32, 447580406u32, 4107168440u32, 2188540367u32, 4290323046u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32, 187722745u32, 365221445u32, 4284051025u32, 2410626966u32, 1773760534u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 1000000000u32, 1775065240u32, 0u32,
    ];

    let h0 = keccak256(baseline);
    let h1 = keccak256(swapped);
    let h1_want: [u32; 8] = [
        958394301u32, 116842504u32, 2877213476u32, 2269903549u32,
        3282822433u32, 2121412880u32, 886804885u32, 862730302u32,
    ];

    assert_eq(h1[0], h1_want[0], "swap limb0");
    assert_eq(h1[1], h1_want[1], "swap limb1");
    assert_eq(h1[2], h1_want[2], "swap limb2");
    assert_eq(h1[3], h1_want[3], "swap limb3");
    assert_eq(h1[4], h1_want[4], "swap limb4");
    assert_eq(h1[5], h1_want[5], "swap limb5");
    assert_eq(h1[6], h1_want[6], "swap limb6");
    assert_eq(h1[7], h1_want[7], "swap limb7");

    let same =
        h0[0] == h1[0] &&
        h0[1] == h1[1] &&
        h0[2] == h1[2] &&
        h0[3] == h1[3] &&
        h0[4] == h1[4] &&
        h0[5] == h1[5] &&
        h0[6] == h1[6] &&
        h0[7] == h1[7];
    assert(same == false, "swapping chain and nonce must change leaf hash");
}
