#[test]
fn bridge_leaf_width_variant_144_vs_148_differs() {
    // Current Bridge packing: amount u64 + chain u32 + nonce u32 => 36 words.
    let data_144: [u32; 36] = [
        0u32, 0u32, 0u32, 4087338725u32, 447580406u32, 4107168440u32, 2188540367u32, 4290323046u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32, 187722745u32, 365221445u32, 4284051025u32, 2410626966u32, 1773760534u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 1000000000u32, 0u32, 1775065240u32,
    ];
    let h144 = keccak256(data_144);

    // Legacy width variant: amount u64 + chain u64 + nonce u64 => 38 words.
    let data_148: [u32; 38] = [
        0u32, 0u32, 0u32, 4087338725u32, 447580406u32, 4107168440u32, 2188540367u32, 4290323046u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 0u32, 0u32, 187722745u32, 365221445u32, 4284051025u32, 2410626966u32, 1773760534u32,
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32,
        0u32, 1000000000u32, 0u32, 0u32, 0u32, 1775065240u32,
    ];
    let h148 = keccak256(data_148);

    let h148_want: [u32; 8] = [
        1357367136u32, 4092068414u32, 1155420925u32, 855530308u32,
        999945683u32, 4188425562u32, 967857178u32, 574458506u32,
    ];

    assert_eq(h148[0], h148_want[0], "h148 limb0");
    assert_eq(h148[1], h148_want[1], "h148 limb1");
    assert_eq(h148[2], h148_want[2], "h148 limb2");
    assert_eq(h148[3], h148_want[3], "h148 limb3");
    assert_eq(h148[4], h148_want[4], "h148 limb4");
    assert_eq(h148[5], h148_want[5], "h148 limb5");
    assert_eq(h148[6], h148_want[6], "h148 limb6");
    assert_eq(h148[7], h148_want[7], "h148 limb7");

    let equal =
        h144[0] == h148[0] &&
        h144[1] == h148[1] &&
        h144[2] == h148[2] &&
        h144[3] == h148[3] &&
        h144[4] == h148[4] &&
        h144[5] == h148[5] &&
        h144[6] == h148[6] &&
        h144[7] == h148[7];
    assert(equal == false, "144 and 148 width variants must differ");
}
