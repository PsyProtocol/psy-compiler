struct WeirdMerkleProofSiblingLevel {
    pub sibling_branch: [Felt; 4],
    pub sibling_reward_leaf: [Felt; 4],
}

struct VariableHeightRewardMerkleProof {
    pub top_siblings: [WeirdMerkleProofSiblingLevel; 31],
    pub left_branch: [Felt; 4],
    pub right_branch: [Felt; 4],
    pub reward_leaf: [Felt; 4],
    pub proof_height: Felt,
    pub index: Felt,
}

#[derive(Storage, StorageRef)]
struct PersistantState {
    pub min_allowed_claimed_checkpoint: Felt,
    pub last_claimed_ups_checkpoint_id: Felt,
    pub claimed_rewards: Felt,
    pub sealed_for_ups_checkpoint_id: Felt,
}

#[contract]
#[derive(Storage, StorageRef)]
struct Contract {
    pub persistant_state: PersistantState,
    pub claimed_guta_nullifiers: [Felt; 16777216],
    pub claimed_contract_deployment_nullifiers: [Felt; 1048576],
    pub claimed_user_registration_nullifiers: [Felt; 1048576]
}

impl VariableHeightRewardMerkleProof {
    pub fn compute_root_and_nullifier_index(self) -> ([Felt; 4], Felt) {
        let proof_height = self.proof_height;
        let index = self.index;
        let max_height_minus_one = 31;

        assert(proof_height <= max_height_minus_one, "proof height too large");
        assert(index < 2147483648, "index too large");

        let mut nullifier_base = 0;
        let mut nullifier_level_start_index_multiplier = 1;

        let leaf_hash = hash_two_to_one(self.left_branch, self.right_branch);
        let mut current_node_value = hash_two_to_one(leaf_hash, self.reward_leaf);

        for i in 0u32..31u32 {
            let level_index = i as Felt;
            let sibling = self.top_siblings[level_index];
            let sibling_node = sibling.sibling_branch;
            let reward_leaf = sibling.sibling_reward_leaf;

            if level_index < proof_height {
                let bit_position = level_index;
                let index_bit = (index >> bit_position) & 1;

                let branch_path_hash = if index_bit == 0 {
                    hash_two_to_one(current_node_value, sibling_node)
                } else {
                    hash_two_to_one(sibling_node, current_node_value)
                };
                current_node_value = hash_two_to_one(branch_path_hash, reward_leaf);

                nullifier_base = nullifier_base + nullifier_level_start_index_multiplier;
                nullifier_level_start_index_multiplier = nullifier_level_start_index_multiplier * 2;
            } else {
                let zero_hash = [0, 0, 0, 0];
                assert(
                    reward_leaf[0] == zero_hash[0]
                    && reward_leaf[1] == zero_hash[1]
                    && reward_leaf[2] == zero_hash[2]
                    && reward_leaf[3] == zero_hash[3],
                "unused reward leaf must be zero");
                assert(sibling_node[0] == zero_hash[0]
                    && sibling_node[1] == zero_hash[1]
                    && sibling_node[2] == zero_hash[2]
                    && sibling_node[3] == zero_hash[3],
                "unused sibling node must be zero");

                let bit_position = level_index;
                let index_bit = (index >> bit_position) & 1;
                assert(index_bit == 0, "unused index bit must be zero");
            };
        }

        let nullifier_final_index = nullifier_base + index;
        (current_node_value, nullifier_final_index)
    }
}

impl ContractRef {
    pub fn check_guta_reward(total_proofs_in_checkpoint: Felt, total_fees_paid: Felt, proposed_reward: Felt) -> bool {
        let user_transaction_inclusion_fee = 5000000000;

        let total_reward_if_all_claim = proposed_reward * total_proofs_in_checkpoint;
        proposed_reward < user_transaction_inclusion_fee && total_reward_if_all_claim < total_fees_paid
    }

    pub fn advance_to_checkpoint(new_claim_checkpoint_id: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let persistant_state = c.persistant_state.get();
        assert(new_claim_checkpoint_id > persistant_state.min_allowed_claimed_checkpoint, "checkpoint must be greater");

        clear_entire_tree();

        c.persistant_state.set(new PersistantState {
            min_allowed_claimed_checkpoint: new_claim_checkpoint_id,
            last_claimed_ups_checkpoint_id: get_checkpoint_id(),
            claimed_rewards: 0,
            sealed_for_ups_checkpoint_id: persistant_state.sealed_for_ups_checkpoint_id,
        });
    }

    pub fn claim_guta_proof(
        claim_checkpoint_id: Felt,
        proof: VariableHeightRewardMerkleProof,
        proposed_reward: Felt
    ) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_checkpoint = get_checkpoint_id();
        let claim_rewards_cooldown = 2;

        assert(current_checkpoint > claim_checkpoint_id + claim_rewards_cooldown, "cooldown not satisfied");

        let persistant_state = c.persistant_state.get();

        assert(current_checkpoint > persistant_state.sealed_for_ups_checkpoint_id, "checkpoint is sealed");

        assert(persistant_state.min_allowed_claimed_checkpoint == claim_checkpoint_id, "invalid claim checkpoint");

        let guta_rewards_tree_root = get_gutas_root(claim_checkpoint_id);

        let result: ([Felt; 4], Felt) = proof.compute_root_and_nullifier_index();

        let guta_reward_tree_root = result.0;
        let nullifier_index = result.1;

        assert(
            guta_reward_tree_root[0] == guta_rewards_tree_root[0]
            && guta_reward_tree_root[1] == guta_rewards_tree_root[1]
            && guta_reward_tree_root[2] == guta_rewards_tree_root[2]
            && guta_reward_tree_root[3] == guta_rewards_tree_root[3],
        "guta tree root mismatch");

        let user_public_key_hash = get_user_public_key_hash();
        assert(
            proof.reward_leaf[0] == user_public_key_hash[0]
            && proof.reward_leaf[1] == user_public_key_hash[1]
            && proof.reward_leaf[2] == user_public_key_hash[2]
            && proof.reward_leaf[3] == user_public_key_hash[3],
        "reward not for current user");

        assert(c.claimed_guta_nullifiers.index(nullifier_index).get() == 0, "reward already claimed");

        let old_claimed_rewards = if persistant_state.last_claimed_ups_checkpoint_id == current_checkpoint {
            persistant_state.claimed_rewards
        } else {
            0
        };

        let total_proofs = get_gutas_completed(claim_checkpoint_id);
        let total_fees = get_fees_collected(claim_checkpoint_id);
        assert(Self::check_guta_reward(total_proofs, total_fees, proposed_reward), "invalid reward amount");

        c.claimed_guta_nullifiers.index(nullifier_index).set(1);

        c.persistant_state.set(new PersistantState {
            min_allowed_claimed_checkpoint: persistant_state.min_allowed_claimed_checkpoint,
            last_claimed_ups_checkpoint_id: current_checkpoint,
            claimed_rewards: old_claimed_rewards + proposed_reward,
            sealed_for_ups_checkpoint_id: persistant_state.sealed_for_ups_checkpoint_id,
        });
    }

    pub fn advance_and_claim_guta_proof(
        claim_checkpoint_id: Felt,
        proof: VariableHeightRewardMerkleProof
    ) {
        Self::advance_to_checkpoint(claim_checkpoint_id);

        let total_proofs = get_gutas_completed(claim_checkpoint_id);
        let total_fees = get_fees_collected(claim_checkpoint_id);
        let proposed_reward = if total_proofs > 0 { total_fees / total_proofs } else { 0 };

        Self::claim_guta_proof(claim_checkpoint_id, proof, proposed_reward);
    }

    pub fn advance_to_checkpoint_and_seal(new_claim_checkpoint_id: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let persistant_state = c.persistant_state.get();
        assert(new_claim_checkpoint_id > persistant_state.min_allowed_claimed_checkpoint, "checkpoint must be greater");

        clear_entire_tree();

        c.persistant_state.set(new PersistantState {
            min_allowed_claimed_checkpoint: new_claim_checkpoint_id,
            last_claimed_ups_checkpoint_id: get_checkpoint_id(),
            claimed_rewards: 0,
            sealed_for_ups_checkpoint_id: get_checkpoint_id(),
        });
    }

    pub fn claim_simple_reward(claim_checkpoint_id: Felt, proposed_reward: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_checkpoint = get_checkpoint_id();
        let claim_rewards_cooldown = 2;

        assert(current_checkpoint > claim_checkpoint_id + claim_rewards_cooldown, "cooldown not satisfied");

        let persistant_state = c.persistant_state.get();

        assert(persistant_state.min_allowed_claimed_checkpoint == claim_checkpoint_id, "invalid claim checkpoint");

        let old_claimed_rewards = if persistant_state.last_claimed_ups_checkpoint_id == current_checkpoint {
            persistant_state.claimed_rewards
        } else {
            0
        };

        assert(proposed_reward > 0 && proposed_reward <= 1000000000, "invalid reward amount");

        c.persistant_state.set(new PersistantState {
            min_allowed_claimed_checkpoint: persistant_state.min_allowed_claimed_checkpoint,
            last_claimed_ups_checkpoint_id: current_checkpoint,
            claimed_rewards: old_claimed_rewards + proposed_reward,
            sealed_for_ups_checkpoint_id: persistant_state.sealed_for_ups_checkpoint_id,
        });
    }
}

fn main() {
    let c = ContractRef::new(ContractMetadata::current());
    let initial_state = new PersistantState {
        min_allowed_claimed_checkpoint: 0,
        last_claimed_ups_checkpoint_id: 0,
        claimed_rewards: 0,
        sealed_for_ups_checkpoint_id: 0,
    };
    c.persistant_state.set(initial_state);
}
