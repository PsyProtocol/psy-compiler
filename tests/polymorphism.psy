pub trait Value {
    pub fn value() -> Felt;
}

pub struct Two {}

impl Value for Two {
    pub fn value() -> Felt {
        2
    }
}

pub struct Three {}

impl Value for Three {
    pub fn value() -> Felt {
        3
    }
}

pub fn get_value<T: Value>(value: T) -> Felt {
    T::value()
}


// input:
// output:
fn main() {
    let two = new Two {};
    let three = new Three {};

    assert_eq(get_value(two), 2, "Expected 2 from Two");
    assert_eq(get_value(three), 3, "Expected 3 from Three");
}
