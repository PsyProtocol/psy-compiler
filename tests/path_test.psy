pub mod mod1 {
    pub struct Test<T> {
        pub field: T,
    }
    
    impl<T> Test<T> {
        pub fn get_field() -> Felt {
            return 666;
        }
        pub fn get_test<S>(a: S) -> Felt {
            return a as Felt;
        }
    }
    
    pub fn generic_fn<T>(a: T) -> Felt {
        return a as Felt;
    }
}

pub struct FeltNumber {
    pub a: Felt,
    pub b: Felt,
}

pub struct Number<T> {
    pub a: T,
    pub b: T,
}

pub trait Mul {
    pub fn mul(self: Self) -> Felt;
}

pub trait Mul2 {
    pub fn mul(self: Self) -> Felt;
}

impl<T> Mul for Number<T> {
    pub fn mul(self: Self) -> Felt {
        return (self.a * self.b) as Felt;
    }
}

impl<T> Mul2 for Number<T> {
    pub fn mul(self: Self) -> Felt {
        return (2 * self.a * self.b) as Felt;
    }
}

impl<T> Number<T> {
    pub fn get_a(self: Self) -> Felt {
        return self.a as Felt;
    }
}

impl Mul for FeltNumber {
    pub fn mul(self: Self) -> Felt {
        return (self.a * self.b) as Felt;
    }
}

impl Mul2 for FeltNumber {
    pub fn mul(self: Self) -> Felt {
        return (2 * self.a * self.b) as Felt;
    }
}

impl FeltNumber {
    pub fn get_a(self: Self) -> Felt {
        return self.a;
    }
}

pub trait TraitWithType {
    pub type Ty;

    pub fn test_fn() {
    }
}

impl<T> TraitWithType for Number<T> {
    pub type Ty = Number<T>;
    pub fn test_fn() {
    }
}

impl TraitWithType for FeltNumber {
    pub type Ty = FeltNumber;
    pub fn test_fn() {
    }
}

fn main() {
    let num = new Number#<Felt> {
        a: 1,
        b: 2,
    };
    let res = <Number<Felt> as Mul>::mul(num);
    assert_eq(res, 2, "res != 2");
    let res2 = <Number<Felt> as Mul2>::mul(num);
    assert_eq(res2, 4, "res != 4");
    let raw_num = new FeltNumber {
        a: 1,
        b: 2,
    };
    let rres = <FeltNumber as Mul>::mul(raw_num);
    assert_eq(rres, 2, "res != 2");
    let rres2 = <FeltNumber as Mul2>::mul(raw_num);
    assert_eq(rres2, 4, "res != 4");
    let rrres = <Number<Felt> as TraitWithType>::Ty::get_a(num);
    assert_eq(rrres, 1, "res!= 1");
    let generic_path_res = mod1::<Test<Felt>>::get_test#<u32>(666u32);
    assert_eq(generic_path_res, 666, "res!= 666");
    let test_felt = new mod1::<Test<Felt>> {
        field: 1,
    };
    assert_eq(test_felt.field, 1, "res!= 1");
    let generic_path_fn_res = mod1::generic_fn#<u32>(888u32);
    assert_eq(generic_path_fn_res, 888, "res!= 888");
}