#[test]
fn seq38_const_literal() {
  let d:[u32;38]=[
    0u32,1u32,2u32,3u32,4u32,5u32,6u32,7u32,8u32,9u32,
    10u32,11u32,12u32,13u32,14u32,15u32,16u32,17u32,18u32,19u32,
    20u32,21u32,22u32,23u32,24u32,25u32,26u32,27u32,28u32,29u32,
    30u32,31u32,32u32,33u32,34u32,35u32,36u32,37u32
  ];
  let h=keccak256(d);
  assert_eq(h[0], 3993107638u32, "seq38_lit");
}
