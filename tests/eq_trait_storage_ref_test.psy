#[derive(Storage)]
pub struct Person {
    pub age: Felt,
    pub score: Felt,
}

#[contract]
#[derive(Storage)]
pub struct C {
    pub a: Felt,
    #[ref]
    pub person: Person,
}

fn main() {
    let c = CRef::new(ContractMetadata::current());
    c.a = 1;
    assert_eq(c.a, 1, "assert_eq should use Eq trait for StorageRef");
    assert(c.a == 1, "== should use Eq trait for StorageRef");
    c.person = new Person {
        age: 18,
        score: 90,
    };
    let p1: Person::RefType = c.person;
    assert(p1 == new Person {
        age: 18,
        score: 90,
    }, "== should use Eq trait for generated RefType");
    assert_eq(p1, new Person {
        age: 18,
        score: 90,
    }, "assert_eq should use Eq trait for generated RefType");
}