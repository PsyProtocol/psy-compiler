    assert_u32x8_eq(got, want);
}

#[test]
fn test_append_single_leaf_root_matches_cast_folded_root() {
    let leaf0 = [2616736942u32, 889138134u32, 633395102u32, 103044223u32, 3341657709u32, 517704264u32, 1166213228u32, 1125777119u32];
    let got = append_single_leaf_root(leaf0);
    let want = [1680415800u32, 159459499u32, 251752901u32, 4015956865u32, 1236431582u32, 3092964508u32, 2679801100u32, 3827721773u32];
    assert_u32x8_eq(got, want);
}

#[test]
fn test_append_two_leaves_root_matches_cast_folded_root() {
    let leaf0 = [2616736942u32, 889138134u32, 633395102u32, 103044223u32, 3341657709u32, 517704264u32, 1166213228u32, 1125777119u32];
    let leaf1 = [2744940282u32, 2316820200u32, 3310581918u32, 579113994u32, 3134062632u32, 3051381702u32, 213591286u32, 1516383443u32];
    let got = append_two_leaves_root(leaf0, leaf1);
    let want = [3767492367u32, 1770963790u32, 2197771268u32, 1340099796u32, 815178283u32, 1060491345u32, 184675233u32, 2598937493u32];
    assert_u32x8_eq(got, want);
}