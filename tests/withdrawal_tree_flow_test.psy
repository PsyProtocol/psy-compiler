use std::prelude::*;
use token::PsyTokenContractRef;
use withdrawal_tree::PsyWithdrawalTreeContractRef;

fn main() -> Felt {
    let destination_chain_id: Felt = 7;
    let nonce: Felt = 1;
    let amount: Felt = 25;
    let token_address: Hash = [11, 22, 33, 44];
    let recipient: Hash = [101, 202, 303, 404];

    PsyTokenContractRef::simple_mint(1000);
    PsyTokenContractRef::withdraw(destination_chain_id, token_address, amount, recipient, nonce);

    let withdrawal_key: Hash = PsyTokenContractRef::limbs8_to_hash(keccak256([2, destination_chain_id, nonce]));
    let token_ref = PsyTokenContractRef::new(ContractMetadata::current());
    let leaf_hash: Hash = token_ref.claimed_nullifiers.get(withdrawal_key);
    assert(leaf_hash != [0, 0, 0, 0], "withdraw leaf should exist");

    PsyWithdrawalTreeContractRef::append_withdrawal(get_user_id(), destination_chain_id, nonce);

    let chain_next_index = PsyWithdrawalTreeContractRef::get_chain_next_index(destination_chain_id);
    assert_eq(chain_next_index, 1, "chain next index should increment");

    let chain_root = PsyWithdrawalTreeContractRef::get_chain_root(destination_chain_id);
    assert(chain_root != [0, 0, 0, 0], "chain root should be non-zero after append");

    let global_root = PsyWithdrawalTreeContractRef::get_root();
    assert(global_root != [0, 0, 0, 0], "global root should be non-zero after append");

    chain_next_index
}
