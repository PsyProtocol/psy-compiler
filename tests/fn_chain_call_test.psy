    let mut e: Felt = sub(2, 1) + mul(2, 2);
    let mut d: Felt = add(1 + 2, 2);
    let mut f: Felt = add(add(1, 2), 2);
    let mut g: Felt = add(1 + 3, add(3 + 5, 8 - mul(add(sub(10, 5), 5), 2)));
    let mut h: Felt = add_one(1);
    let mut i: Felt = add_one(add_one(add_one(add_one(add_one(add_one(add_one(add_one(add_one(1 + add_one(1 + add_one(1 + add_one(1 + 2)))) + 2) + 2) + 2))))));
}