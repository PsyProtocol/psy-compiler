fn add(a: Felt, b: Felt) -> Felt {
    let mut c: Felt = a + b;
    return c;
}

fn sub(a: Felt, b: Felt) -> Felt {
    let mut c: Felt = a - b;
    return c;
}

fn mul(a: Felt, b: Felt) -> Felt {
    let mut c: Felt = a * b;
    return c;
}

fn add_one(i: Felt) -> Felt {
    let mut c: Felt = i + 1;
    return c;
}

