// Regression for issue #113: an else-if predicate (or match arm pattern) is
// only evaluated when every previous branch was false. Guard asserts inside
// it must be gated by `!prev`, not by the previous branch's condition —
// otherwise a constant-false previous branch silently drops the assert and
// the branch body executes its state writes unguarded.
#[contract]
#[derive(Storage)]
pub struct C {
    pub admin: Felt,
}

fn authorized(i: Felt) -> bool {
    assert(i < 2, "unauthorized");
    return true;
}

// index = 2 fails `index < 2`: the guard assert inside `authorized` must
// trap instead of being dropped, so the admin write never happens.
#[test]
#[should_panic]
fn test_elseif_guard_not_bypassed() {
    let c = CRef::new(ContractMetadata::current());
    let index: Felt = 2;
    if index < 2 {
        c.admin = 1;
    }
    else if authorized(index) {
        c.admin = 777;
    }
;
}

fn decoy(i: Felt) -> Felt {
    assert(i < 2, "unauthorized");
    return 999;
}

// Same discipline for match arms: the second arm's pattern is evaluated
// under the first arm's (constant-false) gate; its guard assert must trap.
#[test]
#[should_panic]
fn test_match_arm_guard_not_bypassed() {
    let c = CRef::new(ContractMetadata::current());
    let index: Felt = 2;
    match 999 {
        998 => {
            c.admin = 1;
        },
        decoy(index) => {
            c.admin = 777;
        },
        _ => {
        },
    };
}

// Positive control: a guard in an actually-reachable else-if still passes.
#[test]
fn test_elseif_guard_allows_authorized_index() {
    let c = CRef::new(ContractMetadata::current());
    let index: Felt = 1;
    if index < 2 {
        c.admin = 1;
    }
    else if authorized(index) {
        c.admin = 777;
    }
;
}