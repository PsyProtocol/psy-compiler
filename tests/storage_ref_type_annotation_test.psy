#[derive(StorageRef, Storage)]
pub struct Person {
    pub age: Felt,
}

#[contract]
#[derive(StorageRef, Storage)]
pub struct SimpleContract {
    #[RefType]
    pub person: Person,
}

fn main() {
    let c = SimpleContractRef::new(ContractMetadata::current());
    let person_ref: Person::RefType = c.person;
    person_ref.age = 9;
    assert_eq(c.person.age, 9, "associated ref type annotation should work");
}