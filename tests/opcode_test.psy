// input: 2,3
// output:
fn main(a: Felt, b: Felt) -> Felt {
    let mut bool0: bool = false;
    let mut bool1: bool = true;
    let u32_zero = (b - a - 1) as u32;
    let u32_one = (b - a) as u32;
    let u32_two = u32_one + u32_one;
    let u32_three = u32_two + u32_one;
    let u32_four = u32_two + u32_two;
    let u32_32 = u32_two ** 5u32;
    let u32_64 = u32_two ** 6u32;
    assert_eq(u32_32, 32u32, "");
    assert_eq(u32_64, 64u32, "");
    let u32_two_pow_31 = u32_two ** 31u32;
    let zero: Felt = b - a - 1;
    let one: Felt = b - a;
    let two: Felt = one + one;
    let three: Felt = two + one;
    let four: Felt = two + two;
    // goldilocks field prime = 18446744069414584321 = 0xffffffff00000001
    let p_minus_one = zero - one;
    let p_minus_one_div_two = p_minus_one / two;
    let p_minus_one_div_four = p_minus_one_div_two / two;
    let u32_max = (two ** 32 - one) as u32;
    assert_eq(u32_max, 4294967295u32, "");
    // Add
    assert_eq(zero + zero, zero, "add0");
    assert_eq(p_minus_one + p_minus_one, zero - two, "add1");
    assert_eq(p_minus_one + one, zero, "add2");
    assert_eq(p_minus_one_div_two + p_minus_one_div_two, p_minus_one, "add3");
    assert_eq(u32_two_pow_31 + u32_one, 2147483649u32, "add4");
    // error, number too large to fit in target type/u32 add value too large
    // assert_eq(u32_two_pow_31 + u32_two_pow_31, 4294967296u32, "");
    // Sub
    assert_eq(zero - zero, zero, "sub0");
    assert_eq(p_minus_one - p_minus_one, zero, "sub1");
    assert_eq(zero - one, p_minus_one, "sub2");
    assert_eq(p_minus_one - p_minus_one_div_two, p_minus_one_div_two, "sub3");
    assert_eq(u32_two_pow_31 - u32_one, 2147483647u32, "sub4");
    // error, u32 sub value too low
    // assert_eq(u32_one - u32_two_pow_31, 1u32-2147483647u32, "");
    // Mul
    assert_eq(zero * one, zero, "mul0");
    assert_eq(two * p_minus_one_div_two, p_minus_one, "mul1");
    assert_eq(p_minus_one * p_minus_one, one, "mul2");
    assert_eq(p_minus_one_div_two * p_minus_one_div_two, 0 - p_minus_one_div_four, "mul3");
    assert_eq(u32_two_pow_31 * u32_one, 2147483648u32, "mul4");
    // error, number too large to fit in target type/u32 add value too large
    // assert_eq(u32_two_pow_31 * u32_two, 4294967296u32, "");
    // Div 
    assert_eq(p_minus_one / two, p_minus_one_div_two, "div0");
    assert_eq(one / p_minus_one, p_minus_one, "div1");
    assert_eq(one / p_minus_one_div_two, two / p_minus_one, "div2");
    // error, Mod by zero
    // assert_eq(p_minus_one % zero, one, "");
    assert_eq(u32_two_pow_31 / u32_one, 2147483648u32, "div3");
    assert_eq(u32_one / u32_two_pow_31, 0u32, "div4");
    assert_eq((u32_two_pow_31 + u32_one) / u32_four, 536870912u32, "div5");
    assert_eq(u32_three / u32_two, u32_one, "div6");
    // error, u32 mod by zero
    // assert_eq(u32_three % u32_zero, u32_one, "");
    // BoolNot
    let bool0_var = zero == one;
    let bool1_var = zero != one;
    assert_eq(bool0_var, bool0, "boolNot0");
    assert_eq(bool1_var, bool1, "boolNot1");
    assert_eq(!bool0_var, bool1_var, "boolNot2");
    // todo
    assert_eq(!one, zero, "boolNot3");
    assert_eq(!zero, one, "boolNot4");
    // panic, Invalid bool value
    // assert_eq(!p_minus_one, zero, "");
    // error, TypeMismatch
    // assert_eq(!u32_two, u32_one, "");
    // BoolAnd
    assert_eq(bool0_var && bool0_var, bool0, "boolAnd0");
    assert_eq(bool0_var && bool1_var, bool0, "boolAnd1");
    assert_eq(bool1_var && bool0_var, bool0, "boolAnd2");
    assert_eq(bool1_var && bool1_var, bool1, "boolAnd3");
    // error, TypeMismatch
    // assert_eq(zero && one, bool0, "");
    // BoolOr
    assert_eq(bool0_var || bool0_var, bool0, "boolOr0");
    assert_eq(bool0_var || bool1_var, bool1, "boolOr1");
    assert_eq(bool1_var || bool0_var, bool1, "boolOr2");
    assert_eq(bool1_var || bool1_var, bool1, "boolOr3");
    // error, TypeMismatch
    // assert_eq(zero || one, bool0, "");
    // Xor
    assert_eq(bool0_var ^ bool0_var, bool0, "boolXor0");
    assert_eq(bool0_var ^ bool1_var, bool1, "boolXor1");
    assert_eq(bool1_var ^ bool0_var, bool1, "boolXor2");
    assert_eq(bool1_var ^ bool1_var, bool0, "boolXor3");
    // Nor, unimplented
    // Eq
    assert_eq(one, 1, "eq0");
    assert_eq(bool0_var, bool0, "eq1");
    assert_eq(bool1_var, bool1, "eq2");
    assert_eq(u32_zero, 0u32, "eq3");
    assert_eq(u32_one, 1u32, "eq4");
    assert_eq(u32_two_pow_31, 2147483648u32, "eq5");
    // Lte, Lt
    assert_eq(zero < one, bool1, "lt0");
    assert_eq(one < p_minus_one_div_four, bool1, "lt1");
    assert_eq(p_minus_one_div_four <= p_minus_one_div_two, bool1, "lt2");
    assert_eq(p_minus_one_div_two <= p_minus_one, bool1, "lt3");
    assert_eq(u32_zero < u32_one, bool1, "lt4");
    assert_eq(u32_two <= u32_two_pow_31, bool1, "lt5");
    // error, TypeMismatch
    // assert_eq(bool0 <= bool1, bool1, "");
    // Gte, Gt
    assert_eq(zero > one, bool0, "gt0");
    assert_eq(one > p_minus_one_div_four, bool0, "gt1");
    assert_eq(p_minus_one_div_four >= p_minus_one_div_two, bool0, "gt2");
    assert_eq(p_minus_one_div_two >= p_minus_one, bool0, "gt3");
    assert_eq(u32_zero > u32_one, bool0, "gt4");
    assert_eq(u32_two_pow_31 >= u32_two, bool1, "gt5");
    // error, TypeMismatch
    // assert_eq(bool1 >= bool0, bool1, "");
    // Exp, ExpConstantPower, ExpConstantBase
    assert_eq(two ** p_minus_one, one, "exp0");
    assert_eq(two ** p_minus_one_div_two, one, "exp1");
    assert_eq(p_minus_one ** zero, 1, "exp2");
    assert_eq(zero ** p_minus_one, zero, "exp3");
    assert_eq(u32_two_pow_31 ** u32_zero, u32_one, "exp4");
    assert_eq(u32_zero ** u32_two_pow_31, u32_zero, "exp5");
    assert_eq(two ** 18446744069414584320, one, "exp0");
    assert_eq(two ** 9223372034707292160, one, "exp1");
    assert_eq(p_minus_one ** 0, 1, "exp2");
    assert_eq(zero ** 18446744069414584320, zero, "exp3");
    assert_eq(u32_two_pow_31 ** 0u32, u32_one, "exp4");
    assert_eq(u32_zero ** 2147483648u32, u32_zero, "exp5");
    assert_eq(2 ** 18446744069414584320, one, "exp0");
    assert_eq(2 ** 9223372034707292160, one, "exp1");
    assert_eq(18446744069414584320 ** 0, 1, "exp2");
    assert_eq(0 ** 18446744069414584320, zero, "exp3");
    assert_eq(2147483648u32 ** 0u32, u32_one, "exp4");
    assert_eq(0u32 ** 2147483648u32, u32_zero, "exp5");
    // error: u32 exp cannot > 2**32
    // assert_eq(u32_two**32u32, u32_zero, );
    // assert_eq(2u32**66u32, u32_zero, );
    assert_eq(two ** 64, 4294967295, "two**64");
    assert_eq(two ** 65, 8589934590, "two**65");
    // Mod
    assert_eq(zero % two, zero, "mod0");
    assert_eq(one % two, one, "mod1");
    assert_eq(p_minus_one % two, zero, "mod2");
    assert_eq((two ** 63) % (three ** 35), 17567738638829720, "mod3");
    assert_eq((two ** 63) % 50031545098999707, 17567738638829720, "mod4");
    assert_eq(9223372036854775808 % 50031545098999707, 17567738638829720, "mod5");
    assert_eq(p_minus_one % (two ** 32 - one), zero, "mod6");
    assert_eq(u32_zero % u32_two, u32_zero, "mod7");
    assert_eq(u32_one % u32_two, u32_one, "mod8");
    assert_eq(u32_two ** u32_zero % u32_two, u32_one, "mod9");
    assert_eq((u32_two_pow_31 + u32_two) % u32_two_pow_31, u32_two, "mod10");
    assert_eq(three % p_minus_one, three, "mod11");
    assert_eq(p_minus_one % three, zero, "mod12");
    assert_eq(zero % p_minus_one, zero, "mod13");
    assert_eq((p_minus_one - one) % p_minus_one, -two, "mod14");
    // UnaryInverse 
    // UnaryNegative 
    assert_eq(p_minus_one, -one, "neg0");
    assert_eq(-zero, zero, "neg1");
    // error: TypeMismatch
    // assert_eq(-u32_one, p_minus_one, "");
    // U32And
    assert_eq(u32_two_pow_31 & u32_zero, u32_zero, "u32And0");
    assert_eq(u32_two_pow_31 & u32_two_pow_31, u32_two_pow_31, "u32And1");
    assert_eq(u32_two_pow_31 & u32_max, u32_two_pow_31, "u32And2");
    assert_eq(u32_max & u32_max, u32_max, "u32And3");
    assert_eq(u32_two_pow_31 & 0u32, u32_zero, "u32And4");
    assert_eq(2147483648u32 & u32_two_pow_31, u32_two_pow_31, "u32And5");
    assert_eq(u32_two_pow_31 & 4294967295u32, u32_two_pow_31, "u32And6");
    assert_eq(4294967295u32 & 4294967295u32, u32_max, "u32And7");
    // U32Or
    assert_eq(u32_two_pow_31 | u32_zero, u32_two_pow_31, "u32Or0");
    assert_eq(u32_two_pow_31 | u32_two_pow_31, u32_two_pow_31, "u32Or1");
    assert_eq(u32_two_pow_31 | u32_max, u32_max, "u32Or2");
    assert_eq(u32_max | u32_max, u32_max, "u32Or3");
    assert_eq(u32_two_pow_31 | 0u32, u32_two_pow_31, "u32Or4");
    assert_eq(2147483648u32 | u32_two_pow_31, u32_two_pow_31, "u32Or5");
    assert_eq(u32_two_pow_31 | 4294967295u32, u32_max, "u32Or6");
    assert_eq(4294967295u32 | 4294967295u32, u32_max, "u32Or7");
    // U32Xor
    assert_eq(u32_two_pow_31 ^ u32_zero, u32_two_pow_31, "u32Xor0");
    assert_eq(u32_two_pow_31 ^ u32_two_pow_31, u32_zero, "u32Xor1");
    assert_eq(u32_two_pow_31 ^ u32_max, u32_max - u32_two_pow_31, "u32Xor2");
    assert_eq(u32_max ^ u32_max, u32_zero, "u32Xor3");
    assert_eq(u32_two_pow_31 ^ 0u32, u32_two_pow_31, "u32Xor4");
    assert_eq(2147483648u32 ^ u32_two_pow_31, u32_zero, "u32Xor5");
    assert_eq(u32_two_pow_31 ^ 4294967295u32, u32_max - u32_two_pow_31, "u32Xor6");
    assert_eq(u32_max ^ u32_max, u32_zero, "u32Xor7");
    // U32ShiftLeft
    assert_eq(u32_max << u32_zero, u32_max, "shl0");
    assert_eq(u32_max << u32_one, u32_max - u32_one, "shl1");
    assert_eq(u32_max << (u32_32 - u32_one), u32_two_pow_31, "shl2");
    assert_eq(u32_max << u32_32, u32_zero, "shl3");
    assert_eq(u32_max << (u32_32 + u32_one), u32_zero, "shl4");
    assert_eq(u32_max << 0u32, u32_max, "shl5");
    assert_eq(u32_max << 1u32, u32_max - u32_one, "shl6");
    assert_eq(u32_max << 31u32, u32_two_pow_31, "shl7");
    assert_eq(u32_max << 32u32, u32_zero, "shl8");
    assert_eq(u32_max << 33u32, u32_zero, "shl9");
    assert_eq(4294967295u32 << u32_zero, u32_max, "shl10");
    assert_eq(4294967295u32 << u32_one, u32_max - u32_one, "shl11");
    assert_eq(4294967295u32 << (u32_32 - u32_one), u32_two_pow_31, "shl12");
    assert_eq(4294967295u32 << u32_32, u32_zero, "shl13");
    assert_eq(4294967295u32 << (u32_32 + u32_one), u32_zero, "shl14");
    assert_eq(4294967295u32 << 0u32, u32_max, "shl15");
    assert_eq(4294967295u32 << 1u32, u32_max - u32_one, "shl16");
    assert_eq(4294967295u32 << 31u32, u32_two_pow_31, "shl17");
    assert_eq(4294967295u32 << 32u32, u32_zero, "shl18");
    assert_eq(4294967295u32 << 33u32, u32_zero, "shl19");
    assert_eq(u32_max << 66u32, u32_zero, "shl20");
    // U32ShiftRight
    assert_eq(u32_max >> u32_zero, u32_max, "shr0");
    assert_eq(u32_max >> u32_one, u32_two_pow_31 - u32_one, "shr1");
    assert_eq(u32_max >> (u32_32 - u32_one), u32_one, "shr2");
    assert_eq(u32_max >> u32_32, u32_zero, "shr3");
    assert_eq(u32_max >> (u32_32 + u32_one), u32_zero, "shr4");
    assert_eq(u32_max >> 0u32, u32_max, "shr5");
    assert_eq(u32_max >> 1u32, u32_two_pow_31 - u32_one, "shr6");
    assert_eq(u32_max >> 31u32, u32_one, "shr7");
    assert_eq(u32_max >> 32u32, u32_zero, "shr8");
    assert_eq(u32_max >> 33u32, u32_zero, "shr9");
    assert_eq(4294967295u32 >> u32_zero, u32_max, "shr10");
    assert_eq(4294967295u32 >> u32_one, u32_two_pow_31 - u32_one, "shr11");
    assert_eq(4294967295u32 >> (u32_32 - u32_one), u32_one, "shr12");
    assert_eq(4294967295u32 >> u32_32, u32_zero, "shr13");
    assert_eq(4294967295u32 >> (u32_32 + u32_one), u32_zero, "shr14");
    assert_eq(4294967295u32 >> 0u32, u32_max, "shr15");
    assert_eq(4294967295u32 >> 1u32, u32_two_pow_31 - u32_one, "shr16");
    assert_eq(4294967295u32 >> 31u32, u32_one, "shr17");
    assert_eq(4294967295u32 >> 32u32, u32_zero, "shr18");
    assert_eq(4294967295u32 >> 33u32, u32_zero, "shr19");
    assert_eq(u32_max >> 64u32, u32_zero, "shr20");
    // SplitBits, SumBits
    let target = p_minus_one - u32_two_pow_31 as Felt;
    let split_bits = __split_bits(target, 64);
    assert_eq(split_bits[0], 0, "split0");
    assert_eq(split_bits[8], 0, "split1");
    assert_eq(split_bits[16], 0, "split2");
    assert_eq(split_bits[24], 0, "split3");
    assert_eq(split_bits[32], 0, "split4");
    assert_eq(split_bits[40], 1, "split5");
    assert_eq(split_bits[48], 1, "split6");
    assert_eq(split_bits[56], 1, "split7");
    let mut target2 = 0;
    let mut power_of_two = 1;
    for i in 0u32..64u32 {
        target2 += (split_bits[i as Felt] as Felt) * power_of_two;
        power_of_two *= 2;
    }
    assert_eq(target, target2, "split8");
    let sum_split_target = __sum_bits(split_bits);
    assert_eq(sum_split_target, target, "sum_bits0");
    let split_zero = __split_bits(zero, 1);
    assert_eq(split_zero[0], 0, "split9");
    let sum_split_zero = __sum_bits(split_zero);
    assert_eq(sum_split_zero, zero, "sum_bits1");
    // error, SplitBits: target bits must be less than num_bits
    // let split_two_pow_32 = __split_bits(two**32, 32);
    let split_two_pow_32 = __split_bits(two ** 32, 33);
    assert_eq(split_zero[0], 0, "split10");
    assert_eq(split_two_pow_32[31], 0, "split11");
    assert_eq(split_two_pow_32[32], 1, "split12");
    // error, array index must less than array length
    // assert_eq(split_two_pow_32[33], 1, "");
    let sum_split_two_pow_32 = __sum_bits(split_two_pow_32);
    assert_eq(sum_split_two_pow_32, two ** 32, "sum_bits2");
    // error, SplitBits: target bits must be less than num_bits
    let split_p_minus_one = __split_bits(p_minus_one, 64);
    let sum_split_p_minus_one = __sum_bits(split_p_minus_one);
    assert_eq(sum_split_p_minus_one, p_minus_one, "sum_bits3");
    // Cast
    assert_eq(bool0_var as u32, 0u32, "cast0");
    assert_eq(bool0_var as Felt, 0, "cast1");
    assert_eq(bool1_var as u32, 1u32, "cast2");
    assert_eq(bool1_var as Felt, 1, "cast3");
    assert_eq(u32_zero as bool, bool0, "cast4");
    assert_eq(u32_one as bool, bool1, "cast5");
    // error, Invalid bool value
    // assert_eq(u32_two_pow_31 as bool, bool1, "");
    assert_eq(u32_zero as Felt, 0, "cast6");
    assert_eq(u32_one as Felt, 1, "cast7");
    assert_eq(u32_two_pow_31 as Felt, 2147483648, "cast8");
    assert_eq(zero as u32, u32_zero, "cast9");
    assert_eq(one as u32, u32_one, "cast10");
    assert_eq(u32_max as u32, 4294967295u32, "cast11");
    // error, Invalid u32 value
    // assert_eq(target as u32, 2147483648u32, "");
    // error, Invalid bool value
    // assert_eq(target as bool, true, "");
    assert_eq(zero as bool, bool0, "cast12");
    assert_eq(one as bool, bool1, "cast13");
    return a + b;
}