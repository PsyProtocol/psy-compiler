fn cal1(a: Felt, b: Felt) -> Felt {
    let c: Felt = a + b;
    return c;
}

fn min(a: Felt, b: Felt) -> Felt {
    if a < b {
        a
    }
    else {
        b
    }
}

fn middle(a: Felt, b: Felt, c: Felt) -> Felt {
    if a > b {
        if b > c {
            b
        }
        else if a > c {
            c
        }
        else {
            a
        }
    }
    else {
        if a > c {
            a
        }
        else if b > c {
            c
        }
        else {
            b
        }
    }
}

fn cal2(a: Felt, b: Felt) {
    let c: Felt = a - b;
}

// input:
// output:
fn main() {
    let a: Felt = 10;
    let b: Felt = 11;
    let c: Felt = 12;
    let d: Felt = 13;
    let e: Felt = 14;
    let basic: Felt = if a > b {
        c
    }
    else {
        d
    };
    let all: Felt = if a > b {
        c
    }
    else if b > a {
        d
    }
    else {
        e
    };
    assert_eq(basic, 13, "test if ");
    let embedded1: Felt = if a > b {
        if b > c {
            a
        }
        else {
            b
        }
    }
    else {
        c
    };
    let embedded2: Felt = if a > b {
        if a > b {
            c
        }
        else if b > a {
            d
        }
        else {
            e
        }
    }
    else if c > d {
        if a > b {
            c
        }
        else if b > a {
            d
        }
        else {
            e
        }
    }
    else {
        if a > b {
            c
        }
        else if b > a {
            d
        }
        else {
            e
        }
    };
    let embedded3: Felt = if a > b {
        let tmp0: Felt = 1;
        let tmp1: Felt = 2;
        if tmp0 > tmp1 {
            tmp0
        }
        else {
            tmp1
        }
    }
    else if c > d {
        let tmp2: Felt = 3;
        let tmp3: Felt = 4;
        if tmp2 > tmp3 {
            tmp2
        }
        else {
            tmp3
        }
    }
    else {
        let tmp4: Felt = 5;
        let tmp5: Felt = 6;
        if tmp4 > tmp5 {
            tmp4
        }
        else {
            tmp5
        }
    };
    let m1: Felt = 1;
    let m2: Felt = 2;
    let m3: Felt = 3;
    let m4: Felt = 4;
    let min1: Felt = min(m1, m2);
    assert_eq(min1, 1, "test if ");
    let min2: Felt = min(m2, m3);
    assert_eq(min2, 2, "test if ");
    let middle1: Felt = middle(m1, m2, m3);
    let middle2: Felt = middle(m2, m3, m4);
    let n1: Felt = 1;
    let n2: Felt = 2;
    cal2(n1, n2);
    cal2(if n1 > n2 {
        n1
    }
    else {
        n2
    }, n2);
}
