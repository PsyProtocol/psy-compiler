#[contract]
#[derive(Storage)]
pub struct AdjacentContract {
    pub before: Felt,
    pub balances: Map<Hash, Hash, 128u32>,
    pub after: Felt,
}

#[test]
fn test_map_ops_preserve_adjacent_fields() {
    let c = AdjacentContractRef::new(ContractMetadata::current());
    c.before = 111;
    c.after = 222;
    let key: Hash = [4001, 0, 0, 0];

    c.balances.insert(key, [1, 2, 3, 4]);
    assert_eq(c.before, 111, "before unchanged after insert");
    assert_eq(c.after, 222, "after unchanged after insert");

    c.balances.set(key, [5, 6, 7, 8]);
    assert_eq(c.before, 111, "before unchanged after set");
    assert_eq(c.after, 222, "after unchanged after set");

    c.before = 112;
    c.after = 223;
    assert_eq(c.before, 112, "before still writable");
    assert_eq(c.after, 223, "after still writable");
}
