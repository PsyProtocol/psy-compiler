impl<T, N: Felt> [T; N] {
    pub const fn len() -> Felt {
        return N + 1;
    }
}

pub trait One {
    pub fn One() -> Felt {
        1
    }
}

impl One for u32 {
    pub fn One() -> Felt {
        1
    }
}

pub trait Two<T: One> {
    pub fn two() -> Felt {
        2
    }
}

impl<T: One> Two<T> for Felt {
    pub fn two() -> Felt {
        2
    }
}

struct Box<K: One, T: Two<K>> {
    pub data: T,
    pub extra: Felt,
}

impl<K: One, T: Two<K>> Box<K, T> {
    pub fn new(data: T) -> Box<K, T> {
        return Box {
            data: data,
            extra: T::two(),
        };
    }
    pub fn echo<U>(self: Self, value: U) -> U {
        value
    }
}

// input:
// output: 51
fn main() -> Felt {
    let bb = Box<u32, Felt> {
        data: 1,
        extra: 1,
    };
    let mut b: Box<u32, Felt> = <Box<u32, Felt>>::new(42);
    let echoed: Felt = b.echo::<Felt>(5);
    assert_eq(echoed, 5, "generic member call");
    let echoed_u32: u32 = b.echo::<u32>(7u32);
    assert_eq(echoed_u32, 7u32, "second generic member-call instantiation");
    let echoed_array: [Felt; 2] = b.echo::<[Felt; 2]>([8, 9]);
    assert_eq(echoed_array[1], 9, "nested generic member-call type survives formatting");
    b.data += 1;
    b.data + <[Felt; 3]>::len() + b.extra + <Felt as Two<u32>>::two()
}