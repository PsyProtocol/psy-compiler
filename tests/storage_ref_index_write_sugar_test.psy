#[contract]
#[derive(StorageRef, Storage)]
pub struct C {
    pub a: [Felt; 4],
}

fn main() {
    let c = CRef::new(ContractMetadata::current());
    c.a[0] = 11;
    c.a[1] = 22;
    c.a[2] = 33;
    c.a[3] = 44;
    c.a[0] += 1;
    c.a[1] += 2;
    c.a[2] += 3;
    c.a[3] += 4;
    assert_eq(c.a[0].get(), 12, "index write sugar 0");
    assert_eq(c.a[1].get(), 24, "index write sugar 1");
    assert_eq(c.a[2].get(), 36, "index write sugar 2");
    assert_eq(c.a[3].get(), 48, "index write sugar 3");
}