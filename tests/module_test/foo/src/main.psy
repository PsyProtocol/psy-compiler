use bar::test_fn;
fn add(a: Felt, b: Felt) -> Felt{
    let c: Felt = a + b;
    return c;
}
fn sub(a: Felt, b: Felt) -> Felt{
    let c: Felt = a - b;
    return c;
}
fn mul(a: Felt, b: Felt) -> Felt{
    let c: Felt = a * b;
    return c;
}
fn div(a: Felt, b: Felt) -> Felt{
    let c: Felt = a / b;
    return c;
}

fn test_fn2(a: Felt, b: Felt) -> Felt{
    let c: Felt = a + b;
    return c;
}



fn test_fn4(a: Felt, b: Felt) -> Felt{
    let c: Felt = a + b;
    return c;
}

fn test_fn5(a: Felt, b: Felt) -> Felt{
    let c: Felt = a + b;
    return c;
}
fn test_mini(a: Felt, b: Felt) -> Felt{
    let c: Felt = a + b;
    if a > b {
        let c: Felt = a - b;
    } else {
        let c: Felt = a + b;
    };
    return c;
}
fn main(a: Felt, b: Felt) -> Felt{
    let c: Felt = test_fn(a, b);

    let add_result: Felt = add(a, b);
    let sub_result: Felt = sub(a, b);
    let mul_result: Felt = mul(a, b);
    let div_result: Felt = div(a, b);

    let test_fn2_result: Felt = test_fn2(a, b);
    return c;
}
