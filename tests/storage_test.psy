#[derive(Storage)]
pub struct Person {
    pub age: Felt,
    pub height: Felt,
    pub year_of_birth: Felt,
}

#[storage]
#[derive(Storage)]
pub struct SimpleContract {
    pub a: Felt,
    pub b: Person,
    pub c: Felt,
    pub e: [Person; 3],
    pub d: Person,
    pub f: [Felt; 4],
}

impl SimpleContract {
    pub fn new() -> Self {
        return new SimpleContract {
            a: 0,
            b: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0,
            },
            c: 0,
            d: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0,
            },
            e: [new Person {
                    age: 0,
                    height: 0,
                    year_of_birth: 0,
                }, new Person {
                    age: 0,
                    height: 0,
                    year_of_birth: 0,
                }, new Person {
                    age: 0,
                    height: 0,
                    year_of_birth: 0,
                }],
            f: [5, 6, 7, 8],
        };
    }
    pub fn set_abcde(a: Felt, b: Person, c: Felt, d: Person, e: [Person; 3], f: [Felt; 4]) {
        SimpleContract::set_a(a);
        SimpleContract::set_b(b);
        SimpleContract::set_c(c);
        SimpleContract::set_e(e);
        SimpleContract::set_d(d);
        SimpleContract::set_f(f);
    }
}

// input:
// output:
fn main() -> Felt {
    assert_eq(Felt::size(), 1, "Error: Felt::size() should be 1");
    assert_eq(bool::size(), 1, "Error: bool::size() should be 1");
    assert_eq(Person::size(), 3, "Error: Person::size() should be 3");
    assert_eq(SimpleContract::size(), 21, "Error: Contract::size() should be 21");
    assert_eq(<[Felt; 2]>::size(), 2, "Error: [Felt;2]::size() should be 2");
    assert_eq(<[Felt; 4]>::size(), 4, "Error: [Felt;4]::size() should be 4");
    SimpleContract::set_e([new Person {
            age: 23,
            height: 183,
            year_of_birth: 2003,
        }, new Person {
            age: 22,
            height: 182,
            year_of_birth: 2002,
        }, new Person {
            age: 21,
            height: 181,
            year_of_birth: 2001,
        }]);
    SimpleContract::set_d(new Person {
        age: 40,
        height: 170,
        year_of_birth: 1980,
    });
    SimpleContract::set_f([8, 7, 6, 5]);
    SimpleContract::set_a(10);
    SimpleContract::set_b(new Person {
        age: 20,
        height: 180,
        year_of_birth: 2000,
    });
    SimpleContract::set_c(30);
    let a: Felt = SimpleContract::get_a(0, get_user_id(), get_contract_id());
    assert_eq(a, 10, "Error: a should be 10");
    let b: Person = SimpleContract::get_b(0, get_user_id(), get_contract_id());
    assert_eq(b.age, 20, "Error: b.age should be 20");
    assert_eq(b.height, 180, "Error: b.height should be 180");
    assert_eq(b.year_of_birth, 2000, "Error: b.year_of_birth should be 2000");
    let c: Felt = SimpleContract::get_c(0, get_user_id(), get_contract_id());
    assert_eq(c, 30, "Error: c should be 30");
    let d: Person = SimpleContract::get_d(0, get_user_id(), get_contract_id());
    assert_eq(d.age, 40, "Error: d.age should be 40");
    assert_eq(d.height, 170, "Error: d.height should be 170");
    assert_eq(d.year_of_birth, 1980, "Error: d.age should be 1980");
    let e: [Person; 3] = SimpleContract::get_e(0, get_user_id(), get_contract_id());
    assert_eq(e[0].age, 23, "Error: e[0].age should be 23");
    assert_eq(e[1].age, 22, "Error: e[1].age should be 22");
    assert_eq(e[2].age, 21, "Error: e[2].age should be 21");
    let f: [Felt; 4] = SimpleContract::get_f(0, get_user_id(), get_contract_id());
    assert_eq(f[0], 8, "Error: f[0] should be 8");
    assert_eq(f[1], 7, "Error: f[1] should be 7");
    assert_eq(f[2], 6, "Error: f[2] should be 6");
    assert_eq(f[3], 5, "Error: f[3] should be 5");
    // SimpleContract::set_f_at(0, 5);
    // SimpleContract::set_f_at(1, 6);
    // SimpleContract::set_f_at(2, 7);
    // SimpleContract::set_f_at(3, 8);
    // assert_eq(SimpleContract::get_f_at(0), 5, "Error: f[0] should be 5");
    // assert_eq(SimpleContract::get_f_at(1), 6, "Error: f[1] should be 6");
    // assert_eq(SimpleContract::get_f_at(2), 7, "Error: f[2] should be 7");
    // assert_eq(SimpleContract::get_f_at(3), 8, "Error: f[3] should be 8");
    assert_eq(<[Felt; 2]>::size(), 2, "Error: [Felt; 2]::size() should be 2");
    return a;
}