#[contract]
#[derive(Storage)]
pub struct LoopContract {
    pub balances: Map<Hash, Hash, 128u32>,
}

#[test]
fn test_loop_insert_multiple_keys() {
    let c = LoopContractRef::new(ContractMetadata::current());
    for i in 0u32..3u32 {
        let key: Hash = [(i + 1u32) as Felt, 0, 0, 0];
        let value: Hash = [((i + 1u32) * 10u32) as Felt, 0, 0, 0];
        c.balances.insert(key, value);
    }
    assert_eq(c.balances.get([1, 0, 0, 0]), [10, 0, 0, 0], "key 1");
    assert_eq(c.balances.get([2, 0, 0, 0]), [20, 0, 0, 0], "key 2");
    assert_eq(c.balances.get([3, 0, 0, 0]), [30, 0, 0, 0], "key 3");
}