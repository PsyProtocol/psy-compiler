use std::prelude::*;

#[derive(Event)]
pub struct WithdrawalLeafAppended {
    pub chain_index: Felt,
    pub index: Felt,
    pub leaf: u256,
    pub new_chain_root: u256,
    pub new_global_root: u256,
}

#[contract]
#[derive(Storage)]
pub struct PsyWithdrawalTreeContract {
    pub root: u256,

    pub frontiers: [u256; 8192],
    pub chain_counts: [Felt; 256],
    pub global_count: Felt,
    pub _chain_roots_padding: [Felt; 3],
    pub chain_roots: [u256; 256],

    pub agg_tree: [u256; 512],
}

impl PsyWithdrawalTreeContractRef {
    // Wire encoding of a bytes32 value: eight u32 limb felts, most significant
    // limb first (big-endian word order). A u256 carries the same eight limb
    // slots, so transmute reinterprets between u256 and [u32; 8] losslessly:
    // hash preimages, events, and storage felts are unchanged from the
    // previous [u32; 8] representation.
    // Must match the token contract's state_map field offset (after note_root + last_path[20]).
    fn token_state_map_offset() -> Felt { 8589934680 }
    fn withdrawal_record_namespace() -> Felt { 6 }
    fn token_contract_id() -> Felt { 0 }
    fn usdt_token_contract_id() -> Felt { 4 }
    fn withdrawal_record_key(nonce: u256) -> Hash {
        let limbs = transmute::<[u32; 8]>(nonce);
        hash([
            limbs[0] as Felt, limbs[1] as Felt, limbs[2] as Felt, limbs[3] as Felt,
            limbs[4] as Felt, limbs[5] as Felt, limbs[6] as Felt, limbs[7] as Felt,
        ])
    }
    fn eq_hash(a: Hash, b: Hash) -> bool {
        a[0] == b[0] && a[1] == b[1] && a[2] == b[2] && a[3] == b[3]
    }
    fn compute_withdrawal_leaf_hash(
        sender_user_id: Felt,
        destination_chain_index: Felt,
        token_address: u256,
        amount: u256,
        recipient: u256,
        nonce: u256,
        token_contract_id: Felt,
    ) -> Hash {
        let token_address = transmute::<[u32; 8]>(token_address);
        let amount = transmute::<[u32; 8]>(amount);
        let recipient = transmute::<[u32; 8]>(recipient);
        let nonce = transmute::<[u32; 8]>(nonce);
        hash([
            sender_user_id,
            recipient[0] as Felt, recipient[1] as Felt, recipient[2] as Felt, recipient[3] as Felt,
            recipient[4] as Felt, recipient[5] as Felt, recipient[6] as Felt, recipient[7] as Felt,
            token_address[0] as Felt, token_address[1] as Felt, token_address[2] as Felt, token_address[3] as Felt,
            token_address[4] as Felt, token_address[5] as Felt, token_address[6] as Felt, token_address[7] as Felt,
            amount[0] as Felt, amount[1] as Felt, amount[2] as Felt, amount[3] as Felt,
            amount[4] as Felt, amount[5] as Felt, amount[6] as Felt, amount[7] as Felt,
            nonce[0] as Felt, nonce[1] as Felt, nonce[2] as Felt, nonce[3] as Felt,
            nonce[4] as Felt, nonce[5] as Felt, nonce[6] as Felt, nonce[7] as Felt,
            destination_chain_index,
            token_contract_id,
        ])
    }
    fn is_zero_u256(x: u256) -> bool {
        let limbs = transmute::<[u32; 8]>(x);
        limbs[0] == 0u32
            && limbs[1] == 0u32
            && limbs[2] == 0u32
            && limbs[3] == 0u32
            && limbs[4] == 0u32
            && limbs[5] == 0u32
            && limbs[6] == 0u32
            && limbs[7] == 0u32
    }
    fn felt_u64_to_u32x2(x: Felt) -> [u32; 2] {
        let bits = split_bits(x, 64);

        let mut lo: Felt = 0;
        let mut lo_pow: Felt = 1;
        for i in 0u32..32u32 {
            let idx = i as Felt;
            lo += (bits[idx] as Felt) * lo_pow;
            lo_pow *= 2;
        }

        let mut hi: Felt = 0;
        let mut hi_pow: Felt = 1;
        for i in 32u32..64u32 {
            let idx = i as Felt;
            hi += (bits[idx] as Felt) * hi_pow;
            hi_pow *= 2;
        }

        [lo as u32, hi as u32]
    }

    fn hash_to_u32x8(x: Hash) -> [u32; 8] {
        let x0 = Self::felt_u64_to_u32x2(x[0]);
        let x1 = Self::felt_u64_to_u32x2(x[1]);
        let x2 = Self::felt_u64_to_u32x2(x[2]);
        let x3 = Self::felt_u64_to_u32x2(x[3]);
        let x0_lo: u32 = x0[0];
        let x0_hi: u32 = x0[1];
        let x1_lo: u32 = x1[0];
        let x1_hi: u32 = x1[1];
        let x2_lo: u32 = x2[0];
        let x2_hi: u32 = x2[1];
        let x3_lo: u32 = x3[0];
        let x3_hi: u32 = x3[1];
        [x0_lo, x0_hi, x1_lo, x1_hi, x2_lo, x2_hi, x3_lo, x3_hi]
    }

    fn hash_to_u256(x: Hash) -> u256 {
        transmute::<u256>(Self::hash_to_u32x8(x))
    }

    fn u32_shift_factor() -> Felt {
        let mut factor: Felt = 1;
        for _i in 0u32..32u32 {
            factor *= 2;
        }
        factor
    }

    fn u32x8_to_hash(x: [u32; 8]) -> Hash {
        [
            (x[0] as Felt) + (x[1] as Felt) * Self::u32_shift_factor(),
            (x[2] as Felt) + (x[3] as Felt) * Self::u32_shift_factor(),
            (x[4] as Felt) + (x[5] as Felt) * Self::u32_shift_factor(),
            (x[6] as Felt) + (x[7] as Felt) * Self::u32_shift_factor(),
        ]
    }

    fn u256_to_hash(x: u256) -> Hash {
        Self::u32x8_to_hash(transmute::<[u32; 8]>(x))
    }

    fn keccak_two_to_one(left: u256, right: u256) -> u256 {
        let l = transmute::<[u32; 8]>(left);
        let r = transmute::<[u32; 8]>(right);
        let data: [Felt; 16] = [
            l[0] as Felt, l[1] as Felt, l[2] as Felt, l[3] as Felt,
            l[4] as Felt, l[5] as Felt, l[6] as Felt, l[7] as Felt,
            r[0] as Felt, r[1] as Felt, r[2] as Felt, r[3] as Felt,
            r[4] as Felt, r[5] as Felt, r[6] as Felt, r[7] as Felt
        ];
        transmute::<u256>(keccak256(data))
    }

    fn chain_frontier_offset(chain_index: Felt, level: Felt) -> Felt {
        chain_index * 32 + level
    }

    fn get_chain_count_value(chain_index: Felt) -> Felt {
        assert(chain_index < 256, "chain index out of range");
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        c.chain_counts[chain_index].get()
    }

    fn get_chain_root_value(chain_index: Felt) -> u256 {
        assert(chain_index < 256, "chain index out of range");
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        c.chain_roots[chain_index].get()
    }

    fn get_global_count_value() -> Felt {
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        c.global_count.get()
    }

    fn append_to_chain_hash(chain_index: Felt, leaf_hash: Hash) -> Hash {
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        let idx = Self::get_chain_count_value(chain_index);
        assert(idx < 4294967296, "withdrawal tree is full");

        let mut current = leaf_hash;
        let mut zero: Hash = [0, 0, 0, 0];
        let mut path_index = idx;

        for level in 0u32..32u32 {
            let level_index = level as Felt;
            let slot = Self::chain_frontier_offset(chain_index, level_index);
            let is_right: Felt = path_index & 1;
            if is_right == 0 {
                c.frontiers[slot] = Self::hash_to_u256(current);
                current = hash_two_to_one(current, zero);
            } else {
                let left = Self::u256_to_hash(c.frontiers[slot].get());
                current = hash_two_to_one(left, current);
            };
            zero = hash_two_to_one(zero, zero);
            path_index = path_index >> 1;
        }

        c.chain_counts[chain_index] = idx + 1;
        c.global_count = Self::get_global_count_value() + 1;
        c.chain_roots[chain_index] = Self::hash_to_u256(current);

        current
    }

    fn update_global_root_for_chain_hash(chain_index: Felt, chain_root: Hash) -> Hash {
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        let mut node = 256 + chain_index;
        c.agg_tree[node] = Self::hash_to_u256(chain_root);
        let mut zero: u256 = transmute::<u256>([0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32]);

        for i in 0u32..8u32 {
            let _level = i as Felt;
            let is_right: Felt = node & 1;
            let left = if is_right == 0 { node } else { node - 1 };
            let right = left + 1;
            let parent = node >> 1;
            let mut left_hash = c.agg_tree[left].get();
            let mut right_hash = c.agg_tree[right].get();
            // Unwritten aggregate-tree slots are storage zeroes. Interpret them
            // as the canonical empty subtree for this level so the root follows
            // the same standard Merkle semantics as the L1 verifier.
            if Self::is_zero_u256(left_hash) {
                left_hash = zero;
            };
            if Self::is_zero_u256(right_hash) {
                right_hash = zero;
            };
            let parent_hash = Self::keccak_two_to_one(left_hash, right_hash);
            c.agg_tree[parent] = parent_hash;
            zero = Self::keccak_two_to_one(zero, zero);
            node = parent;
        }

        let global_root = c.agg_tree[1].get();
        c.root = global_root;
        Self::u256_to_hash(global_root)
    }

    fn append_leaf_to_chain(chain_index: Felt, leaf: u256) -> (Felt, u256) {
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        assert(Self::is_zero_u256(leaf) == false, "withdrawal leaf is zero");

        let idx = Self::get_chain_count_value(chain_index);
        let new_chain_root_hash = Self::append_to_chain_hash(chain_index, Self::u256_to_hash(leaf));
        let new_chain_root = Self::hash_to_u256(new_chain_root_hash);
        (idx, new_chain_root)
    }

    fn append_authorized_withdrawal(
        sender_user_id: Felt,
        token_contract_id: Felt,
        destination_chain_index: Felt,
        token_address: u256,
        amount: u256,
        recipient: u256,
        nonce: u256
    ) -> (Felt, u256, u256, u256) {
        assert((destination_chain_index >> 32) == 0, "destination chain index out of uint32 range");
        assert(destination_chain_index < 256, "destination chain index out of range (0-255)");
        assert(
            token_contract_id == Self::token_contract_id()
                || token_contract_id == Self::usdt_token_contract_id(),
            "unsupported withdrawal token contract"
        );

        let leaf_hash_hash: Hash = Self::compute_withdrawal_leaf_hash(
            sender_user_id,
            destination_chain_index,
            token_address,
            amount,
            recipient,
            nonce,
            token_contract_id,
        );
        let token_state_map: MapRef<Hash, Hash, 1048576u32> = MapRef::new(
            Self::token_state_map_offset(),
            ContractMetadata::new(token_contract_id, sender_user_id)
        );
        let recorded: Hash = token_state_map.get_ns_other(
            Self::withdrawal_record_namespace(),
            Self::withdrawal_record_key(nonce)
        );
        assert(Self::eq_hash(recorded, leaf_hash_hash), "withdrawal leaf does not match sender withdrawal record");

        let leaf_hash: u256 = Self::hash_to_u256(leaf_hash_hash);
        let append_result = Self::append_leaf_to_chain(destination_chain_index, leaf_hash);
        let idx = append_result.0;
        let new_chain_root = append_result.1;
        let new_global_root_hash = Self::update_global_root_for_chain_hash(
            destination_chain_index,
            Self::u256_to_hash(new_chain_root)
        );
        let new_global_root = Self::hash_to_u256(new_global_root_hash);
        (idx, leaf_hash, new_chain_root, new_global_root)
    }

    #[contract_method]
    pub fn set_chain_root(
        chain_index: Felt,
        total_count: Felt,
        new_chain_root: u256
    ) {
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        assert(chain_index < 256, "chain index out of range");
        assert(total_count > 0, "total count must be positive");

        // total_count is an ABSOLUTE count (not a delta). This makes set_chain_root
        // idempotent: calling it twice with the same (total_count, new_chain_root)
        // is a no-op, which is critical for crash safety in the bridge relayer.
        let old_count = Self::get_chain_count_value(chain_index);
        // Monotonicity guard: total_count must not decrease (Felt subtraction wraps mod p).
        assert(total_count >= old_count, "total_count cannot decrease");
        let count_delta = total_count - old_count;

        // Set chain state to absolute values; count_delta is 0 on idempotent re-call
        c.chain_counts[chain_index] = total_count;
        c.global_count = Self::get_global_count_value() + count_delta;
        c.chain_roots[chain_index] = new_chain_root;

        // Update the 8-layer keccak agg tree
        let chain_root_hash = Self::u256_to_hash(new_chain_root);
        let new_global_root_hash = Self::update_global_root_for_chain_hash(chain_index, chain_root_hash);
        let _new_global_root = Self::hash_to_u256(new_global_root_hash);
    }

    #[contract_method]
    pub fn get_root() -> u256 {
        let c = PsyWithdrawalTreeContractRef::new(ContractMetadata::current());
        c.root.get()
    }

    #[contract_method]
    pub fn get_chain_root(destination_chain_index: Felt) -> u256 {
        Self::get_chain_root_value(destination_chain_index)
    }

    #[contract_method]
    pub fn append_leaf(leaf: u256) {
        let chain_index: Felt = 0;
        let append_result = Self::append_leaf_to_chain(chain_index, leaf);
        let idx = append_result.0;
        let new_chain_root = append_result.1;
        let new_global_root_hash = Self::update_global_root_for_chain_hash(
            chain_index,
            Self::u256_to_hash(new_chain_root),
        );
        let new_global_root = Self::hash_to_u256(new_global_root_hash);
        let event_data = WithdrawalLeafAppended {
            chain_index,
            index: idx,
            leaf,
            new_chain_root,
            new_global_root,
        };
        event_data.emit();
    }

    #[contract_method]
    pub fn append_withdrawal(
        sender_user_id: Felt,
        token_contract_id: Felt,
        destination_chain_index: Felt,
        token_address: u256,
        amount: u256,
        recipient: u256,
        nonce: u256
    ) {
        let append_result = Self::append_authorized_withdrawal(
            sender_user_id,
            token_contract_id,
            destination_chain_index,
            token_address,
            amount,
            recipient,
            nonce,
        );
        let idx = append_result.0;
        let leaf_hash = append_result.1;
        let new_chain_root = append_result.2;
        let new_global_root = append_result.3;
        let event_data = WithdrawalLeafAppended {
            chain_index: destination_chain_index,
            index: idx,
            leaf: leaf_hash,
            new_chain_root,
            new_global_root,
        };
        event_data.emit();
    }


    #[contract_method]
    pub fn batch_append_withdrawals_2(
        count: Felt,
        sender_user_ids: [Felt; 2],
        token_contract_ids: [Felt; 2],
        destination_chain_indices: [Felt; 2],
        token_addresses: [u256; 2],
        amounts: [u256; 2],
        recipients: [u256; 2],
        nonces: [u256; 2]
    ) {
        assert(count > 0, "empty withdrawal batch");
        assert(count <= 2, "withdrawal batch exceeds max size (2)");

        for i in 0u32..2u32 {
            let item_index = i as Felt;

            let token_address: u256 = token_addresses[item_index];
            let amount: u256 = amounts[item_index];
            let recipient: u256 = recipients[item_index];
            let nonce: u256 = nonces[item_index];

            if item_index < count {
                let append_result = Self::append_authorized_withdrawal(
                    sender_user_ids[item_index],
                    token_contract_ids[item_index],
                    destination_chain_indices[item_index],
                    token_address,
                    amount,
                    recipient,
                    nonce,
                );
                let event_data = WithdrawalLeafAppended {
                    chain_index: destination_chain_indices[item_index],
                    index: append_result.0,
                    leaf: append_result.1,
                    new_chain_root: append_result.2,
                    new_global_root: append_result.3,
                };
                event_data.emit();
            } else {
                assert(sender_user_ids[item_index] == 0, "non-zero dummy sender_user_id");
                assert(token_contract_ids[item_index] == 0, "non-zero dummy token_contract_id");
                assert(destination_chain_indices[item_index] == 0, "non-zero dummy destination_chain_index");
                assert(Self::is_zero_u256(token_address), "non-zero dummy token_address");
                assert(Self::is_zero_u256(amount), "non-zero dummy amount");
                assert(Self::is_zero_u256(recipient), "non-zero dummy recipient");
                assert(Self::is_zero_u256(nonce), "non-zero dummy nonce");
            };
        }
    }

    #[contract_method]
    pub fn batch_append_withdrawals_5(
        count: Felt,
        sender_user_ids: [Felt; 5],
        token_contract_ids: [Felt; 5],
        destination_chain_indices: [Felt; 5],
        token_addresses: [u256; 5],
        amounts: [u256; 5],
        recipients: [u256; 5],
        nonces: [u256; 5]
    ) {
        assert(count > 0, "empty withdrawal batch");
        assert(count <= 5, "withdrawal batch exceeds max size (5)");

        for i in 0u32..5u32 {
            let item_index = i as Felt;

            let token_address: u256 = token_addresses[item_index];
            let amount: u256 = amounts[item_index];
            let recipient: u256 = recipients[item_index];
            let nonce: u256 = nonces[item_index];

            if item_index < count {
                let append_result = Self::append_authorized_withdrawal(
                    sender_user_ids[item_index],
                    token_contract_ids[item_index],
                    destination_chain_indices[item_index],
                    token_address,
                    amount,
                    recipient,
                    nonce,
                );
                let event_data = WithdrawalLeafAppended {
                    chain_index: destination_chain_indices[item_index],
                    index: append_result.0,
                    leaf: append_result.1,
                    new_chain_root: append_result.2,
                    new_global_root: append_result.3,
                };
                event_data.emit();
            } else {
                assert(sender_user_ids[item_index] == 0, "non-zero dummy sender_user_id");
                assert(token_contract_ids[item_index] == 0, "non-zero dummy token_contract_id");
                assert(destination_chain_indices[item_index] == 0, "non-zero dummy destination_chain_index");
                assert(Self::is_zero_u256(token_address), "non-zero dummy token_address");
                assert(Self::is_zero_u256(amount), "non-zero dummy amount");
                assert(Self::is_zero_u256(recipient), "non-zero dummy recipient");
                assert(Self::is_zero_u256(nonce), "non-zero dummy nonce");
            };
        }
    }
}
