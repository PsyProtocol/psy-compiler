use std::prelude::*;

#[derive(Event)]
pub struct DepositLeafAppended {
    pub chain_index: Felt,
    pub index: Felt,
    pub leaf: [u32; 8],
    pub new_chain_root: [u32; 8],
    pub new_global_root: [u32; 8],
}

#[contract]
#[derive(Storage)]
pub struct PsyDepositTreeContract {
    pub next_index: Felt,
    pub root: [u32; 8],

    pub frontiers: [[u32; 8]; 8192],
    pub chain_counts: [Felt; 256],
    pub _chain_roots_padding: [Felt; 3],
    pub chain_roots: [[u32; 8]; 256],

    pub agg_tree: [[u32; 8]; 512],
}

impl PsyDepositTreeContractRef {
    pub fn keccak_two_to_one(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
        let data: [Felt; 16] = [
            left[0] as Felt, left[1] as Felt, left[2] as Felt, left[3] as Felt,
            left[4] as Felt, left[5] as Felt, left[6] as Felt, left[7] as Felt,
            right[0] as Felt, right[1] as Felt, right[2] as Felt, right[3] as Felt,
            right[4] as Felt, right[5] as Felt, right[6] as Felt, right[7] as Felt,
        ];
        keccak256(data)
    }

    fn chain_frontier_offset(chain_index: Felt, level: Felt) -> Felt {
        chain_index * 32 + level
    }

    fn get_zero_hashes() -> [[u32; 8]; 32] {
        [
            [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32],
            [2905745590u32, 1995953101u32, 1115989316u32, 1058533782u32, 725017745u32, 3003793586u32, 1079527909u32, 2545573813u32],
            [3032553809u32, 2507960207u32, 1680624374u32, 483832390u32, 1090438876u32, 2143684590u32, 2181474718u32, 2453736752u32],
            [568179107u32, 1451318335u32, 2886739638u32, 3737509681u32, 615496411u32, 1214028709u32, 2749577610u32, 79149701u32],
            [3850856883u32, 706472689u32, 3928438618u32, 1141463565u32, 532047054u32, 768825575u32, 4240422796u32, 648123204u32],
            [246423231u32, 3387762512u32, 215277513u32, 2032610591u32, 152292511u32, 1716784510u32, 2147844369u32, 165793581u32],
