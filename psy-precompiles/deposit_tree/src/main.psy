use std::prelude::*;

#[derive(Event)]
pub struct DepositLeafAppended {
    pub chain_index: Felt,
    pub index: Felt,
    pub leaf: [u32; 8],
    pub new_chain_root: [u32; 8],
    pub new_global_root: [u32; 8],
}

#[contract]
#[derive(Storage)]
pub struct PsyDepositTreeContract {
    pub next_index: Felt,
    pub root: [u32; 8],

    pub frontiers: [[u32; 8]; 8192],
    pub chain_counts: [Felt; 256],
    pub _chain_roots_padding: [Felt; 3],
    pub chain_roots: [[u32; 8]; 256],

    pub agg_tree: [[u32; 8]; 512],
}

impl PsyDepositTreeContractRef {
    pub fn keccak_two_to_one(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
        let data: [Felt; 16] = [
            left[0] as Felt, left[1] as Felt, left[2] as Felt, left[3] as Felt,
            left[4] as Felt, left[5] as Felt, left[6] as Felt, left[7] as Felt,
            right[0] as Felt, right[1] as Felt, right[2] as Felt, right[3] as Felt,
            right[4] as Felt, right[5] as Felt, right[6] as Felt, right[7] as Felt,
        ];
        keccak256(data)
    }

    fn chain_frontier_offset(chain_index: Felt, level: Felt) -> Felt {
        chain_index * 32 + level
    }

    fn get_zero_hashes() -> [[u32; 8]; 32] {
        [
            [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32],
            [3056087725u32, 3453220726u32, 1151697986u32, 2532382527u32, 2447652395u32, 2990541491u32, 3846789184u32, 3042949783u32],
            [1360642484u32, 2406448277u32, 4132056164u32, 1186125340u32, 3704028736u32, 3993486975u32, 2661877378u32, 806175122u32],
            [2746866977u32, 1063027030u32, 3055947948u32, 836748766u32, 3686444836u32, 2778422344u32, 2319049635u32, 2243606276u32],
            [3010037733u32, 4058651434u32, 1513564138u32, 224004420u32, 3462706719u32, 3881358125u32, 2360852476u32, 1150525734u32],
            [3206459406u32, 1344794057u32, 3386889228u32, 523052921u32, 2680951561u32, 2114802790u32, 293668224u32, 768598281u32],
            [3173153928u32, 1087590535u32, 1715252246u32, 756088757u32, 4134788524u32, 283579568u32, 578821813u32, 1746508463u32],
