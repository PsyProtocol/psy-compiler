use std::prelude::*;

#[derive(Event)]
pub struct DepositLeafAppended {
    pub chain_index: Felt,
    pub index: Felt,
    pub leaf: [u32; 8],
    pub new_chain_root: [u32; 8],
    pub new_global_root: [u32; 8],
}

#[contract]
#[derive(Storage)]
pub struct PsyDepositTreeContract {
    pub root: [u32; 8],
    pub next_index: Felt,

    pub frontiers: [[u32; 8]; 8192],
    pub chain_counts: [Felt; 256],
    pub _chain_roots_padding: [Felt; 3],
    pub chain_roots: [[u32; 8]; 256],

    pub agg_tree: [[u32; 8]; 512],
    pub known_roots: Map<Hash, Hash, 1048576u32>,
}

impl PsyDepositTreeContractRef {
    fn eq_u32x8(a: [u32; 8], b: [u32; 8]) -> bool {
        a[0] == b[0]
            && a[1] == b[1]
            && a[2] == b[2]
            && a[3] == b[3]
            && a[4] == b[4]
            && a[5] == b[5]
            && a[6] == b[6]
            && a[7] == b[7]
    }

    fn felt_u64_to_u32x2(x: Felt) -> [u32; 2] {
        let bits = __split_bits(x, 64);

        let mut lo: Felt = 0;
        let mut lo_pow: Felt = 1;
        for i in 0u32..32u32 {
            let idx = i as Felt;
            lo += (bits[idx] as Felt) * lo_pow;
            lo_pow *= 2;
        }

        let mut hi: Felt = 0;
        let mut hi_pow: Felt = 1;
        for i in 32u32..64u32 {
            let idx = i as Felt;
            hi += (bits[idx] as Felt) * hi_pow;
            hi_pow *= 2;
        }

        [lo as u32, hi as u32]
    }

    fn hash_to_u32x8(x: Hash) -> [u32; 8] {
        let x0 = Self::felt_u64_to_u32x2(x[0]);
        let x1 = Self::felt_u64_to_u32x2(x[1]);
        let x2 = Self::felt_u64_to_u32x2(x[2]);
        let x3 = Self::felt_u64_to_u32x2(x[3]);
        [
            x0[0], x0[1],
            x1[0], x1[1],
            x2[0], x2[1],
            x3[0], x3[1],
        ]
    }

    fn u32_shift_factor() -> Felt {
        let mut factor: Felt = 1;
        for _i in 0u32..32u32 {
            factor *= 2;
        }
        factor
    }

    fn u32x8_to_hash(x: [u32; 8]) -> Hash {
        [
            (x[0] as Felt) + (x[1] as Felt) * Self::u32_shift_factor(),
            (x[2] as Felt) + (x[3] as Felt) * Self::u32_shift_factor(),
            (x[4] as Felt) + (x[5] as Felt) * Self::u32_shift_factor(),
            (x[6] as Felt) + (x[7] as Felt) * Self::u32_shift_factor(),
        ]
    }

    #[contract_method]
    pub fn poseidon_two_to_one(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
        Self::hash_to_u32x8(hash_two_to_one(Self::u32x8_to_hash(left), Self::u32x8_to_hash(right)))
    }

    fn keccak_two_to_one(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
        let data: [Felt; 16] = [
            left[0] as Felt, left[1] as Felt, left[2] as Felt, left[3] as Felt,
            left[4] as Felt, left[5] as Felt, left[6] as Felt, left[7] as Felt,
            right[0] as Felt, right[1] as Felt, right[2] as Felt, right[3] as Felt,
            right[4] as Felt, right[5] as Felt, right[6] as Felt, right[7] as Felt
        ];
        keccak256(data)
    }

    fn chain_frontier_offset(chain_index: Felt, level: Felt) -> Felt {
        chain_index * 32 + level
    }

    fn known_root_key(root: [u32; 8]) -> Hash {
        hash([
            root[0] as Felt, root[1] as Felt, root[2] as Felt, root[3] as Felt,
            root[4] as Felt, root[5] as Felt, root[6] as Felt, root[7] as Felt,
        ])
    }

    fn known_root_key_hash_halves(root_lo: Hash, root_hi: Hash) -> Hash {
        hash([
            root_lo[0], root_lo[1], root_lo[2], root_lo[3],
            root_hi[0], root_hi[1], root_hi[2], root_hi[3],
        ])
    }

    fn zero_hash(level: Felt) -> [u32; 8] {
        let mut current: [u32; 8] = [0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32];
        let mut i: Felt = 0;
        while i < level {
            current = Self::poseidon_two_to_one(current, current);
            i += 1;
        }
        current
    }

    fn append_to_chain_hash(chain_index: Felt, leaf_hash: Hash) -> Hash {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        let idx = c.chain_counts[chain_index].get();
        assert(idx < 4294967296, "deposit tree is full");

        let mut current = leaf_hash;
        let mut zero: Hash = [0, 0, 0, 0];
        let mut path_index = idx;

        for level in 0u32..32u32 {
            let level_index = level as Felt;
            let slot = Self::chain_frontier_offset(chain_index, level_index);
            let is_right: Felt = path_index & 1;
            if is_right == 0 {
                c.frontiers[slot] = Self::hash_to_u32x8(current);
                current = hash_two_to_one(current, zero);
            } else {
                let left = Self::u32x8_to_hash(c.frontiers[slot].get());
                current = hash_two_to_one(left, current);
            };
            zero = hash_two_to_one(zero, zero);
            path_index = path_index >> 1;
        }

        c.chain_counts[chain_index] = idx + 1;
        c.chain_roots[chain_index] = Self::hash_to_u32x8(current);

        current
    }

    fn update_global_root_for_chain_hash(chain_index: Felt, chain_root: Hash) -> Hash {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        let mut node = 256 + chain_index;
        c.agg_tree[node] = Self::hash_to_u32x8(chain_root);

        for i in 0u32..8u32 {
            let _level = i as Felt;
            let is_right: Felt = node & 1;
            let left = if is_right == 0 { node } else { node - 1 };
            let right = left + 1;
            let parent = node >> 1;
            let left_hash = c.agg_tree[left].get();
            let right_hash = c.agg_tree[right].get();
            let parent_hash = Self::keccak_two_to_one(left_hash, right_hash);
            c.agg_tree[parent] = parent_hash;
            node = parent;
        }

        let global_root = c.agg_tree[1].get();
        c.root = global_root;
        Self::u32x8_to_hash(global_root)
    }

    #[contract_method]
    pub fn get_root() -> [u32; 8] {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        c.root.get()
    }

    #[contract_method]
    pub fn get_next_index() -> Felt {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        c.chain_counts[0].get()
    }

    #[contract_method]
    pub fn get_chain_root(chain_index: Felt) -> [u32; 8] {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        assert(chain_index < 256, "chain index out of range");
        c.chain_roots[chain_index].get()
    }

    #[contract_method]
    pub fn get_chain_next_index(chain_index: Felt) -> Felt {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        assert(chain_index < 256, "chain index out of range");
        c.chain_counts[chain_index].get()
    }

    #[contract_method]
    pub fn append_leaf(leaf: [u32; 8]) {
        let chain_index: Felt = 0;
        Self::append_deposit(chain_index, leaf)
    }

    fn is_zero_u32x8(x: [u32; 8]) -> bool {
        x[0] == 0u32
            && x[1] == 0u32
            && x[2] == 0u32
            && x[3] == 0u32
            && x[4] == 0u32
            && x[5] == 0u32
            && x[6] == 0u32
            && x[7] == 0u32
    }

    #[contract_method]
    pub fn batch_append_deposits_32(chain_index: Felt, count: Felt, leaf_data: [u32; 256]) {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        assert(chain_index < 256, "chain index out of range");
        assert(count > 0, "empty deposit batch");
        assert(count <= 32, "deposit batch exceeds max size (32)");
        let mut i: Felt = 0;
        while i < 32 {
            let offset = i * 8;
            let o0 = offset;
            let o1 = offset + 1;
            let o2 = offset + 2;
            let o3 = offset + 3;
            let o4 = offset + 4;
            let o5 = offset + 5;
            let o6 = offset + 6;
            let o7 = offset + 7;
            let leaf: [u32; 8] = [
                leaf_data[o0], leaf_data[o1], leaf_data[o2], leaf_data[o3],
                leaf_data[o4], leaf_data[o5], leaf_data[o6], leaf_data[o7],
            ];
            if i < count {
                let leaf_hash = Self::u32x8_to_hash(leaf);
                let new_chain_root_hash = Self::append_to_chain_hash(chain_index, leaf_hash);
                let new_chain_root = Self::hash_to_u32x8(new_chain_root_hash);
                let known_key = Self::known_root_key(new_chain_root);
                c.known_roots.insert_ns(chain_index, known_key, [1, 0, 0, 0]);
            } else {
                assert(Self::is_zero_u32x8(leaf), "non-zero dummy deposit leaf");
            };
            i += 1;
        }

        let final_chain_root_hash = Self::u32x8_to_hash(c.chain_roots[chain_index].get());
        let _new_global_root_hash = Self::update_global_root_for_chain_hash(chain_index, final_chain_root_hash);
        if chain_index == 0 {
            c.next_index = c.chain_counts[0].get();
        };
    }

    #[contract_method]
    pub fn append_deposit(chain_index: Felt, leaf: [u32; 8]) {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        assert(chain_index < 256, "chain index out of range");
        let idx = c.chain_counts[chain_index].get();

        let leaf_hash = Self::u32x8_to_hash(leaf);
        let new_chain_root_hash = Self::append_to_chain_hash(chain_index, leaf_hash);
        let new_chain_root = Self::hash_to_u32x8(new_chain_root_hash);
        let known_key = Self::known_root_key(new_chain_root);
        c.known_roots.insert_ns(chain_index, known_key, [1, 0, 0, 0]);
        let new_global_root_hash = Self::update_global_root_for_chain_hash(chain_index, new_chain_root_hash);
        let new_global_root = Self::hash_to_u32x8(new_global_root_hash);
        if chain_index == 0 {
            c.next_index = c.chain_counts[0].get();
        };

        // let event_data = new DepositLeafAppended {
        //     chain_index,
        //     index: idx,
        //     leaf,
        //     new_chain_root,
        //     new_global_root,
        // };
        // event_data.emit();
    }

    #[contract_method]
    pub fn is_known_root(chain_index: Felt, root: [u32; 8]) -> Felt {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        let mut result: Felt = 0;
        if chain_index < 256 && Self::eq_u32x8(c.chain_roots[chain_index].get(), root) {
            result = 1;
        };
        result
    }

    #[contract_method]
    pub fn is_known_root_hash(chain_index: Felt, root_lo: Hash, root_hi: Hash) -> Felt {
        let c = PsyDepositTreeContractRef::new(ContractMetadata::current());
        let root = [
            (root_lo[0] & 4294967295) as u32,
            (root_lo[0] >> 32) as u32,
            (root_lo[1] & 4294967295) as u32,
            (root_lo[1] >> 32) as u32,
            (root_hi[0] & 4294967295) as u32,
            (root_hi[0] >> 32) as u32,
            (root_hi[1] & 4294967295) as u32,
            (root_hi[1] >> 32) as u32,
        ];
        let mut result: Felt = 0;
        if chain_index < 256 && Self::eq_u32x8(c.chain_roots[chain_index].get(), root) {
            result = 1;
        };
        result
    }

}
