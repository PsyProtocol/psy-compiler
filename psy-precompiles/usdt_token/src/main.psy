use std::prelude::*;
use deposit_tree::PsyDepositTreeContractRef;

#[derive(Storage)]
struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[derive(Event)]
pub struct TransferEvent {
    pub to: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct ClaimEvent {
    pub from: Felt,
    pub amount: Felt,
    pub amount_claimed: Felt,
}
#[derive(Event)]
pub struct PrivateClaimEvent {
    pub shield_address: Hash,
    pub nullifier_hash: Hash,
    pub amount: Felt,
}

#[derive(Event)]
pub struct PrivateTransferEvent {
    // Do not emit receiver, value, or note_commitment: they contain private or
    // linkable transfer data.
    // pub receiver: Hash,
    // pub value: Felt,
    // pub note_commitment: Hash,
    pub index: Felt,
    pub commitment: Hash,
    pub new_root: Hash,
}

#[derive(Event)]
pub struct DepositClaimEvent {
    pub shield_address: Hash,
    pub nullifier_hash: Hash,
    pub amount: Felt,
    pub source_chain_index: Felt,
    pub note_commitment: Hash,
    pub deposit_index: Felt,
}


#[derive(Event)]
pub struct UserInfoEvent {
    pub balance: Felt,
}

#[derive(Event)]
pub struct WithdrawalEvent {
    pub sender_user_id: Felt,
    pub destination_chain_index: Felt,
    pub token_address: u256,
    pub amount: u256,
    pub recipient: u256,
    pub nonce: u256,
}

struct PrivateClaimProof {
    pub siblings: [Hash; 16],
    pub index: Felt,
}

struct ShieldClaimProof {
    pub siblings: [Hash; 16],
    pub index: Felt,
}

struct ProofPublicInputsPreimage {
    pub receiver: Hash,
    pub amount: Felt,
    pub user_tree_root: Hash,
    pub checkpoint_id: Felt,
    pub note_root_slot: Felt,
    pub token_contract_id: Felt,
    pub nullifier_hash: Hash,
}

struct ShieldClaimPublicInputsPreimage {
    pub shield_address: Hash,
    pub amount: u256,
    pub token_address: u256,
    pub l2_token_contract_id: u256,
    pub source_chain_index: Felt,
    pub deposit_root: Hash,
    pub nullifier_hash: Hash,
    pub note_commitment: Hash,
    pub deposit_index: Felt,
}

#[contract]
#[derive(Storage)]
pub struct USDTTokenContract {
    pub balance: Felt,
    // Reserved to preserve the deployed storage layout.
    pub reserved_1: Felt,
    pub reserved_2: Felt,
    pub other_user_info: [OtherUserInfo; 4294967296],

    pub note_count: Felt,

    pub note_root: Hash,
    pub last_path: [Hash; 20],

    pub state_map: Map<Hash, Hash, 1048576u32>,
}

impl USDTTokenContractRef {
    fn deposit_tree_contract_id() -> Felt { 2 }
    fn deposit_tree_user_id() -> Felt { 524288 }

    // Wire encoding of a bytes32 value: eight u32 limb felts, most significant
    // limb first (big-endian word order). A u256 carries the same eight limb
    // slots, so mem::transmute reinterprets between u256 and [u32; 8]
    // losslessly: hash preimages, events, and storage felts are unchanged
    // from the previous [u32; 8] representation.
    fn felt_u64_to_u256(x: Felt) -> u256 {
        transmute::<u256>([0u32, 0u32, 0u32, 0u32, 0u32, 0u32, (x >> 32) as u32, (x & 4294967295) as u32])
    }

    fn current_contract_id_u256() -> u256 {
        Self::felt_u64_to_u256(get_contract_id())
    }

    fn u256_to_felt(x: u256) -> Felt {
        let limbs = transmute::<[u32; 8]>(x);
        assert(
            limbs[0] == 0u32 && limbs[1] == 0u32 && limbs[2] == 0u32 && limbs[3] == 0u32 &&
            limbs[4] == 0u32 && limbs[5] == 0u32,
            "amount exceeds uint64 range"
        );
        assert(
            limbs[6] < 4294967295u32 || limbs[7] == 0u32,
            "amount exceeds Felt range"
        );
        (limbs[6] as Felt) * 4294967296 + (limbs[7] as Felt)
    }

    fn u256_to_hash(x: u256) -> Hash {
        let limbs = transmute::<[u32; 8]>(x);
        [
            (limbs[0] as Felt) + (limbs[1] as Felt) * 4294967296,
            (limbs[2] as Felt) + (limbs[3] as Felt) * 4294967296,
            (limbs[4] as Felt) + (limbs[5] as Felt) * 4294967296,
            (limbs[6] as Felt) + (limbs[7] as Felt) * 4294967296,
        ]
    }
    fn withdrawal_record_key(nonce: u256) -> Hash {
        let limbs = transmute::<[u32; 8]>(nonce);
        hash([
            limbs[0] as Felt, limbs[1] as Felt, limbs[2] as Felt, limbs[3] as Felt,
            limbs[4] as Felt, limbs[5] as Felt, limbs[6] as Felt, limbs[7] as Felt,
        ])
    }

    fn eq_hash(a: Hash, b: Hash) -> bool {
        a[0] == b[0]
            && a[1] == b[1]
            && a[2] == b[2]
            && a[3] == b[3]
    }

    #[contract_method]
    pub fn withdraw(
        destination_chain_index: Felt,
        token_address: u256,
        amount: u256,
        recipient: u256,
        nonce: u256,
    ) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let amount_felt = Self::u256_to_felt(amount);
        let current_balance = c.balance.get();
        assert(amount_felt > 0, "amount must be positive");
        assert(current_balance >= amount_felt, "insufficient balance");

        c.balance = current_balance - amount_felt;

        assert(destination_chain_index < 256, "destination chain index out of range (0-255)");

        let sender_user_id = get_user_id();
        let recipient_limbs = transmute::<[u32; 8]>(recipient);
        let token_address_limbs = transmute::<[u32; 8]>(token_address);
        let amount_limbs = transmute::<[u32; 8]>(amount);
        let nonce_limbs = transmute::<[u32; 8]>(nonce);

        let leaf_hash: Hash = hash([
            sender_user_id,
            recipient_limbs[0] as Felt, recipient_limbs[1] as Felt, recipient_limbs[2] as Felt, recipient_limbs[3] as Felt,
            recipient_limbs[4] as Felt, recipient_limbs[5] as Felt, recipient_limbs[6] as Felt, recipient_limbs[7] as Felt,
            token_address_limbs[0] as Felt, token_address_limbs[1] as Felt, token_address_limbs[2] as Felt, token_address_limbs[3] as Felt,
            token_address_limbs[4] as Felt, token_address_limbs[5] as Felt, token_address_limbs[6] as Felt, token_address_limbs[7] as Felt,
            amount_limbs[0] as Felt, amount_limbs[1] as Felt, amount_limbs[2] as Felt, amount_limbs[3] as Felt,
            amount_limbs[4] as Felt, amount_limbs[5] as Felt, amount_limbs[6] as Felt, amount_limbs[7] as Felt,
            nonce_limbs[0] as Felt, nonce_limbs[1] as Felt, nonce_limbs[2] as Felt, nonce_limbs[3] as Felt,
            nonce_limbs[4] as Felt, nonce_limbs[5] as Felt, nonce_limbs[6] as Felt, nonce_limbs[7] as Felt,
            destination_chain_index,
            get_contract_id(),
        ]);
        let record_key: Hash = Self::withdrawal_record_key(nonce);
        assert(!c.state_map.contains_ns(6, record_key), "nonce already used for withdrawal");
        c.state_map.insert_ns(6, record_key, leaf_hash);
        let event_data = WithdrawalEvent {
            sender_user_id,
            destination_chain_index,
            token_address,
            amount,
            recipient,
            nonce,
        };
        event_data.emit();
    }
    #[contract_method]
    pub fn claim_deposit(
        nullifier_hash: Hash,
        shield_address: Hash,
        token_address: u256,
        amount: u256,
        source_chain_index: Felt,
        deposit_root: u256,
        note_commitment: Hash,
        deposit_index: Felt,
        r0: Felt,
        r1: Felt,
        proof: ShieldClaimProof
    ) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let amount_felt: Felt = Self::u256_to_felt(amount);
        assert(amount_felt > 0, "amount must be positive");
        let expected_shield_address: Hash = hash([
            get_user_id(),
            1337,
            r0,
            r1,
        ]);
        assert(Self::eq_hash(shield_address, expected_shield_address), "shield address mismatch");
        let deposit_tree = PsyDepositTreeContractRef::new(ContractMetadata::new(
            Self::deposit_tree_contract_id(),
            Self::deposit_tree_user_id(),
        ));
        let deposit_root_hash = Self::u256_to_hash(deposit_root);
        let deposit_root_limbs = transmute::<[u32; 8]>(deposit_root);
        let known_key: Hash = hash([
            deposit_root_limbs[0] as Felt, deposit_root_limbs[1] as Felt, deposit_root_limbs[2] as Felt, deposit_root_limbs[3] as Felt,
            deposit_root_limbs[4] as Felt, deposit_root_limbs[5] as Felt, deposit_root_limbs[6] as Felt, deposit_root_limbs[7] as Felt,
        ]);
        let known: bool = deposit_tree.known_roots.contains_ns_other(source_chain_index, known_key);
        assert(known, "deposit root is not known");

        let preimage = ShieldClaimPublicInputsPreimage {
            shield_address,
            amount,
            token_address,
            l2_token_contract_id: Self::current_contract_id_u256(),
            source_chain_index,
            deposit_root: deposit_root_hash,
            nullifier_hash,
            note_commitment,
            deposit_index,
        };
        let amount_limbs = transmute::<[u32; 8]>(preimage.amount);
        let token_address_limbs = transmute::<[u32; 8]>(preimage.token_address);
        let l2_id_limbs = transmute::<[u32; 8]>(preimage.l2_token_contract_id);
        let public_inputs_hash: Hash = hash([
            preimage.shield_address[0], preimage.shield_address[1], preimage.shield_address[2], preimage.shield_address[3],
            amount_limbs[0] as Felt, amount_limbs[1] as Felt, amount_limbs[2] as Felt, amount_limbs[3] as Felt,
            amount_limbs[4] as Felt, amount_limbs[5] as Felt, amount_limbs[6] as Felt, amount_limbs[7] as Felt,
            token_address_limbs[0] as Felt, token_address_limbs[1] as Felt, token_address_limbs[2] as Felt, token_address_limbs[3] as Felt,
            token_address_limbs[4] as Felt, token_address_limbs[5] as Felt, token_address_limbs[6] as Felt, token_address_limbs[7] as Felt,
            l2_id_limbs[0] as Felt, l2_id_limbs[1] as Felt, l2_id_limbs[2] as Felt, l2_id_limbs[3] as Felt,
            l2_id_limbs[4] as Felt, l2_id_limbs[5] as Felt, l2_id_limbs[6] as Felt, l2_id_limbs[7] as Felt,
            preimage.source_chain_index,
            preimage.deposit_root[0], preimage.deposit_root[1], preimage.deposit_root[2], preimage.deposit_root[3],
            preimage.nullifier_hash[0], preimage.nullifier_hash[1], preimage.nullifier_hash[2], preimage.nullifier_hash[3],
            preimage.note_commitment[0], preimage.note_commitment[1], preimage.note_commitment[2], preimage.note_commitment[3],
            preimage.deposit_index
        ]);
        let shield_claim_fingerprint: Hash = [
            10300675757615779284,
            7959431029994071658,
            2858758774398267815,
            15642499089729770720
        ];
        let leaf: Hash = hash_two_to_one(shield_claim_fingerprint, public_inputs_hash);
        let mut current: Hash = leaf;
        for i in 0u32..16u32 {
            let level_index = i as Felt;
            let sibling: Hash = proof.siblings[level_index];
            let index_bit: Felt = (proof.index >> level_index) & 1;

            if index_bit == 0 {
                current = hash_two_to_one(current, sibling);
            } else {
                current = hash_two_to_one(sibling, current);
            };
        }

        let expected_root: Hash = get_session_proof_tree_root();
        assert(current == expected_root, "proof tree root mismatch");

        assert(c.state_map.contains_ns(4, nullifier_hash) == false, "shield claim already used");
        c.state_map.insert_ns(4, nullifier_hash, [1, 0, 0, 0]);
        c.balance += amount_felt;
        let event_data = DepositClaimEvent {
            shield_address,
            nullifier_hash,
            amount: amount_felt,
            source_chain_index,
            note_commitment,
            deposit_index,
        };
        event_data.emit();

    }

    #[contract_method]
    pub fn mint(amount: Felt) {
        let deployer: Felt = get_contract_deployer(get_contract_id());
        assert(deployer == get_user_id(), "only deployer can mint");

        let c = USDTTokenContractRef::new(ContractMetadata::current());
        c.balance += amount;
    }

    #[contract_method]
    pub fn burn(amount: Felt) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");
        c.balance = current_balance - amount;
    }

    #[contract_method]
    pub fn transfer(recipient: Felt, amount: Felt) {
        let transfer_info_event = TransferEvent {
            to: recipient,
            amount,
        };
        transfer_info_event.emit();

        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");

        let mut recipient_info = c.other_user_info[recipient].get();
        assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

        c.other_user_info[recipient] = OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed
        };

        let sender_start_info = UserInfoEvent {
            balance: c.balance.get(),
        };
        sender_start_info.emit();
        c.balance = current_balance - amount;
        let sender_end_info = UserInfoEvent {
            balance: c.balance.get(),
        };
        sender_end_info.emit();
    }

    #[contract_method]
    pub fn claim(sender: Felt) {
        let self_user_id = get_user_id();
        // Self-claim is allowed in this storage layout because balance and
        // per-sender claim metadata are stored in separate slots.
        // assert(sender != self_user_id, "you cannot claim from your self");

        let c = USDTTokenContractRef::new(ContractMetadata::current());

        let sender_user_contract = USDTTokenContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_total_sent = sender_user_contract.other_user_info[self_user_id].get().amount_sent;

        let mut sender_info = c.other_user_info[sender].get();
        assert(sender_info.amount_claimed < sender_total_sent, "no tokens to claim from this sender");
        let claimed = sender_total_sent - sender_info.amount_claimed;

        c.other_user_info[sender] = OtherUserInfo {
            amount_sent: sender_info.amount_sent,
            amount_claimed: sender_total_sent
        };

        c.balance += claimed;

        let claim_event = ClaimEvent {
            from: sender,
            amount: claimed,
            amount_claimed: sender_total_sent,
        };
        claim_event.emit();
    }

    #[contract_method]
    pub fn batch_transfer_2(recipients: [Felt; 2], amounts: [Felt; 2]) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();

        let mut total_amount = 0;
        for i in 0u32..2u32 {
            total_amount = total_amount + amounts[i as Felt];
            assert(total_amount >= amounts[i as Felt], "total amount overflow");
        }

        assert(current_balance >= total_amount, "insufficient balance for batch transfer");

        for i in 0u32..2u32 {
            let recipient = recipients[i as Felt];
            let amount = amounts[i as Felt];

            if amount > 0 {
                let transfer_event = TransferEvent { to: recipient, amount };
                transfer_event.emit();

                let mut recipient_info = c.other_user_info[recipient].get();
                assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

                c.other_user_info[recipient] = OtherUserInfo {
                    amount_sent: recipient_info.amount_sent + amount,
                    amount_claimed: recipient_info.amount_claimed
                };
            }
        }

        c.balance = current_balance - total_amount;
    }

    #[contract_method]
    pub fn batch_transfer_5(recipients: [Felt; 5], amounts: [Felt; 5]) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();

        let mut total_amount = 0;
        for i in 0u32..5u32 {
            total_amount = total_amount + amounts[i as Felt];
            assert(total_amount >= amounts[i as Felt], "total amount overflow");
        }

        assert(current_balance >= total_amount, "insufficient balance for batch transfer");

        for i in 0u32..5u32 {
            let recipient = recipients[i as Felt];
            let amount = amounts[i as Felt];

            if amount > 0 {
                let transfer_event = TransferEvent { to: recipient, amount };
                transfer_event.emit();

                let mut recipient_info = c.other_user_info[recipient].get();
                assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

                c.other_user_info[recipient] = OtherUserInfo {
                    amount_sent: recipient_info.amount_sent + amount,
                    amount_claimed: recipient_info.amount_claimed
                };
            }
        }

        c.balance = current_balance - total_amount;
    }

    #[contract_method]
    pub fn private_transfer(receiver: Hash, value: Felt, note_commitment: Hash) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(value > 0, "value must be positive");
        assert(current_balance >= value, "insufficient balance");
        c.balance = current_balance - value;

        let value_hash: Hash = [value, 0, 0, 0];
        let commitment: Hash = hash_two_to_one(hash_two_to_one(receiver, value_hash), note_commitment);
        let idx = c.note_count.get();
        assert(idx < 1048576, "note tree is full");

        let mut current: Hash = commitment;
        let mut zero: Hash = [0, 0, 0, 0];
        let mut path_index: Felt = idx;

        for level in 0u32..20u32 {
            let level_index = level as Felt;
            let is_right: Felt = path_index & 1;
            if is_right == 0 {
                c.last_path[level_index] = current;
                current = hash_two_to_one(current, zero);
            } else {
                let left = c.last_path[level_index].get();
                current = hash_two_to_one(left, current);
            };
            zero = hash_two_to_one(zero, zero);
            path_index = path_index >> 1;
        }

        c.note_root = current;
        c.note_count = idx + 1;

        let transfer_event = PrivateTransferEvent {
            index: idx,
            commitment,
            new_root: current,
        };
        transfer_event.emit();
    }

    #[contract_method]
    pub fn private_claim(
        nullifier_hash: Hash,
        receiver: Hash,
        amount: Felt,
        user_tree_root: Hash,
        checkpoint_id: Felt,
        note_root_slot: Felt,
        random0: Felt,
        random1: Felt,
        proof: PrivateClaimProof
    ) {
        let c = USDTTokenContractRef::new(ContractMetadata::current());

        let preimage = ProofPublicInputsPreimage {
            receiver,
            amount,
            user_tree_root,
            checkpoint_id,
            note_root_slot,
            token_contract_id: get_contract_id(),
            nullifier_hash
        };

        let public_inputs_hash: Hash = hash([
            preimage.receiver[0], preimage.receiver[1], preimage.receiver[2], preimage.receiver[3],
            preimage.amount,
            preimage.user_tree_root[0], preimage.user_tree_root[1], preimage.user_tree_root[2], preimage.user_tree_root[3],
            preimage.checkpoint_id,
            preimage.note_root_slot,
            preimage.token_contract_id,
            preimage.nullifier_hash[0], preimage.nullifier_hash[1], preimage.nullifier_hash[2], preimage.nullifier_hash[3]
        ]);
        let private_note_inclusion_fingerprint: Hash = [                          
            2482434993266711942,                                                  
            6028864160300535936,                                                 
            2827549014984201026,                                                  
            3018365102481798071                                                  
        ];    
        let leaf: Hash = hash_two_to_one(private_note_inclusion_fingerprint, public_inputs_hash);

        let mut current: Hash = leaf;
        for i in 0u32..16u32 {
            let level_index = i as Felt;
            let sibling: Hash = proof.siblings[level_index];
            let index_bit: Felt = (proof.index >> level_index) & 1;

            if index_bit == 0 {
                current = hash_two_to_one(current, sibling);
            } else {
                current = hash_two_to_one(sibling, current);
            };
        }

        let expected_root: Hash = get_session_proof_tree_root();
        assert(current == expected_root, "proof tree root mismatch");

        let expected_user_tree_root: Hash = get_checkpoint_user_tree_root(preimage.checkpoint_id);
        assert(preimage.user_tree_root == expected_user_tree_root, "user tree root does not match checkpoint state");

        assert(preimage.note_root_slot == 2147483649, "invalid note root slot id");

        let expected_receiver: Hash = hash([get_user_id(), 1337, random0, random1]);
        assert(preimage.receiver == expected_receiver, "receiver does not match claiming user");
        let nullifier_key: Hash = preimage.nullifier_hash;
        assert(c.state_map.contains_ns(1, nullifier_key) == false, "nullifier already claimed");
        c.state_map.insert_ns(1, nullifier_key, [1, 0, 0, 0]);

        c.balance += preimage.amount;
        let claim_event = PrivateClaimEvent {
            shield_address: receiver,
            nullifier_hash,
            amount: preimage.amount,
        };
        claim_event.emit();
    }
}
