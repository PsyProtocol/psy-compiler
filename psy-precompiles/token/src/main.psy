use std::prelude::*;
use mining_rewards::PsyPOWMiningRewardsClaimContractRef;

#[derive(Storage)]
struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[derive(Event)]
pub struct TransferEvent {
    pub to: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct UserInfoEvent {
    pub balance: Felt,
}

#[derive(Event)]
pub struct WithdrawalEvent {
    pub destination_chain_id: Felt,
    pub token_address: [u32; 8],
    pub amount: Felt,
    pub recipient: [u32; 8],
    pub nonce: Felt,
}

struct PrivateClaimProof {
    pub siblings: [Hash; 16],
    pub index: Felt,
}

struct DepositClaimProof {
    pub siblings: [[u32; 8]; 32],
    pub index: Felt,
    pub checkpoint_id: Felt,
}

struct ProofPublicInputsPreimage {
    pub receiver: Hash,
    pub amount: Felt,
    pub user_tree_root: Hash,
    pub checkpoint_id: Felt,
    pub note_root_slot: Felt,
    pub nullifier_hash: Hash,
}

#[contract]
#[derive(Storage)]
pub struct PsyTokenContract {
    pub balance: Felt,
    pub last_claimed_pow_rewards_checkpoint_id: Felt,
    pub claimed_rewards: Felt,
    pub other_user_info: [OtherUserInfo; 16777216],

    pub note_count: Felt,

    pub note_root: Hash,
    pub last_path: [Hash; 20],

    pub state_map: Map<Hash, Hash, 1048576u32>,
}

impl PsyTokenContractRef {
    fn eq_u32x8(a: [u32; 8], b: [u32; 8]) -> bool {
        a[0] == b[0]
            && a[1] == b[1]
            && a[2] == b[2]
            && a[3] == b[3]
            && a[4] == b[4]
            && a[5] == b[5]
            && a[6] == b[6]
            && a[7] == b[7]
    }

    fn keccak_two_to_one(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
        let data: [Felt; 16] = [
            left[0] as Felt, left[1] as Felt, left[2] as Felt, left[3] as Felt,
            left[4] as Felt, left[5] as Felt, left[6] as Felt, left[7] as Felt,
            right[0] as Felt, right[1] as Felt, right[2] as Felt, right[3] as Felt,
            right[4] as Felt, right[5] as Felt, right[6] as Felt, right[7] as Felt
        ];
        keccak256(data)
    }

    fn hash_to_u32x8(x: Hash) -> [u32; 8] {
        let mask: Felt = 4294967295;
        [
            (x[0] & mask) as u32,
            (x[0] >> 32) as u32,
            (x[1] & mask) as u32,
            (x[1] >> 32) as u32,
            (x[2] & mask) as u32,
            (x[2] >> 32) as u32,
            (x[3] & mask) as u32,
            (x[3] >> 32) as u32,
        ]
    }

    fn user_id_to_u32x8_be(user_id: Felt) -> [u32; 8] {
        // bytes32 big-endian: high 192 bits are zero, low 64 bits are user_id.
        // Represented as eight u32 limbs in big-endian word order.
        [
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            (user_id >> 32) as u32,
            (user_id & 4294967295) as u32,
        ]
    }

    fn current_contract_id_u32x8() -> [u32; 8] {
        [
            get_contract_id() as u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
            0u32,
        ]
    }

    pub fn withdraw(
        destination_chain_index: Felt,
        token_address: [u32; 8],
        amount: Felt,
        recipient: [u32; 8],
        nonce: Felt,
    ) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(amount > 0, "amount must be positive");
        assert(current_balance >= amount, "insufficient balance");

        c.balance = current_balance - amount;

        let leaf_hash: [u32; 8] = keccak256([
            recipient[0] as Felt, recipient[1] as Felt, recipient[2] as Felt, recipient[3] as Felt,
            recipient[4] as Felt, recipient[5] as Felt, recipient[6] as Felt, recipient[7] as Felt,
            token_address[0] as Felt, token_address[1] as Felt, token_address[2] as Felt, token_address[3] as Felt,
            token_address[4] as Felt, token_address[5] as Felt, token_address[6] as Felt, token_address[7] as Felt,
            amount,
            nonce,
            destination_chain_index,
        ]);
        let event_data = new WithdrawalEvent {
            destination_chain_id: destination_chain_index,
            token_address,
            amount,
            recipient,
            nonce,
        };
        event_data.emit();
    }

    pub fn claim_deposit(
        source_chain_index: Felt,
        depositor: [u32; 8],
        l2_token_contract_id: [u32; 8],
        token_address: [u32; 8],
        amount: Felt,
        recipient: [u32; 8],
        nonce: Felt,
        proof: DepositClaimProof
    ) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(amount > 0, "amount must be positive");
        assert(proof.index < 4294967296, "deposit proof index out of range");
        let expected_l2_token_contract_id = Self::current_contract_id_u32x8();
        assert(
            Self::eq_u32x8(l2_token_contract_id, expected_l2_token_contract_id),
            "l2 token contract id mismatch"
        );
        let caller_user_id: Felt = get_user_id();
        let caller_recipient: [u32; 8] = Self::user_id_to_u32x8_be(caller_user_id);
        assert(Self::eq_u32x8(recipient, caller_recipient), "recipient must be tx sender user_id (bytes32 BE)");
        // Must match L1 Bridge leaf layout exactly:
        // keccak256(abi.encodePacked(depositor, l2Recipient, token, l2TokenContractId, amount, chainIndex, nonce))
        let leaf_hash: [u32; 8] = keccak256([
            depositor[0] as Felt, depositor[1] as Felt, depositor[2] as Felt, depositor[3] as Felt,
            depositor[4] as Felt, depositor[5] as Felt, depositor[6] as Felt, depositor[7] as Felt,
            recipient[0] as Felt, recipient[1] as Felt, recipient[2] as Felt, recipient[3] as Felt,
            recipient[4] as Felt, recipient[5] as Felt, recipient[6] as Felt, recipient[7] as Felt,
            token_address[0] as Felt, token_address[1] as Felt, token_address[2] as Felt, token_address[3] as Felt,
            token_address[4] as Felt, token_address[5] as Felt, token_address[6] as Felt, token_address[7] as Felt,
            l2_token_contract_id[0] as Felt, l2_token_contract_id[1] as Felt, l2_token_contract_id[2] as Felt, l2_token_contract_id[3] as Felt,
            l2_token_contract_id[4] as Felt, l2_token_contract_id[5] as Felt, l2_token_contract_id[6] as Felt, l2_token_contract_id[7] as Felt,
            amount,
            source_chain_index,
            nonce,
        ]);
        assert(source_chain_index < 256, "source chain index out of range");
        let source_chain_index_u32: u32 = source_chain_index as u32;
        // Deposit tree chain_roots base hash slot index (for contract 2): 16451.
        // With explicit padding in the deposit tree layout, each [u32; 8] root is 4-aligned
        // and occupies exactly two Hash slots.
        let root_slot_base: Felt = 16451 + (source_chain_index_u32 as Felt) * 2;

        let root_hash_0: Hash = get_other_user_contract_state_hash_at(32, 524288, 2, root_slot_base);
        let root_hash_1: Hash = get_other_user_contract_state_hash_at(32, 524288, 2, root_slot_base + 1);

        let expected_root: [u32; 8] = [
            root_hash_0[0] as u32,
            root_hash_0[1] as u32,
            root_hash_0[2] as u32,
            root_hash_0[3] as u32,
            root_hash_1[0] as u32,
            root_hash_1[1] as u32,
            root_hash_1[2] as u32,
            root_hash_1[3] as u32,
        ];
        let mut current = leaf_hash;
        for i in 0u32..32u32 {
            let level_index = i as Felt;
            let sibling: [u32; 8] = proof.siblings[level_index];
            let index_bit: Felt = (proof.index >> level_index) & 1;
            if index_bit == 0 {
                current = Self::keccak_two_to_one(current, sibling);
            } else {
                current = Self::keccak_two_to_one(sibling, current);
            };
        }
        assert(Self::eq_u32x8(current, expected_root), "deposit proof root mismatch");

        let claim_key: Hash = hash([
            leaf_hash[0] as Felt,
            leaf_hash[1] as Felt,
            leaf_hash[2] as Felt,
            leaf_hash[3] as Felt,
            leaf_hash[4] as Felt,
            leaf_hash[5] as Felt,
            leaf_hash[6] as Felt,
            leaf_hash[7] as Felt,
        ]);
        assert(c.state_map.contains_ns(3, claim_key) == false, "deposit already claimed");
        c.state_map.insert_ns(3, claim_key, [1, 0, 0, 0]);

        c.balance += amount;
    }

    pub fn simple_mint(amount: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        c.balance += amount;
    }

    pub fn simple_burn(amount: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");
        c.balance = current_balance - amount;
    }

    pub fn simple_transfer(recipient: Felt, amount: Felt) {
        let transfer_info_event = new TransferEvent {
            to: recipient,
            amount,
        };
        transfer_info_event.emit();

        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");

        let mut recipient_info = c.other_user_info[recipient].get();
        assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

        c.other_user_info[recipient] = new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed
        };

        let sender_start_info = new UserInfoEvent {
            balance: c.balance.get(),
        };
        sender_start_info.emit();
        c.balance = current_balance - amount;
        let sender_end_info = new UserInfoEvent {
            balance: c.balance.get(),
        };
        sender_end_info.emit();
    }

    pub fn simple_claim(sender: Felt) {
        let self_user_id = get_user_id();
        assert(sender != self_user_id, "you cannot claim from your self");

        let c = PsyTokenContractRef::new(ContractMetadata::current());

        let sender_user_contract = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_total_sent = sender_user_contract.other_user_info[self_user_id].get().amount_sent;

        let mut sender_info = c.other_user_info[sender].get();
        assert(sender_info.amount_claimed < sender_total_sent, "no tokens to claim from this sender");
        let claimed = sender_total_sent - sender_info.amount_claimed;

        c.other_user_info[sender] = new OtherUserInfo {
            amount_sent: sender_info.amount_sent,
            amount_claimed: sender_total_sent
        };

        c.balance += claimed;
    }

    pub fn simple_claim_pow_rewards(checkpoint_id: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let psy_pow_mining_rewards_claim_contract = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::new(1, get_user_id()));
        let pow_rewards_persistent_state = psy_pow_mining_rewards_claim_contract.persistent_state.get();

        assert(
            pow_rewards_persistent_state.last_claimed_checkpoint_id == checkpoint_id,
        "the claims must be from the latest ups");
        assert(
            pow_rewards_persistent_state.last_sealed_checkpoint_id == checkpoint_id,
        "the checkpoint must be sealed");
        assert(
            c.last_claimed_pow_rewards_checkpoint_id.get() < checkpoint_id,
        "must haven't already claimed during this ups");

        c.last_claimed_pow_rewards_checkpoint_id = checkpoint_id;
        c.balance += pow_rewards_persistent_state.claimed_rewards;
    }

    pub fn batch_simple_transfer_2(recipients: [Felt; 2], amounts: [Felt; 2]) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();

        let mut total_amount = 0;
        for i in 0u32..2u32 {
            total_amount = total_amount + amounts[i as Felt];
            assert(total_amount >= amounts[i as Felt], "total amount overflow");
        }

        assert(current_balance >= total_amount, "insufficient balance for batch transfer");

        for i in 0u32..2u32 {
            let recipient = recipients[i as Felt];
            let amount = amounts[i as Felt];

            if amount > 0 {
                let mut recipient_info = c.other_user_info[recipient].get();
                assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

                c.other_user_info[recipient] = new OtherUserInfo {
                    amount_sent: recipient_info.amount_sent + amount,
                    amount_claimed: recipient_info.amount_claimed
                };
            }
        }

        c.balance = current_balance - total_amount;
    }

    pub fn batch_simple_transfer_5(recipients: [Felt; 5], amounts: [Felt; 5]) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();

        let mut total_amount = 0;
        for i in 0u32..5u32 {
            total_amount = total_amount + amounts[i as Felt];
            assert(total_amount >= amounts[i as Felt], "total amount overflow");
        }

        assert(current_balance >= total_amount, "insufficient balance for batch transfer");

        for i in 0u32..5u32 {
            let recipient = recipients[i as Felt];
            let amount = amounts[i as Felt];

            if amount > 0 {
                let mut recipient_info = c.other_user_info[recipient].get();
                assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

                c.other_user_info[recipient] = new OtherUserInfo {
                    amount_sent: recipient_info.amount_sent + amount,
                    amount_claimed: recipient_info.amount_claimed
                };
            }
        }

        c.balance = current_balance - total_amount;
    }

    pub fn private_transfer(receiver: Hash, value: Felt, note_secret_hash: Hash) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(value > 0, "value must be positive");
        assert(current_balance >= value, "insufficient balance");
        c.balance = current_balance - value;

        let value_hash: Hash = [value, 0, 0, 0];
        let commitment: Hash = hash_two_to_one(hash_two_to_one(receiver, value_hash), note_secret_hash);
        let idx = c.note_count.get();
        assert(idx < 1048576, "note tree is full");

        let mut current: Hash = commitment;
        let mut zero: Hash = [0, 0, 0, 0];
        let mut path_index: Felt = idx;

        for level in 0u32..20u32 {
            let level_index = level as Felt;
            let is_right: Felt = path_index & 1;
            if is_right == 0 {
                c.last_path[level_index] = current;
                current = hash_two_to_one(current, zero);
            } else {
                let left = c.last_path[level_index].get();
                current = hash_two_to_one(left, current);
            };
            zero = hash_two_to_one(zero, zero);
            path_index = path_index >> 1;
        }

        c.note_root = current;
        c.note_count = idx + 1;
    }

    pub fn private_claim(
        nullifier_hash: Hash,
        receiver: Hash,
        amount: Felt,
        user_tree_root: Hash,
        checkpoint_id: Felt,
        note_root_slot: Felt,
        random0: Felt,
        random1: Felt,
        proof: PrivateClaimProof
    ) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());

        let preimage = new ProofPublicInputsPreimage {
            receiver,
            amount,
            user_tree_root,
            checkpoint_id,
            note_root_slot,
            nullifier_hash
        };

        let public_inputs_hash: Hash = hash([
            preimage.receiver[0], preimage.receiver[1], preimage.receiver[2], preimage.receiver[3],
            preimage.amount,
            preimage.user_tree_root[0], preimage.user_tree_root[1], preimage.user_tree_root[2], preimage.user_tree_root[3],
            preimage.checkpoint_id,
            preimage.note_root_slot,
            preimage.nullifier_hash[0], preimage.nullifier_hash[1], preimage.nullifier_hash[2], preimage.nullifier_hash[3]
        ]);
        let private_note_inclusion_fingerprint: Hash = [
            1866130053021784426,
            4684972721646198880,
            8939938924988830351,
            15880983663605084668
        ];
        let leaf: Hash = hash_two_to_one(private_note_inclusion_fingerprint, public_inputs_hash);

        let mut current: Hash = leaf;
        for i in 0u32..16u32 {
            let level_index = i as Felt;
            let sibling: Hash = proof.siblings[level_index];
            let index_bit: Felt = (proof.index >> level_index) & 1;

            if index_bit == 0 {
                current = hash_two_to_one(current, sibling);
            } else {
                current = hash_two_to_one(sibling, current);
            };
        }

        let expected_root: Hash = get_session_proof_tree_root();
        assert(current == expected_root, "proof tree root mismatch");

        let expected_user_tree_root: Hash = get_checkpoint_user_tree_root(preimage.checkpoint_id);
        assert(preimage.user_tree_root == expected_user_tree_root, "user tree root does not match checkpoint state");

        assert(preimage.note_root_slot == 8388609, "invalid note root slot id");

        let expected_receiver: Hash = hash([get_user_id(), 1337, random0, random1]);
        assert(preimage.receiver == expected_receiver, "receiver does not match claiming user");
        let nullifier_key: Hash = preimage.nullifier_hash;
        assert(c.state_map.contains_ns(1, nullifier_key) == false, "nullifier already claimed");
        c.state_map.insert_ns(1, nullifier_key, [1, 0, 0, 0]);

        c.balance += preimage.amount;
    }
}
