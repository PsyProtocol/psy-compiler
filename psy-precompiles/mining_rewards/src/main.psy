use std::prelude::*;

struct SimpleMerkleProofSiblingLevel {
    pub sibling: [Felt; 4],
    pub parent_tag: [Felt; 4],
}

struct MiningRewardMerkleProof {
    pub root: [Felt; 4],
    pub leaf_left: [Felt; 4],
    pub leaf_right: [Felt; 4],
    pub leaf_tag: [Felt; 4],
    pub index: Felt,
    pub proof_height: Felt,
    pub reward_tree_tag_preimage: [Felt; 4],
    pub siblings: [SimpleMerkleProofSiblingLevel; 21],
}

#[derive(Event)]
pub struct RewardClaimedEvent {
    pub checkpoint_id: Felt,
    pub job_id: Hash,
    pub user_id: Felt,
    pub reward: Felt,
}

#[contract]
#[derive(Storage)]
pub struct PsyPOWMiningRewardsClaimContract {
    pub total_rewards: Felt,
    pub claimed_jobs: Map<Hash, Hash, 1073741824u32>,
}

impl MiningRewardMerkleProof {
    pub fn compute_root_and_nullifier_index(self) -> ([Felt; 4], Felt) {
        let proof_height = self.proof_height;
        let max_height = 21;
        assert(proof_height <= max_height, "proof height too large");

        let mut nullifier_base = 0;
        let mut nullifier_level_start_index_multiplier = 1;

        let index = self.index;
        let max_index = 1 << proof_height;

        assert(index < max_index, "index exceeds proof height");

        // Step 1: Compute leaf hash from three components
        // hash(hash(leaf_left, leaf_right), leaf_tag)
        let left_right_hash = hash_two_to_one(self.leaf_left, self.leaf_right);
        let leaf_hash = hash_two_to_one(left_right_hash, self.leaf_tag);

        // Step 2: Traverse up MAX_HEIGHT levels
        let mut current_node_value = leaf_hash;

        for i in 0u32..(21 as u32) {
            let level_index = i as Felt;
            let sibling_level = self.siblings[level_index];
            let sibling = sibling_level.sibling;
            let parent_tag = sibling_level.parent_tag;
            let index_bit = (index >> level_index) & 1;
            if level_index < proof_height {
                // Combine current node with sibling
                let branch_path_hash = if index_bit == 0 {
                    hash_two_to_one(current_node_value, sibling)
                } else {
                    hash_two_to_one(sibling, current_node_value)
                };

                // Combine with parent_tag
                current_node_value = hash_two_to_one(branch_path_hash, parent_tag);
                nullifier_base = nullifier_base + nullifier_level_start_index_multiplier;
                nullifier_level_start_index_multiplier = nullifier_level_start_index_multiplier * 2;
            } else {
                let zero_hash = [0, 0, 0, 0];
                assert(sibling == zero_hash, "unused sibling must be zero");
                assert(parent_tag == zero_hash, "unused parent_tag must be zero");

                assert(index_bit == 0, "unused index bit must be zero");
            }
        }

        // Step 3: Verify root matches
        assert(current_node_value == self.root, "root mismatch");
        let nullifier_final_index = nullifier_base + index;
        (current_node_value, nullifier_final_index)
    }
}

impl PsyPOWMiningRewardsClaimContractRef {
    fn check_guta_reward(total_proofs_in_checkpoint: Felt, total_fees_paid: Felt, proposed_reward: Felt) -> bool {
        let user_transaction_inclusion_fee = 5000000000;

        let total_reward_if_all_claim = proposed_reward * total_proofs_in_checkpoint;
        proposed_reward < user_transaction_inclusion_fee && total_reward_if_all_claim <= total_fees_paid
    }

    fn verify_guta_reward_proof(
        checkpoint_id: Felt,
        proof: MiningRewardMerkleProof,
        proposed_reward: Felt
    ) -> Felt {
        let expected_guta_rewards_tree_root = get_gutas_root(checkpoint_id);
        let total_proofs = get_gutas_completed(checkpoint_id);
        let total_fees = get_guta_fees_collected(checkpoint_id);
        assert(Self::check_guta_reward(total_proofs, total_fees, proposed_reward), "invalid reward amount");

        let result: ([Felt; 4], Felt) = proof.compute_root_and_nullifier_index();
        let computed_root = result.0;
        let nullifier_index = result.1;

        assert(computed_root == expected_guta_rewards_tree_root, "guta tree root mismatch");

        assert_eq(
            proof.reward_tree_tag_preimage[0],
            get_user_id(),
        "reward_tree_tag_preimage not for current user");

        let expected_reward_tree_tag_hash = hash_two_to_one(proof.reward_tree_tag_preimage, proof.reward_tree_tag_preimage);

        assert(proof.leaf_tag == expected_reward_tree_tag_hash, "reward_tree_tag_preimage hash not for current proof leaf tag");

        nullifier_index
    }

    // Returns the newly claimed reward amount. A duplicate claim fails with a
    // stable error code after proof verification, without performing a strict
    // IMT get that would reject the first insertion when the key is absent.
    fn claim_single_reward(
        checkpoint_id: Felt,
        proof: MiningRewardMerkleProof,
        proposed_reward: Felt
    ) -> Felt {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());

        let nullifier_index = Self::verify_guta_reward_proof(checkpoint_id, proof, proposed_reward);

        let job_id: Hash = hash([checkpoint_id, nullifier_index]);

        let already_claimed = c.claimed_jobs.contains(job_id);
        assert(already_claimed == false, "MR001: reward already claimed");
        c.claimed_jobs.insert(job_id, [proposed_reward, 0, 0, 0]);

        let event = RewardClaimedEvent {
            checkpoint_id,
            job_id,
            user_id: get_user_id(),
            reward: proposed_reward,
        };
        event.emit();

        proposed_reward
    }

    fn settle_total_rewards(newly_claimed: Felt) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
        let previous_total_rewards = c.total_rewards.get();
        let new_total_rewards = previous_total_rewards + newly_claimed;
        assert(new_total_rewards >= previous_total_rewards, "pow rewards total overflow");
        c.total_rewards = new_total_rewards;
    }

    #[contract_method]
    pub fn claim_guta_rewards_1(
        checkpoint_id: Felt,
        proof: MiningRewardMerkleProof,
        proposed_reward: Felt
    ) {
        let newly_claimed = Self::claim_single_reward(checkpoint_id, proof, proposed_reward);
        Self::settle_total_rewards(newly_claimed);
    }

    #[contract_method]
    pub fn claim_guta_rewards_2(
        checkpoint_ids: [Felt; 2],
        proofs: [MiningRewardMerkleProof; 2],
        proposed_rewards: [Felt; 2]
    ) {
        let mut total_newly_claimed = 0;
        for i in 0u32..2u32 {
            let idx = i as Felt;
            total_newly_claimed = total_newly_claimed + Self::claim_single_reward(checkpoint_ids[idx], proofs[idx], proposed_rewards[idx]);
        }
        Self::settle_total_rewards(total_newly_claimed);
    }

    #[contract_method]
    pub fn claim_guta_rewards_5(
        checkpoint_ids: [Felt; 5],
        proofs: [MiningRewardMerkleProof; 5],
        proposed_rewards: [Felt; 5]
    ) {
        let mut total_newly_claimed = 0;
        for i in 0u32..5u32 {
            let idx = i as Felt;
            total_newly_claimed = total_newly_claimed + Self::claim_single_reward(checkpoint_ids[idx], proofs[idx], proposed_rewards[idx]);
        }
        Self::settle_total_rewards(total_newly_claimed);
    }

    #[contract_method]
    pub fn claim_guta_rewards_10(
        checkpoint_ids: [Felt; 10],
        proofs: [MiningRewardMerkleProof; 10],
        proposed_rewards: [Felt; 10]
    ) {
        let mut total_newly_claimed = 0;
        for i in 0u32..10u32 {
            let idx = i as Felt;
            total_newly_claimed = total_newly_claimed + Self::claim_single_reward(checkpoint_ids[idx], proofs[idx], proposed_rewards[idx]);
        }
        Self::settle_total_rewards(total_newly_claimed);
    }

}
