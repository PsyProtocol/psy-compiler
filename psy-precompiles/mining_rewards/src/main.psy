struct SimpleMerkleProofSiblingLevel {
    pub sibling: [Felt; 4],
    pub parent_tag: [Felt; 4],
}

struct MiningRewardMerkleProof {
    pub root: [Felt; 4],
    pub leaf_left: [Felt; 4],
    pub leaf_right: [Felt; 4],
    pub leaf_tag: [Felt; 4],
    pub index: Felt,
    pub proof_height: Felt,
    pub reward_tree_tag_preimage: [Felt; 4],
    pub siblings: [SimpleMerkleProofSiblingLevel; 21],
}

#[derive(Storage)]
struct PersistentState {
    pub claimed_rewards: Felt,
    pub last_claimed_checkpoint_id: Felt,
    pub last_sealed_checkpoint_id: Felt,
}

#[contract]
#[derive(Storage)]
pub struct PsyPOWMiningRewardsClaimContract {
    pub persistent_state: PersistentState,
    pub claimed_guta_nullifiers: [Felt; 16777216],
    pub claimed_contract_deployment_nullifiers: [Felt; 1048576],
    pub claimed_user_registration_nullifiers: [Felt; 1048576]
}

impl MiningRewardMerkleProof {
    pub fn compute_root_and_nullifier_index(self) -> ([Felt; 4], Felt) {
        let proof_height = self.proof_height;
        let max_height = 21;
        assert(proof_height <= max_height, "proof height too large");

        let mut nullifier_base = 0;
        let mut nullifier_level_start_index_multiplier = 1;

        let index = self.index;
        let max_index = 1 << proof_height;

        assert(index < max_index, "index exceeds proof height");

        // Step 1: Compute leaf hash from three components
        // hash(hash(leaf_left, leaf_right), leaf_tag)
        let left_right_hash = hash_two_to_one(self.leaf_left, self.leaf_right);
        let leaf_hash = hash_two_to_one(left_right_hash, self.leaf_tag);

        // Step 2: Traverse up MAX_HEIGHT levels
        let mut current_node_value = leaf_hash;

        for i in 0u32..(21 as u32) {
            let level_index = i as Felt;
            let sibling_level = self.siblings[level_index];
            let sibling = sibling_level.sibling;
            let parent_tag = sibling_level.parent_tag;
            let index_bit = (index >> level_index) & 1;
            if level_index < proof_height {
                // Combine current node with sibling
                let branch_path_hash = if index_bit == 0 {
                    hash_two_to_one(current_node_value, sibling)
                } else {
                    hash_two_to_one(sibling, current_node_value)
                };

                // Combine with parent_tag
                current_node_value = hash_two_to_one(branch_path_hash, parent_tag);
                nullifier_base = nullifier_base + nullifier_level_start_index_multiplier;
                nullifier_level_start_index_multiplier = nullifier_level_start_index_multiplier * 2;
            } else {
                let zero_hash = [0, 0, 0, 0];
                assert(sibling == zero_hash, "unused sibling must be zero");
                assert(parent_tag == zero_hash, "unused parent_tag must be zero");

                assert(index_bit == 0, "unused index bit must be zero");
            }
        }

        // Step 3: Verify root matches
        assert(current_node_value == self.root, "root mismatch");
        let nullifier_final_index = nullifier_base + index;
        (current_node_value, nullifier_final_index)
    }
}

impl PsyPOWMiningRewardsClaimContractRef {
    fn check_guta_reward(total_proofs_in_checkpoint: Felt, total_fees_paid: Felt, proposed_reward: Felt) -> bool {
        let user_transaction_inclusion_fee = 5000000000;

        let total_reward_if_all_claim = proposed_reward * total_proofs_in_checkpoint;
        proposed_reward < user_transaction_inclusion_fee && total_reward_if_all_claim <= total_fees_paid
    }

    fn claim_single_guta_reward(
        checkpoint_id: Felt,
        proof: MiningRewardMerkleProof,
        proposed_reward: Felt
    ) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
        let user_id_hash = hash([get_user_id()]);

        let expected_guta_rewards_tree_root = get_gutas_root(checkpoint_id);
        let total_proofs = get_gutas_completed(checkpoint_id);
        let total_fees = get_guta_fees_collected(checkpoint_id);
        assert(check_guta_reward(total_proofs, total_fees, proposed_reward), "invalid reward amount");

        let result: ([Felt; 4], Felt) = proof.compute_root_and_nullifier_index();
        let computed_root = result.0;
        let nullifier_index = result.1;

        assert(computed_root == expected_guta_rewards_tree_root, "guta tree root mismatch");

        assert_eq(
            proof.reward_tree_tag_preimage[0],
            get_user_id(),
        "reward_tree_tag_preimage not for current user");

        let expected_reward_tree_tag_hash = hash_two_to_one(proof.reward_tree_tag_preimage, proof.reward_tree_tag_preimage);

        assert(proof.leaf_tag == expected_reward_tree_tag_hash, "reward_tree_tag_preimage hash not for current proof leaf tag");

        assert(c.claimed_guta_nullifiers[nullifier_index] == 0, "reward already claimed");

        c.claimed_guta_nullifiers[nullifier_index] = 1;
    }

    #[contract_method]
    pub fn start_session(
        claim_checkpoint_id: Felt
    ) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());

        let persistent_state = c.persistent_state.get();
        assert(persistent_state.last_claimed_checkpoint_id == persistent_state.last_sealed_checkpoint_id, "previous session must be sealed first");

        assert(claim_checkpoint_id > persistent_state.last_sealed_checkpoint_id, "checkpoint is sealed");

        c.persistent_state = PersistentState {
            last_claimed_checkpoint_id: claim_checkpoint_id,
            claimed_rewards: persistent_state.claimed_rewards,
            last_sealed_checkpoint_id: persistent_state.last_sealed_checkpoint_id,
        };
    }

    #[contract_method]
    pub fn end_session(claim_checkpoint_id: Felt) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
        let persistent_state = c.persistent_state.get();

        assert(
            claim_checkpoint_id == persistent_state.last_claimed_checkpoint_id
            && persistent_state.last_claimed_checkpoint_id > persistent_state.last_sealed_checkpoint_id,
        "no active session to end");

        clear_entire_tree();

        c.persistent_state = PersistentState {
            last_claimed_checkpoint_id: persistent_state.last_claimed_checkpoint_id,
            claimed_rewards: persistent_state.claimed_rewards,
            last_sealed_checkpoint_id: claim_checkpoint_id,
        };
    }

    #[contract_method]
    pub fn claim_guta_rewards_1(
        checkpoint_id: Felt,
        proof: MiningRewardMerkleProof,
        proposed_reward: Felt
    ) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
        let persistent_state = c.persistent_state.get();

        if checkpoint_id != persistent_state.last_claimed_checkpoint_id {
            if persistent_state.last_claimed_checkpoint_id != persistent_state.last_sealed_checkpoint_id {
                Self::end_session(persistent_state.last_claimed_checkpoint_id);
            };
            Self::start_session(checkpoint_id);
        };

        assert(checkpoint_id > persistent_state.last_sealed_checkpoint_id, "checkpoint is sealed");

        Self::claim_single_guta_reward(checkpoint_id, proof, proposed_reward);

        let new_persistent_state = c.persistent_state.get();
        c.persistent_state = PersistentState {
            last_claimed_checkpoint_id: checkpoint_id,
            claimed_rewards: new_persistent_state.claimed_rewards + proposed_reward,
            last_sealed_checkpoint_id: new_persistent_state.last_sealed_checkpoint_id,
        };
    }

    #[contract_method]
    pub fn claim_guta_rewards_2(
        checkpoints: [Felt; 2],
        proofs: [MiningRewardMerkleProof; 2],
        proposed_rewards: [Felt; 2]
    ) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
        let initial_persistent_state = c.persistent_state.get();

        let mut total_rewards_claimed = 0;
        let mut last_checkpoint = initial_persistent_state.last_claimed_checkpoint_id;

        for i in 0u32..2u32 {
            let idx = i as Felt;
            let checkpoint_id = checkpoints[idx];
            let proof = proofs[idx];
            let proposed_reward = proposed_rewards[idx];

            if checkpoint_id != last_checkpoint {
                if last_checkpoint != initial_persistent_state.last_sealed_checkpoint_id {
                    Self::end_session(last_checkpoint);
                };
                Self::start_session(checkpoint_id);
                last_checkpoint = checkpoint_id;
            };

            assert(checkpoint_id > initial_persistent_state.last_sealed_checkpoint_id, "checkpoint is sealed");

            Self::claim_single_guta_reward(checkpoint_id, proof, proposed_reward);
            total_rewards_claimed = total_rewards_claimed + proposed_reward;
        }

        let final_persistent_state = c.persistent_state.get();
        c.persistent_state = PersistentState {
            last_claimed_checkpoint_id: last_checkpoint,
            claimed_rewards: final_persistent_state.claimed_rewards + total_rewards_claimed,
            last_sealed_checkpoint_id: final_persistent_state.last_sealed_checkpoint_id,
        };
    }

    #[contract_method]
    pub fn claim_guta_rewards_5(
        checkpoints: [Felt; 5],
        proofs: [MiningRewardMerkleProof; 5],
        proposed_rewards: [Felt; 5]
    ) {
        let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
        let initial_persistent_state = c.persistent_state.get();

        let mut total_rewards_claimed = 0;
        let mut last_checkpoint = initial_persistent_state.last_claimed_checkpoint_id;

        for i in 0u32..5u32 {
            let idx = i as Felt;
            let checkpoint_id = checkpoints[idx];
            let proof = proofs[idx];
            let proposed_reward = proposed_rewards[idx];

            if checkpoint_id != last_checkpoint {
                if last_checkpoint != initial_persistent_state.last_sealed_checkpoint_id {
                    Self::end_session(last_checkpoint);
                };
                Self::start_session(checkpoint_id);
                last_checkpoint = checkpoint_id;
            };

            assert(checkpoint_id > initial_persistent_state.last_sealed_checkpoint_id, "checkpoint is sealed");

            Self::claim_single_guta_reward(checkpoint_id, proof, proposed_reward);
            total_rewards_claimed = total_rewards_claimed + proposed_reward;
        }

        let final_persistent_state = c.persistent_state.get();
        c.persistent_state = PersistentState {
            last_claimed_checkpoint_id: last_checkpoint,
            claimed_rewards: final_persistent_state.claimed_rewards + total_rewards_claimed,
            last_sealed_checkpoint_id: final_persistent_state.last_sealed_checkpoint_id,
        };
    }

}
